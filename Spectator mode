local function refreshPlayerList()
    for _, item in pairs(playerItems) do
        item:Destroy()
    end
    playerItems = {}
    selectedPlayer = nil

    local count = 0
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            createPlayerItem(p)
            count = count + 1
        end
    end

    playerCountLabel.Text = count .. " players"
    spectateBtn.BackgroundColor3 = Color3.fromRGB(71, 85, 105)
    spectateBtn.Text = "👁️ Select a player"
end

