    end
end)

local function startSpectate()
    if not selectedPlayer then return end
    if not selectedPlayer.Character then return end

    local character = selectedPlayer.Character
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end

    state.isSpectating = true
    state.targetPlayer = selectedPlayer
    state.originalCameraType = camera.CameraType
    state.yaw = 0
    state.pitch = 15

    camera.CameraType = Enum.CameraType.Scriptable

    spectateBtn.Text = "👁️ Spectating..."
    spectateBtn.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
    exitBtn.Visible = true
    navFrame.Visible = true
    spectatingLabel.Text = "📡 Spectating: " .. selectedPlayer.Name
    spectatingLabel.Visible = true

    state.connection = RunService.RenderStepped:Connect(function()
        if not state.isSpectating then return end
        if not state.targetPlayer or not state.targetPlayer.Character then
            exitSpectate()
            return
        end

        local char = state.targetPlayer.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hrp then return end

        if state.viewMode == "first" then
            local targetPart = head or hrp
            local yawRad = math.rad(state.yaw)
            local pitchRad = math.rad(state.pitch)
            local lookDir = CFrame.Angles(0, yawRad, 0) * CFrame.Angles(pitchRad, 0, 0)
            camera.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 0.5, 0)) * lookDir
        else
            local yawRad = math.rad(state.yaw)
            local pitchRad = math.rad(math.clamp(state.pitch, -60, 75))
            local offset = CFrame.Angles(0, yawRad, 0) * CFrame.Angles(pitchRad, 0, 0) * CFrame.new(0, 0, state.zoomDistance)
            local targetPos = hrp.Position + Vector3.new(0, 2, 0)
            local camPos = targetPos + offset.Position
            camera.CFrame = CFrame.new(camPos, targetPos)
        end
    end)

    print("[Spectator] Now watching: " .. selectedPlayer.Name)
    print("[Spectator] Hold RIGHT MOUSE BUTTON + move to rotate camera")
end

function exitSpectate()
    state.isSpectating = false
    state.targetPlayer = nil
    state.isDragging = false

    if state.connection then
        state.connection:Disconnect()
        state.connection = nil
    end

    camera.CameraType = state.originalCameraType or Enum.CameraType.Custom
    camera.CameraSubject = player.Character and player.Character:FindFirstChild("Humanoid")

    spectateBtn.Text = selectedPlayer and ("👁️ Spectate " .. selectedPlayer.Name) or "👁️ Select a player"
    spectateBtn.BackgroundColor3 = selectedPlayer and Color3.fromRGB(59, 130, 246) or Color3.fromRGB(71, 85, 105)
    exitBtn.Visible = false
    navFrame.Visible = false
    spectatingLabel.Visible = false

    print("[Spectator] Exited spectate mode")
end

local function getPlayerIndex(targetPlayer)
    local players = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(players, p)
        end
    end
    for i, p in ipairs(players) do
        if p == targetPlayer then return i, players end
    end
    return 1, players
end

local function spectateNext()
    if not state.isSpectating then return end
    local idx, players = getPlayerIndex(state.targetPlayer)
    idx = idx % #players + 1

    if selectedPlayer and playerItems[selectedPlayer] then
        playerItems[selectedPlayer].BackgroundColor3 = Color3.fromRGB(30, 41, 59)
        playerItems[selectedPlayer].BackgroundTransparency = 0.5
        playerItems[selectedPlayer].Indicator.Visible = false
    end

    selectedPlayer = players[idx]
    state.targetPlayer = selectedPlayer

    if playerItems[selectedPlayer] then
        playerItems[selectedPlayer].BackgroundColor3 = Color3.fromRGB(59, 130, 246)
        playerItems[selectedPlayer].BackgroundTransparency = 0.7
        playerItems[selectedPlayer].Indicator.Visible = true
    end

    spectatingLabel.Text = "📡 Spectating: " .. selectedPlayer.Name
    print("[Spectator] Switched to: " .. selectedPlayer.Name)
end

local function spectatePrev()
    if not state.isSpectating then return end
    local idx, players = getPlayerIndex(state.targetPlayer)
    idx = idx - 1
    if idx < 1 then idx = #players end

    if selectedPlayer and playerItems[selectedPlayer] then
        playerItems[selectedPlayer].BackgroundColor3 = Color3.fromRGB(30, 41, 59)
        playerItems[selectedPlayer].BackgroundTransparency = 0.5
        playerItems[selectedPlayer].Indicator.Visible = false
    end

    selectedPlayer = players[idx]
    state.targetPlayer = selectedPlayer

    if playerItems[selectedPlayer] then
        playerItems[selectedPlayer].BackgroundColor3 = Color3.fromRGB(59, 130, 246)
        playerItems[selectedPlayer].BackgroundTransparency = 0.7
        playerItems[selectedPlayer].Indicator.Visible = true
    end

    spectatingLabel.Text = "📡 Spectating: " .. selectedPlayer.Name
    print("[Spectator] Switched to: " .. selectedPlayer.Name)
end

