UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        if state.isSpectating then
            state.isDragging = true
            state.lastMousePos = input.Position
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        state.isDragging = false
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        if state.isSpectating then
            updateZoom(-input.Position.Z * 3)
        end
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if state.isSpectating and state.isDragging then
            local delta = input.Delta
            state.yaw = state.yaw - delta.X * state.sensitivity
            state.pitch = math.clamp(state.pitch - delta.Y * state.sensitivity, -60, 75)
        end
    end
end)

