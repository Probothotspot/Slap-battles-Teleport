-- === ПОЛНОЕ ЗАКРЫТИЕ И ОСТАНОВКА СКРИПТА ===
local function fullShutdown()
    if not guiActive then return end -- защита от двойного вызова
    guiActive = false

    -- Отключаем слушатель клавиш
    if inputConnection then
        inputConnection:Disconnect()
        inputConnection = nil
    end

    -- Останавливаем анимационный поток
    if gradientLoopThread then
        task.cancel(gradientLoopThread)
        gradientLoopThread = nil
    end

    -- Удаляем GUI
    if gui and gui.Parent then
        gui:Destroy()
    end
end

-- Крестик
closeBtn.MouseButton1Click:Connect(fullShutdown)

-- Клавиша P
inputConnection = UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.P then
        fullShutdown()
    end
end)

