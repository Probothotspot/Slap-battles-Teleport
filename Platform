-- ============ ФУНКЦИИ ПЛАТФОРМЫ ============
local function getTargetY()
    return cfg.Y + (cfg.Thickness / 2) + 3
end

local function createPlatform()
    if platform then platform:Destroy() end
    platform = Instance.new("Part")
    platform.Name = "PBH_Platform"
    platform.Size = Vector3.new(cfg.SizeXZ, cfg.Thickness, cfg.SizeXZ)
    platform.Position = Vector3.new(0, cfg.Y, 0)
    platform.Anchored = true
    platform.CanCollide = cfg.CanCollide
    platform.Transparency = cfg.Transparency
    platform.BrickColor = BrickColor.new("Really black")
    platform.Material = Enum.Material[cfg.Material]
    platform.Parent = Workspace
end

local function teleportToPlatform()
    if not platform or not platform.Parent then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = CFrame.new(0, getTargetY(), 0) * (root.CFrame - root.Position)
    end
end

local function deletePlatform()
    if platform then platform:Destroy(); platform = nil end
end

