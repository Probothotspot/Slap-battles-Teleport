        mainGrad.Color = ColorSequence.new(c1, c2)
        mainStroke.Color = Color3.fromHSV(((h+30)%360)/360, 0.7, 0.85)
        title.TextColor3 = Color3.fromHSV(((h+20)%360)/360, 0.5, 0.9)
        dot.BackgroundColor3 = Color3.fromHSV(((h+50)%360)/360, 0.8, 1)
        hLine.BackgroundColor3 = Color3.fromHSV(((h+40)%360)/360, 0.6, 0.7)
        tLine.BackgroundColor3 = Color3.fromHSV(((h+40)%360)/360, 0.5, 0.5)
