local function addLog(msg, color)
    if not logsEnabled or not guiActive then return end
    local entry = Instance.new("TextLabel")
    entry.Size = UDim2.new(1, 0, 0, 13)
    entry.BackgroundTransparency = 1
    entry.Text = os.date("%H:%M:%S") .. " " .. msg
    entry.TextColor3 = color or Color3.fromRGB(200, 200, 200)
    entry.Font = Enum.Font.Code
    entry.TextSize = 8
    entry.TextXAlignment = Enum.TextXAlignment.Left
    entry.TextTruncate = Enum.TextTruncate.AtEnd
    entry.Parent = consoleScroll
    table.insert(logEntries, entry)
    if #logEntries > 30 then
        logEntries[1]:Destroy()
        table.remove(logEntries, 1)
    end
    spawn(function()
        consoleScroll.CanvasPosition = Vector2.new(0, consoleScroll.AbsoluteCanvasSize.Y)
    end)
end

