    leftB.Font = Enum.Font.GothamBold
    leftB.TextSize = 12
    leftB.Parent = row
    corner(leftB, 4)

    local rightB = Instance.new("TextButton")
    rightB.Size = UDim2.new(0, 22, 0, 20)
    rightB.Position = UDim2.new(1, -26, 0.5, -10)
    rightB.BackgroundColor3 = Color3.fromRGB(60, 30, 90)
    rightB.BorderSizePixel = 0
    rightB.Text = ">"
    rightB.TextColor3 = Color3.new(1,1,1)
    rightB.Font = Enum.Font.GothamBold
    rightB.TextSize = 12
    rightB.Parent = row
    corner(rightB, 4)

    local function onMaterialChange()
        cfg.Material = materials[idx]
        valLbl.Text = cfg.Material
        applySettingsIfPlatformExists()
        addLog("Материал = " .. cfg.Material, Color3.fromRGB(180,180,255))
    end

    leftB.MouseButton1Click:Connect(function()
        idx = idx - 1; if idx < 1 then idx = #materials end
        onMaterialChange()
    end)
    rightB.MouseButton1Click:Connect(function()
        idx = idx + 1; if idx > #materials then idx = 1 end
        onMaterialChange()
    end)

    return { row = row, update = function() valLbl.Text = cfg.Material end }
end

local function rebuildSettings()
    for _, child in ipairs(settingsScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then
            child:Destroy()
        end
    end
    makeSettingRow("Прозрачн.", function() return cfg.Transparency end,
        function() cfg.Transparency = math.max(0, cfg.Transparency - 0.1) end,
        function() cfg.Transparency = math.min(1, cfg.Transparency + 0.1) end, 1)
    makeSettingRow("Толщина", function() return cfg.Thickness end,
        function() cfg.Thickness = math.max(10, cfg.Thickness - 10) end,
        function() cfg.Thickness = math.min(500, cfg.Thickness + 10) end, 2)
    makeSettingRow("Размер XZ", function() return cfg.SizeXZ end,
        function() cfg.SizeXZ = math.max(1000, cfg.SizeXZ - 1000) end,
        function() cfg.SizeXZ = math.min(100000, cfg.SizeXZ + 1000) end, 3)
    makeSettingRow("Позиция Y", function() return cfg.Y end,
        function() cfg.Y = math.max(-50000, cfg.Y - 100) end,
        function() cfg.Y = math.min(50000, cfg.Y + 100) end, 4)
    makeMaterialRow(5)
    makeToggleRow("CanCollide", function() return cfg.CanCollide end,
        function() cfg.CanCollide = not cfg.CanCollide end, 6)

