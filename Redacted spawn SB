-- Логика сворачивания/разворачивания
local collapsed = false
local expandedHeight = 155
local collapsedHeight = 30   -- только заголовок и две кнопки сверху

collapseBtn.MouseButton1Click:Connect(function()
    collapsed = not collapsed
    if collapsed then
        -- Сворачиваем: скрываем основное содержимое, уменьшаем высоту
        btn1.Visible = false
        btn2.Visible = false
        creditLabel.Visible = false
        frame.Size = UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset, 0, collapsedHeight)
        collapseBtn.Text = "+"
    else
        -- Разворачиваем: показываем содержимое, восстанавливаем высоту
        btn1.Visible = true
        btn2.Visible = true
        creditLabel.Visible = true
        frame.Size = UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset, 0, expandedHeight)
        collapseBtn.Text = "–"
    end
end)

-- Перетаскивание (работает и в свёрнутом состоянии)
local dragging = false
local dragStart = nil
local startPos = nil

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

frame.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

uis.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- Логика телепорта
local auto = false
local autoThread = nil

local function fireTeleport()
    local success, err = pcall(function()
        ReplicatedStorage.Well:FireServer(unpack({}))
    end)
    if not success then
        warn("Ошибка телепортации: " .. tostring(err))
    end
end

btn1.MouseButton1Click:Connect(function()
    if btn1.Active == false then return end
    btn1.Active = false
    btn1.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    fireTeleport()
    task.wait(8)
    btn1.Active = true
    btn1.BackgroundColor3 = Color3.fromRGB(100, 0, 180)
end)

btn2.MouseButton1Click:Connect(function()
    auto = not auto
    if auto then
        btn2.Text = "Авто: Вкл"
        btn2.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        autoThread = task.spawn(function()
            while auto do
                fireTeleport()
                task.wait(8)
            end
        end)
    else
        btn2.Text = "Авто: Выкл"
        btn2.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        autoThread = nil
    end
end)

-- Управление видимостью по клавишам
uis.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.K then
        if gui then
            gui.Visible = not gui.Visible
        end
    elseif input.KeyCode == Enum.KeyCode.P then
        if auto then
            auto = false
        end
        if gui then
            gui:Destroy()
            gui = nil
        end
    end
end)

-- Сообщение о загрузке
pcall(function()
