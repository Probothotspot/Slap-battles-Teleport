                    refreshRecentTab()
                end
                task.wait(1)
            end
        end)

        UserInput_.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.P then sg:Destroy() StopAll() end
        end)
    end

    AddLog(texts.logPrefix)
end

