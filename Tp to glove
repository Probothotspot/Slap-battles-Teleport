local function animateAppear(frame, duration)
    if not TweenService then return end
    pcall(function()
        local originalSize = frame.Size
        local originalTransp = frame.BackgroundTransparency
        frame.BackgroundTransparency = 1
        frame.Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset * 0.85,
                                originalSize.Y.Scale, originalSize.Y.Offset * 0.85)
        TweenService:Create(frame, TweenInfo.new(duration or 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = originalTransp,
            Size = originalSize
        }):Play()
    end)
end

local function animateDisappear(frame, callback)
    if not TweenService then
        if callback then callback() end
        return
    end
    pcall(function()
        local tween = TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 0, 0)
        })
        if callback then
            tween.Completed:Connect(callback)
        end
        tween:Play()
    end)
end

