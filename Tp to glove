            local myRoot = LP_.Character and LP_.Character:FindFirstChild("HumanoidRootPart")
            local targetRoot = info.targetPlayer.Character and info.targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot and targetRoot then
                local dist = (myRoot.Position - targetRoot.Position).Magnitude
                if dist <= Settings.GloveSearchRadius then
                    statusText = texts.statusActive
                    color = Color3.fromRGB(0,255,0)
                else
