    -- ==================== УТИЛИТЫ ====================
    local function isGroundBelow(pos)
        local rayOrigin = pos + Vector3.new(0, 2, 0)
        local rayDir = Vector3.new(0, -20, 0)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = {LP_.Character}
        return Workspace_:Raycast(rayOrigin, rayDir, params) ~= nil
    end

    local function findSafePositionNear(targetPos)
        if isGroundBelow(targetPos) then return targetPos end
        for _, offset in ipairs({Vector3.new(2,0,0), Vector3.new(-2,0,0), Vector3.new(0,0,2),
                                Vector3.new(0,0,-2), Vector3.new(4,0,0), Vector3.new(-4,0,0),
                                Vector3.new(0,0,4), Vector3.new(0,0,-4)}) do
            local test = targetPos + offset
            if isGroundBelow(test) then return test end
        end
        return targetPos
    end

    -- ==================== БАЗА СТРАТЕГИЙ (bomb убран из Center) ====================
    local GloveStrategies = {
        ["mace"] = "Custom",
        ["poltergeist"] = "Behind",
        ["target"] = "Behind",
        ["duplication"] = "Behind",
        ["tableflip"] = "Behind",
        ["god's hand"] = "Center",
        ["counter"] = "Center",
        -- ["bomb"] = "Center",   -- удалено, теперь bomb будет Handle по умолчанию
        ["defense"] = "Center",
        ["bind"] = "Handle",
    }

    local function detectStrategy(tool)
        local name = tool.Name:lower()
        if name:find("extended") then
            return "ExtendedStrategy"
        end
        for keyword, strat in pairs(GloveStrategies) do
            if name:find(keyword) then
                return strat
            end
        end
        for _, part in ipairs(tool:GetDescendants()) do
            if part:IsA("BasePart") and (part.Name:lower():find("ball") or part.Name:lower():find("chain")) then
                return "Custom"
            end
        end
        return "Handle"
    end

    -- ==================== ПОИСК ПЕРЧАТКИ ====================
    local function GetTargetGlove()
        local myChar = LP_.Character
        if not myChar then return nil end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end

        local targetPlayer = nil
        if Settings.TargetPlayerName ~= "" then
            targetPlayer = Players_:FindFirstChild(Settings.TargetPlayerName)
        end

        if not targetPlayer or not targetPlayer.Character then
            local nearestDist = Settings.GloveSearchRadius
            for _, plr in ipairs(Players_:GetPlayers()) do
                if plr ~= LP_ and plr.Character then
                    local hum = plr.Character:FindFirstChild("Humanoid")
                    local root = plr.Character:FindFirstChild("HumanoidRootPart")
                    if hum and root and hum.Health > 0 then
                        local dist = (myRoot.Position - root.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            targetPlayer = plr
                        end
                    end
                end
            end
        end

        if not targetPlayer then return nil end

        local function findToolInContainer(container)
            if not container then return nil end
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("Tool") or child:IsA("Model") then
                    return child
                end
            end
            return nil
        end

        local char = targetPlayer.Character
        local tool = findToolInContainer(char)
        if not tool then
            local backpack = targetPlayer:FindFirstChild("Backpack")
            tool = findToolInContainer(backpack)
        end

        if not tool then
            return {
                targetPlayer = targetPlayer,
                hasTool = false,
                strategy = "Idle",
                handlePart = nil,
                distToTarget = nil,
                tool = nil
            }
        end

        local strategy = detectStrategy(tool)
        local handlePart = nil
        local distToTarget = nil
        local customPart = nil

        if strategy == "Handle" or strategy == "Center" then
            handlePart = tool:FindFirstChild("Handle")
            if not handlePart or not handlePart:IsA("BasePart") then
                for _, part in ipairs(tool:GetDescendants()) do
                    if part:IsA("BasePart") and (part.Name == "Handle" or part.Name:lower():find("glove")) then
                        handlePart = part
                        break
                    end
                end
            end
            if handlePart then
                local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                distToTarget = targetRoot and (handlePart.Position - targetRoot.Position).Magnitude or 100
            end
        elseif strategy == "Custom" then
            for _, part in ipairs(tool:GetDescendants()) do
                if part:IsA("BasePart") and (part.Name:lower():find("ball") or part.Name:lower():find("chain") or part.Name:lower():find("mace")) then
                    customPart = part
                    break
                end
            end
            if not customPart then
                local farthest = nil
                local maxDist = 0
                local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                local ref = targetRoot and targetRoot.Position or targetPlayer.Character:GetPivot().Position
                for _, part in ipairs(tool:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local d = (part.Position - ref).Magnitude
                        if d > maxDist then
                            maxDist = d
                            farthest = part
                        end
                    end
                end
                customPart = farthest
            end
            if customPart then
                distToTarget = (customPart.Position - targetPlayer.Character:FindFirstChild("HumanoidRootPart").Position).Magnitude
            end
        end

        return {
            targetPlayer = targetPlayer,
            hasTool = true,
            strategy = strategy,
            handlePart = handlePart,
            customPart = customPart,
            distToTarget = distToTarget,
            tool = tool
        }
    end

    -- ==================== ТЕЛЕПОРТАЦИЯ (с поворотом лицом) ====================
    local function addRecentTarget(playerName)
        for i, name in ipairs(recentTargets) do
            if name == playerName then
                table.remove(recentTargets, i)
                break
            end
        end
        table.insert(recentTargets, playerName)
        if #recentTargets > 10 then
            table.remove(recentTargets, 1)
        end
    end

    local function processTeleport()
        if stopScript or not Settings.Enabled then return end
        local char = LP_.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local y = root.Position.Y

        if y >= 320 and y <= 330 then
            root.CFrame = LOBBY_PORTAL
            AddLog("Телепорт к порталу")
            return
        end

        if y >= -50 and y <= 80 then
            local info = GetTargetGlove()
            if not info or not info.targetPlayer then return end

            local targetPlayer = info.targetPlayer
            local strategy = info.strategy

            if strategy == "Idle" then
                if tick() - (lastTeleportTime or 0) > 5 then
                    AddLog("Ожидание: цель ничего не держит.")
                end
                return
            end

            if not LP_.Character or not LP_.Character:FindFirstChild("HumanoidRootPart") then
                AddLog("⚠️ Персонаж не готов к телепорту.")
                return
            end

            -- ============= ОБРАБОТКА EXTENDED =============
            if strategy == "ExtendedStrategy" then
                if info.tool and targetPlayer.Character then
                    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        local farthestPart = nil
                        local maxDist = 0
                        pcall(function()
                            for _, part in ipairs(info.tool:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    local dist = (part.Position - targetRoot.Position).Magnitude
                                    if dist > maxDist then
                                        maxDist = dist
                                        farthestPart = part
                                    end
                                end
                            end
                        end)
                        if farthestPart then
                            local targetPos = farthestPart.Position + Vector3.new(0, 0.5, 0)
                            local dist3D = (root.Position - targetPos).Magnitude

                            local needTP = (lastTeleportTime == 0)
                            if not needTP and Settings.ReTeleportEnabled then
                                if dist3D > Settings.ReTeleportDistance + 0.5 then
                                    needTP = true
                                end
                            end

                            if needTP and (tick() - lastFailedTeleport < 0.5) then
                                AddLog("⚠️ Телепорт не удался, пауза 0.5 сек")
                                return
                            end

                            if needTP and (tick() - lastTeleportTime >= Settings.ReTeleportCooldown) then
                                local success, err = pcall(function()
                                    local targetRootNow = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if targetRootNow then
                                        root.CFrame = CFrame.lookAt(targetPos, targetRootNow.Position)
                                    else
                                        root.CFrame = CFrame.new(targetPos)
                                    end
                                end)
                                if success then
                                    lastTeleportTime = tick()
                                    AddLog("Телепорт в ладонь Extended " .. targetPlayer.Name .. " (дист: " .. string.format("%.1f", dist3D) .. ") [повёрнут к цели]")
                                    addRecentTarget(targetPlayer.Name)
                                else
                                    AddLog("❌ Ошибка телепорта: " .. tostring(err))
                                    lastFailedTeleport = tick()
                                end
                            end
                        else
                            AddLog("Не удалось найти ладонь Extended у цели")
                        end
                    end
                end
                return
            end

            -- ============= ОСТАЛЬНЫЕ СТРАТЕГИИ =============
            local targetPos = nil
            local reason = ""

            if strategy == "Handle" then
                if info.handlePart and info.distToTarget and info.distToTarget <= Settings.CloseGloveThreshold then
                    local head = targetPlayer.Character:FindFirstChild("Head")
                    if head and head:IsA("BasePart") then
                        targetPos = head.Position + head.CFrame.LookVector * Settings.FallbackDistance
                        targetPos = Vector3.new(targetPos.X, head.Position.Y + 1.5, targetPos.Z)
                        reason = "перед " .. targetPlayer.Name .. " (близкая перчатка)"
                    end
                elseif info.handlePart then
                    local success, pos = pcall(function()
                        local dirToGlove = (info.handlePart.Position - root.Position).Unit
                        if dirToGlove.Magnitude == 0 then dirToGlove = info.handlePart.CFrame.LookVector end
                        local p = info.handlePart.Position - dirToGlove * Settings.TeleportDistance
                        return Vector3.new(p.X, info.handlePart.Position.Y + 1.5, p.Z)
                    end)
                    if success then
                        targetPos = pos
                        reason = "в перчатку " .. targetPlayer.Name .. " (Extended)"
                    else
                        AddLog("Ошибка расчёта позиции Handle")
                        lastFailedTeleport = tick()
                        return
                    end
                else
                    local head = targetPlayer.Character:FindFirstChild("Head")
                    if head and head:IsA("BasePart") then
                        targetPos = head.Position + head.CFrame.LookVector * Settings.FallbackDistance
                        targetPos = Vector3.new(targetPos.X, head.Position.Y + 1.5, targetPos.Z)
                        reason = "перед " .. targetPlayer.Name .. " (нет Handle)"
                    end
                end
            elseif strategy == "Behind" then
                local rootPart = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    targetPos = rootPart.Position - rootPart.CFrame.LookVector * Settings.FallbackDistance
                    targetPos = Vector3.new(targetPos.X, rootPart.Position.Y + 1.5, targetPos.Z)
                    reason = "за спину " .. targetPlayer.Name
                end
            elseif strategy == "Center" then
                local rootPart = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    targetPos = rootPart.Position + Vector3.new(0, 1.5, 0)
                    reason = "в центр " .. targetPlayer.Name
                end
            elseif strategy == "Custom" then
                if info.customPart then
                    local success, pos = pcall(function()
                        local dirToPart = (info.customPart.Position - root.Position).Unit
                        if dirToPart.Magnitude == 0 then dirToPart = info.customPart.CFrame.LookVector end
                        local p = info.customPart.Position - dirToPart * Settings.TeleportDistance
                        return Vector3.new(p.X, info.customPart.Position.Y + 1.5, p.Z)
                    end)
                    if success then
                        targetPos = pos
                        reason = "в специальную часть " .. targetPlayer.Name .. " (" .. info.tool.Name .. ")"
                    end
                else
                    AddLog("Не удалось найти особую часть для Custom-перчатки " .. info.tool.Name)
                    lastFailedTeleport = tick()
                    return
                end
            end

            if not targetPos then return end

            targetPos = findSafePositionNear(targetPos)
            local dist3D = (root.Position - targetPos).Magnitude
            local verticalDiff = math.abs(root.Position.Y - targetPos.Y)

            local needTP = (lastTeleportTime == 0)
            if not needTP and Settings.ReTeleportEnabled then
                if dist3D > Settings.ReTeleportDistance + 0.5 or verticalDiff > Settings.VerticalTolerance + 0.5 then
                    needTP = true
                end
            end

            if needTP and (tick() - lastFailedTeleport < 0.5) then
                AddLog("⚠️ Телепорт не удался, пауза 0.5 сек")
                return
            end

            if needTP and (tick() - lastTeleportTime >= Settings.ReTeleportCooldown) then
                local success, err = pcall(function()
                    local targetRootNow = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if targetRootNow then
                        root.CFrame = CFrame.lookAt(targetPos, targetRootNow.Position)
                    else
                        root.CFrame = CFrame.new(targetPos)
                    end
                end)
                if success then
                    lastTeleportTime = tick()
                    AddLog("Телепорт: " .. reason .. " (дист: " .. string.format("%.1f", dist3D) .. ") [повёрнут к цели]")
                    addRecentTarget(targetPlayer.Name)
                else
                    AddLog("❌ Ошибка телепорта: " .. tostring(err))
                    lastFailedTeleport = tick()
                end
            end
        end
    end

