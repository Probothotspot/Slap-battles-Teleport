local function analyzeAbilityMoment()
    if not Settings.SmartAbilitiesEnabled then return end
    if tick() - State.LastAbilityAnalyze < 1 then return end
    State.LastAbilityAnalyze = tick()
    local char = LocalPlayer.Character; if not char then return end
    local tool = char:FindFirstChild("Ability") or char:FindFirstChildOfClass("Tool")
    if not tool then return end
    local abilityName = tool.Name
    if not State.AbilityMemory[abilityName] then
        State.AbilityMemory[abilityName] = {
            usedAfterDodge = 0, usedAfterSlap = 0, usedWhileEnemyAttacking = 0,
            usedFromDistance = 0, totalUses = 0, bestMoment = "afterSlap",
        }
    end
    local mem = State.AbilityMemory[abilityName]
    local moment = "afterSlap"
    if tick() - State.LastDodgeTime < 0.5 then moment = "afterDodge"
    elseif State.LastTargetPlayer and State.LastTargetPlayer.Character then
        local enemyChar = State.LastTargetPlayer.Character
        local tool = enemyChar:FindFirstChildOfClass("Tool")
        if tool and tool.Enabled then moment = "whileEnemyAttacking" end
    end
    if moment == "afterDodge" then mem.usedAfterDodge = (mem.usedAfterDodge or 0) + 1
    elseif moment == "afterSlap" then mem.usedAfterSlap = (mem.usedAfterSlap or 0) + 1
    elseif moment == "whileEnemyAttacking" then mem.usedWhileEnemyAttacking = (mem.usedWhileEnemyAttacking or 0) + 1
    elseif moment == "fromDistance" then mem.usedFromDistance = (mem.usedFromDistance or 0) + 1 end
    mem.totalUses = mem.totalUses + 1
    local bestCount = 0
    for m, count in pairs({afterDodge = mem.usedAfterDodge or 0, afterSlap = mem.usedAfterSlap or 0, whileEnemyAttacking = mem.usedWhileEnemyAttacking or 0, fromDistance = mem.usedFromDistance or 0}) do
        if count > bestCount then bestCount = count; mem.bestMoment = m end
    end
end
