-- ===================== ВЫБОР ЦЕЛИ (с дуэлями) =====================
local function getTargetCharacter()
    local myChar = LocalPlayer.Character; if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart"); if not myRoot then return nil end

    if Settings.DuelTrainingMode and Settings.DuelOpponent ~= "" then
        local opponent = Players:FindFirstChild(Settings.DuelOpponent)
        if opponent and opponent.Character and not isPlayerFalling(opponent) then
            local hum = opponent.Character:FindFirstChildOfClass("Humanoid")
            local hrp = opponent.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 and isGroundBelow(hrp.Position) then
                State.LastTargetName = opponent.Name; State.LastTargetPlayer = opponent; State.LastTargetIsNpc = false
                return opponent.Character
            end
        end
    end
    if Settings.ThreatSystemEnabled then
        local primary = getHighestThreat()
        if primary and not isPlayerFalling(primary) then
            local char = primary.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 and isOnGround(primary) and isGroundBelow(hrp.Position) then
                    State.PrimaryThreat = primary
                    State.LastTargetName = primary.Name; State.LastTargetPlayer = primary; State.LastTargetIsNpc = false
                    return char
                end
            end
        end
    end
    local candidates = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not isPlayerFalling(player) then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 and isGroundBelow(hrp.Position) then
                if isWhitelisted(player) then continue end
                if isAlly(player) then continue end
                if Settings.Blacklist ~= "" and not isBlacklisted(player) then continue end
                if Settings.AvoidDangerous and isDangerousGlove(player) then continue end
                if not isOnGround(player) then continue end
                table.insert(candidates, player)
            end
        end
    end
    if #candidates == 0 then
        if Settings.ZoneControlEnabled and State.ZoneCenter then
            State.PatrolTarget = State.ZoneCenter + Vector3.new(math.random(-10,10), 0, math.random(-10,10))
        else
            State.PatrolTarget = nil
        end
        return nil
    end
    State.PatrolTarget = nil
    local bestScore = -math.huge; local bestTarget, bestPlayer = nil, nil
    for _, player in ipairs(candidates) do
        local score = evaluateTarget(player, myRoot)
        if score > bestScore then bestScore = score; bestTarget = player.Character; bestPlayer = player end
    end
    if bestTarget then
        State.LastTargetName = bestPlayer.Name; State.LastTargetPlayer = bestPlayer; State.LastTargetIsNpc = false
        return bestTarget
    end
end

-- ===================== ОЦЕНКА СИТУАЦИИ =====================
local function evaluateSituation(targetRoot, targetPlayer)
    local char = LocalPlayer.Character
    if not char then return "balanced" end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return "balanced" end

    local myPos = root.Position
    local enemyPos = targetRoot and targetRoot.Position

    local botNearEdge = isEdgeAhead(3)
    local enemyNearEdge = enemyPos and isPointNearEdge(enemyPos, 4)

    local enemyAttacking = false
    if targetPlayer and targetPlayer.Character then
        local tool = targetPlayer.Character:FindFirstChildOfClass("Tool")
        if tool and tool.Enabled then enemyAttacking = true end
    end

    if botNearEdge and enemyAttacking and enemyPos and (myPos - enemyPos).Magnitude < 10 then
        return "edge_jump_counter"
    elseif botNearEdge then
        return "avoid_edge"
    elseif enemyNearEdge and enemyPos and (myPos - enemyPos).Magnitude < 15 then
        local distToEnemy = (myPos - enemyPos).Magnitude
        if distToEnemy > (Settings.MinDistance + 3) then
            return "edge_cautious"
        else
            return "edge_control"
        end
    elseif isEdgeAhead(6) and enemyPos and (myPos - enemyPos).Magnitude < 15 and math.random() < 0.3 and Settings.BaitEdgeEnabled then
        return "bait_edge"
    else
        return "balanced"
    end
end

