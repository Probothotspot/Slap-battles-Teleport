    local mem = State.AbilityMemory[abilityName]
    if not mem then tool:Activate(); abilityTimer = tick(); learnFromExperience("ability_used", {}); return end
    local shouldUse = false
    if mem.bestMoment == "afterDodge" and tick() - State.LastDodgeTime < 1 then shouldUse = true
    elseif mem.bestMoment == "afterSlap" and tick() - State.LastSlapTime < 0.5 then shouldUse = true
    elseif mem.bestMoment == "whileEnemyAttacking" and State.LastTargetPlayer then
        local enemyChar = State.LastTargetPlayer.Character
        if enemyChar then
            local enemyTool = enemyChar:FindFirstChildOfClass("Tool")
            if enemyTool and enemyTool.Enabled then shouldUse = true end
        end
    end
    if shouldUse then tool:Activate(); abilityTimer = tick(); learnFromExperience("ability_used", {}); analyzeAbilityMoment() end
end

-- ===================== ОБХОД ПРЕПЯТСТВИЙ (старый, без pathfinding) =====================
local function smartMoveTo(targetPos, checkEdge)
    if checkEdge == nil then checkEdge = Settings.SafeEdgeCheck end
    local char = LocalPlayer.Character; if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid"); local root = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return false end
    humanoid.WalkSpeed = Settings.WalkSpeed; humanoid.Sit = false

    local dirToTarget = (targetPos - root.Position).Unit
    if dirToTarget.Magnitude < 0.01 then return true end

    if not isGroundBelow(targetPos) then
        targetPos = findSafePositionNear(targetPos)
    end

    if checkEdge and isEdgeAhead(4, dirToTarget) then
        local right = dirToTarget:Cross(Vector3.yAxis).Unit
        local back = -dirToTarget
        local alternatives = { right, -right, (back + right).Unit, (back - right).Unit }
        local bestDir = nil
        for _, dir in ipairs(alternatives) do
            local testPos = root.Position + dir * 5
            if isGroundBelow(testPos) and not isEdgeAhead(4, dir) then
                bestDir = dir
                break
            end
        end
        if bestDir then
            humanoid:MoveTo(root.Position + bestDir * 8)
        else
            humanoid:MoveTo(root.Position + back * 5)
        end
        return false
    end

    humanoid:MoveTo(targetPos)
    local startTime = tick()
    while (root.Position - targetPos).Magnitude > 1 and tick() - startTime < 5 do
        if not Settings.Enabled or not isOnArena() then return false end
        if root.Velocity.Y < -50 then
            humanoid:Move(Vector3.zero, true); humanoid.Jump = true; return false
        end
        if checkEdge and isEdgeAhead(2, dirToTarget) then
            humanoid:Move(Vector3.zero, true)
            return false
        end

        -- Проверка на перепрыгиваемое препятствие
        local rayOrigin = root.Position + Vector3.new(0, 1, 0)
        local rayDir = dirToTarget * 4
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = {char}
        local hit = Workspace:Raycast(rayOrigin, rayDir, params)
        if hit then
            local obstacle = hit.Instance
            if obstacle and obstacle:IsA("BasePart") then
                local height = obstacle.Size.Y
                if height <= 5 and humanoid.FloorMaterial ~= Enum.Material.Air then
                    humanoid.Jump = true
                end
            end
        end

        task.wait(0.2)
    end
    humanoid:Move(Vector3.zero, true)
    return true
end

-- ===================== НАВИГАЦИЯ С ПОИСКОМ ПУТИ =====================
local function isPathClear(targetPos)
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local rayOrigin = root.Position
    local rayDir = (targetPos - root.Position).Unit * 5  -- луч на 5 метров
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {char}
    local hit = Workspace:Raycast(rayOrigin, rayDir, params)
    if hit then return false end

    if isEdgeAhead(4, (targetPos - root.Position).Unit) then return false end
    return true
end

local function findPath(targetPos)
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentMaxSlope = 45,
        AgentCanJump = true,
        AgentMaxClimb = 2,
        Costs = { Water = 20, Pathfindable = 1 }
    })
    local success, errorMsg = pcall(function()
        path:ComputeAsync(root.Position, targetPos)
    end)
    if success and path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        local validWaypoints = {}
        for _, wp in ipairs(waypoints) do
            if wp.Action ~= Enum.PathWaypointAction.Jump and isGroundBelow(wp.Position) then
                table.insert(validWaypoints, wp.Position)
            end
        end
        if #validWaypoints > 0 then
            return validWaypoints
        end
    end
    return nil
end

local function navigateTo(targetPos)
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end

    if (root.Position - targetPos).Magnitude < 2 then
        humanoid:Move(Vector3.zero, true)
        return
    end

    if isPathClear(targetPos) then
        smartMoveTo(targetPos, Settings.SafeEdgeCheck)
    else
        local waypoints = findPath(targetPos)
        if waypoints then
            for _, wp in ipairs(waypoints) do
                if (root.Position - wp).Magnitude < 2 then continue end
                smartMoveTo(wp, Settings.SafeEdgeCheck)
                if (root.Position - targetPos).Magnitude < Settings.AttackRange then break end
                task.wait(0.1)
            end
        else
            -- Если путь не найден, прекращаем движение к этой цели
            State.LastTargetPlayer = nil
            State.LastTargetName = nil
        end
    end
end

