local function splitList(str)
    local t = {}
    for part in (str .. ","):gmatch("([^,]*),") do
        local trimmed = part:match("^%s*(.-)%s*$")
        if trimmed ~= "" then t[#t+1] = trimmed end
    end
    return t
end
