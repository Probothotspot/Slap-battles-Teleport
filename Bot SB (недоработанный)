local function isPointNearEdge(point, dist)
    for _, dir in ipairs({Vector3.new(1,0,0), Vector3.new(-1,0,0), Vector3.new(0,0,1), Vector3.new(0,0,-1)}) do
        local checkPos = point + dir * dist
        local rayOrigin = checkPos + Vector3.new(0,2,0)
        local rayDir = Vector3.new(0,-10,0)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = {LocalPlayer.Character}
        local hit = Workspace:Raycast(rayOrigin, rayDir, params)
        if not hit then return true end
    end
    return false
end

