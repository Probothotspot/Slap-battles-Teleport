    local rayOrigin = checkPos + Vector3.new(0, 2, 0)
    local rayDir = Vector3.new(0, -10, 0)
    local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Blacklist; params.FilterDescendantsInstances = {char}
