local function executeEdgeCautious(targetRoot, targetPlayer)
    local char = LocalPlayer.Character; if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return false end

    local targetPos = targetRoot.Position
    local dist = (root.Position - targetPos).Magnitude
    local minDist = Settings.MinDistance + 2

    if dist <= minDist then
        return false
    end

    humanoid.WalkSpeed = Settings.WalkSpeed * 0.6

    local strafeOld = Settings.StrafeEnabled
    Settings.StrafeEnabled = true
    performStrafe(targetPos, root, humanoid, targetRoot)
    Settings.StrafeEnabled = strafeOld

    local toTarget = (targetPos - root.Position).Unit
    local right = toTarget:Cross(Vector3.yAxis).Unit
    local offset = right * (math.random() < 0.5 and 3 or -3)
    humanoid:MoveTo(targetPos + offset)

    if dist <= Settings.AttackRange and tick() - State.LastSlapTime > 1.0 then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
        Stats.Slaps = Stats.Slaps + 1; Stats.HitsLanded = Stats.HitsLanded + 1
        State.LastSlapTime = tick()
    end

    State.TacticMode = "edge_cautious"
    return true
end

local function executeEdgeControl(targetRoot, targetPlayer)
    local char = LocalPlayer.Character; if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return false end

    local enemyPos = targetRoot.Position
    local toEnemy = (enemyPos - root.Position).Unit
    local dist = (root.Position - enemyPos).Magnitude

    local right = toEnemy:Cross(Vector3.yAxis).Unit
    local sideOffset = right * 4
    local flankPos = enemyPos + toEnemy * 3 + sideOffset * (math.random() < 0.5 and 1 or -1)

    humanoid:MoveTo(flankPos)
    State.TacticMode = "edge_control"

    if dist < Settings.AttackRange + 2 then
        if tryEdgePush(targetRoot, targetPlayer) then
            return true
        end
    end
    return false
end

-- ===================== АДАПТАЦИЯ ПО ВРЕМЕНИ =====================
local function applyTimeBoost()
    if not Settings.AdaptationEnabled then return end
    if tick() - State.LastStatBoost < 15 then return end
    State.LastStatBoost = tick()
    local speed = Settings.AdaptationSpeed or 1
    Settings.PredictionFactor = math.min(1.0, Settings.PredictionFactor + 0.03 * speed)
    Settings.AttackRange = math.min(25, Settings.AttackRange + 0.3 * speed)
    if Settings.Difficulty == "Эксперт" then
        Settings.WalkSpeed = math.min(40, Settings.WalkSpeed + 1 * speed)
    end
end

-- ===================== БОЙ ====================
local abilityTimer = 0
local function tryActivateAbility()
    if not (Settings.AutoAbility or Settings.UseAbility) then return end
    if tick() - abilityTimer < Settings.AbilityInterval then return end
    local char = LocalPlayer.Character; if not char then return end
    local tool = char:FindFirstChild("Ability") or char:FindFirstChildOfClass("Tool")
    if tool then tool:Activate() end; abilityTimer = tick()
end
local function getMyHealthPercent()
    local char = LocalPlayer.Character; if not char then return 100 end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return 100 end
    return (hum.Health / hum.MaxHealth) * 100
end

-- ГЛАВНЫЙ БОЕВОЙ ЦИКЛ (с навигацией)
local function fightLoop()
    local char = LocalPlayer.Character; if not char then State.Phase = "ToPoint"; return end
    local humanoid = char:FindFirstChildOfClass("Humanoid"); local root = char:FindFirstChild("HumanoidRootPart"); local tool = char:FindFirstChildOfClass("Tool")
    if not humanoid or not root or not tool then return end

    -- Применяем скорость
    if Settings.BerserkMode and getMyHealthPercent() < 30 then
        humanoid.WalkSpeed = Settings.WalkSpeed + 6
    else
        humanoid.WalkSpeed = Settings.WalkSpeed
    end

    -- Защита от падения лицом в землю
    if humanoid.FloorMaterial == Enum.Material.Air and humanoid.Sit == false and (root.Velocity.Y < -5) then
        humanoid:Move(Vector3.zero, true)
        humanoid.Jump = true
        task.wait(0.1)
        return
    end

    autoSave()
    updateZoneControl()
    applyTimeBoost()

    local targetChar = getTargetCharacter()
    if not targetChar then
        if State.PatrolTarget then smartMoveTo(State.PatrolTarget, Settings.SafeEdgeCheck)
        else humanoid:Move(Vector3.zero, true) end
        return
    end

    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("Head")
    if not targetRoot then return end

    if Settings.CameraLock and Workspace.CurrentCamera then
        Workspace.CurrentCamera.CFrame = CFrame.lookAt(root.Position, targetRoot.Position)
    end

    local enemyPlayer = State.LastTargetPlayer
    if enemyPlayer then
        updateEnemyAbilityState(enemyPlayer)
        updateEnemyAttackPattern(enemyPlayer)
    end

    local targetVel = targetRoot.Velocity or targetRoot.AssemblyLinearVelocity or Vector3.zero
    local isTargetAFK = targetVel.Magnitude < 2

    if tick() - State.LastEvaluation > 0.2 then
        State.LastEvaluation = tick()
        local newMode = evaluateSituation(targetRoot, enemyPlayer)
        if State.TacticMode ~= "edge_jump_counter" and State.TacticMode ~= "avoid_edge" and State.TacticMode ~= "edge_control" and State.TacticMode ~= "edge_cautious" then
            State.TacticMode = newMode
        end
    end

    local currentMode = State.TacticMode

    if currentMode == "edge_jump_counter" then
        if executeEdgeJumpCounter(targetRoot, enemyPlayer) then return end
    elseif currentMode == "avoid_edge" then
        executeAvoidEdge(targetRoot, enemyPlayer)
        State.TacticMode = "balanced"
        return
    elseif currentMode == "edge_cautious" then
        if executeEdgeCautious(targetRoot, enemyPlayer) then return end
        State.TacticMode = "edge_control"
        if executeEdgeControl(targetRoot, enemyPlayer) then return end
        State.TacticMode = "balanced"
        return
    elseif currentMode == "edge_control" then
        if executeEdgeControl(targetRoot, enemyPlayer) then return end
        State.TacticMode = "balanced"
    elseif currentMode == "bait_edge" and Settings.BaitEdgeEnabled then
        if tryBaitEdge(targetRoot.Position, targetRoot, enemyPlayer) then return end
    end

    local myHP = getMyHealthPercent()
    if Settings.BerserkMode and myHP < 30 then Settings.DodgeEnabled = false; humanoid.WalkSpeed = Settings.WalkSpeed + 6
    else Settings.DodgeEnabled = true; humanoid.WalkSpeed = Settings.WalkSpeed end

    if enemyPlayer and Settings.PatternInterruptEnabled and tryInterruptAttack(targetRoot, enemyPlayer) then return end
    if enemyPlayer and Settings.FeintEnabled and tryFeint(targetRoot.Position, enemyPlayer) then return end
    if Settings.EdgePushEnabled and tryEdgePush(targetRoot, State.LastTargetPlayer) then return end

    if enemyPlayer and Settings.MimicMode then
        local mimicDir = getMimicDodge(enemyPlayer)
        if mimicDir then humanoid:Move(Vector3.new(tonumber(mimicDir) or 0, 0, 0), false) end
    end

    if enemyPlayer and Settings.AdaptiveCooldownEnabled then
        local cdRemain = getEnemyAbilityCooldownRemaining(enemyPlayer)
        humanoid.WalkSpeed = (cdRemain > 2) and Settings.WalkSpeed + 4 or Settings.WalkSpeed
    end

    if Settings.ZoneControlEnabled and not isInZone(root.Position) then
        local zonePos = getZonePosition()
        if zonePos then State.TacticMode = "zonecontrol"; smartMoveTo(zonePos, Settings.SafeEdgeCheck); return end
    end

    humanizeAction("ability")
    if Settings.SmartAbilitiesEnabled then trySmartAbility()
    else tryActivateAbility() end

    if Settings.AdvancedDodgeEnabled then
        if tryAdvancedDodge() then return end
    else
        if Settings.DodgeEnabled and tryDodge() then return end
    end

    local predictedPos = getPredictedPosition(targetRoot)
    local dist = (root.Position - predictedPos).Magnitude
    local minDist = Settings.MinDistance or 5

    if enemyPlayer and Settings.HitAndRunEnabled and shouldHitAndRun(enemyPlayer) and dist <= Settings.AttackRange and tick() - State.LastHitAndRun > 2 then
        State.TacticMode = "hitandrun"
        task.spawn(function() executeHitAndRun(predictedPos) end)
        return
    end

    State.TacticMode = "balanced"

    -- ГАРАНТИРОВАННАЯ АТАКА
    if dist <= Settings.AttackRange and tick() - State.LastSlapTime > 1.0 and not shouldMakeMistake(0.08) then
        humanizeAction("attack")
        tool:Activate()
        Stats.Slaps = Stats.Slaps + 1; Stats.HitsLanded = Stats.HitsLanded + 1; State.LastSlapTime = tick()
        if State.LastTargetPlayer then
            updateEnemyMemory(State.LastTargetPlayer, "attacked")
            if Settings.RealTimeAdaptation then recordCombatEvent(State.LastTargetPlayer, "hit", dist) end
            local enemyHum = targetChar:FindFirstChildOfClass("Humanoid")
            if enemyHum and enemyHum.Health <= 0 then learnFromExperience("we_killed_enemy", {enemy = State.LastTargetPlayer.Name}) end
        end
        if Settings.AbilityComboEnabled and not Settings.SmartAbilitiesEnabled then
            task.spawn(function() task.wait(0.1); tryActivateAbility() end)
        end
    elseif dist <= Settings.AttackRange and State.LastTargetPlayer and Settings.RealTimeAdaptation then
        recordCombatEvent(State.LastTargetPlayer, "miss", dist)
    end

    -- ДВИЖЕНИЕ
    if dist > Settings.AttackRange then
        local moveTarget = getStealthMoveTarget(predictedPos)
        navigateTo(moveTarget)   -- УМНАЯ НАВИГАЦИЯ
    elseif dist < minDist then
        local retreatDir = (root.Position - predictedPos).Unit
        if retreatDir.Magnitude < 0.1 then retreatDir = Vector3.new(1,0,0) end
        local retreatPos = root.Position + retreatDir * (minDist - dist + 0.5)
        humanoid:MoveTo(retreatPos)
    else
        humanoid:Move(Vector3.zero, true)
        if Settings.FlankEnabled and tick() - State.LastFlankTime > 2.5 then
            tryFlank(targetRoot)
        end
        if Settings.StrafeEnabled then
            performStrafe(predictedPos, root, humanoid, targetRoot)
        else
            root.CFrame = CFrame.lookAt(root.Position, predictedPos)
        end
    end
end

