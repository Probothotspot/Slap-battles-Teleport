function BrainStorage.load(slot)
    slot = slot or currentSaveSlot
    local data = BrainStorage.loadFromDataStore(slot) or BrainStorage.loadFromFile(slot)
    if data then
        EnemyMemory = data.EnemyMemory or EnemyMemory
        TrainingData = data.TrainingData or TrainingData
        State.AbilityMemory = data.AbilityMemory or State.AbilityMemory
        State.MimicData = data.MimicData or State.MimicData
