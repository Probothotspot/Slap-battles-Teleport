-- ==================== ГЛАВНЫЙ ЦИКЛ ====================
local botConnection = nil
local function startBot()
    if botConnection then return end
    print("🔴 Махорага v5.1 ADAPTIVE EDGE запускается...")
    local waitStart = tick()
    while not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) do
        if tick() - waitStart > 15 then warn("❌ Персонаж не загрузился"); return end
        task.wait(0.5)
    end
    local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.Sit = false end
    State.Phase = isOnArena() and "Fighting" or "ToPoint"
    State.RoundStartTime = tick()
    State.LastStatBoost = tick()

    botConnection = RunService.Heartbeat:Connect(function()
        if not Settings.Enabled then stopBot(); return end
        if State.Phase == "Fighting" and not isOnArena() then State.Phase = "ToPoint"
        elseif State.Phase == "ToPoint" and isOnArena() then State.Phase = "Fighting" end
        if State.Phase == "ToPoint" then walkToPortal()
        elseif State.Phase == "Fighting" then fightLoop() end
    end)
    print("✅ Махорага активирован")
end
local function stopBot()
    if botConnection then botConnection:Disconnect(); botConnection = nil end
    local char = LocalPlayer.Character
    if char then local humanoid = char:FindFirstChildOfClass("Humanoid"); if humanoid then humanoid:Move(Vector3.zero, true) end end
    State.LastTargetPlayer = nil; State.LastTargetName = nil
end

