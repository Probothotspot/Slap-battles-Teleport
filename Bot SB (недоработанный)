            Settings.StrafeEnabled = data.Settings.StrafeEnabled or Settings.StrafeEnabled
            Settings.UseAbility = data.Settings.UseAbility or Settings.UseAbility
            Settings.Allies = data.Settings.Allies or Settings.Allies
