local function updateEnemyMemory(player, action)
    if not Settings.EnemyMemoryEnabled then return end
    local name = player.Name
    if not EnemyMemory[name] then
        EnemyMemory[name] = {deathsFrom={}, lastSeen=tick(), aggressiveActions=0, passiveActions=0, patterns={}, lastPositions={}}
    end
    local mem = EnemyMemory[name]; mem.lastSeen = tick()
    if action == "killed" then
        local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
        local glove = tool and tool.Name or "Unknown"
        mem.deathsFrom[glove] = (mem.deathsFrom[glove] or 0) + 1
        local myChar = LocalPlayer.Character
        if myChar then
            local myRoot = myChar:FindFirstChild("HumanoidRootPart")
            local enemyRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if myRoot and enemyRoot then
                local dist = (myRoot.Position - enemyRoot.Position).Magnitude
                table.insert(mem.patterns, {action="kill", distance=dist, glove=glove, time=tick()})
            end
        end
    elseif action == "attacked" then
        mem.aggressiveActions = mem.aggressiveActions + 1
        local enemyRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if enemyRoot then table.insert(mem.lastPositions, enemyRoot.Position); if #mem.lastPositions > 10 then table.remove(mem.lastPositions, 1) end end
    elseif action == "dodged" then mem.passiveActions = mem.passiveActions + 1 end
end
local function getMostDangerousGlove(player)
    local mem = EnemyMemory[player.Name]
    if not mem or not mem.deathsFrom then return nil end
    local maxCount, gloveName = 0, nil
    for g, count in pairs(mem.deathsFrom) do if count > maxCount then maxCount = count; gloveName = g end end
    return gloveName, maxCount
end
local function evaluateTarget(player, myRoot)
    local char = player.Character; if not char then return 0 end
    local hum = char:FindFirstChildOfClass("Humanoid"); local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return 0 end
    local score = 50
    if Settings.FinishLowHP and hum.Health < 20 then score = score + 100
    else score = score + (100 - hum.Health) * 0.5 end
    if isDangerousGlove(player) then score = score - 60 end
    local dangerousGlove, deaths = getMostDangerousGlove(player)
    if dangerousGlove and deaths and deaths >= 2 then score = score - 100 end
    local dist = (myRoot.Position - hrp.Position).Magnitude
    if dist < Settings.AttackRange * 0.8 then score = score + 20
    elseif dist < Settings.AttackRange * 1.5 then score = score + 10
    elseif dist > Settings.AggroRange * 0.8 then score = score - 30 end
    local mem = EnemyMemory[player.Name]
    if mem and mem.aggressiveActions > mem.passiveActions * 2 then score = score - 15 end
    if Settings.NoSpawnKill and char:GetAttribute("LastSpawn") and tick() - char:GetAttribute("LastSpawn") < 2 then score = -1000 end
    return score
end

