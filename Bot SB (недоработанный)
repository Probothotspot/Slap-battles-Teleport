local function updateZoneControl()
    if not Settings.ZoneControlEnabled then return end
    if tick() - State.LastZoneUpdate < 2 then return end
    State.LastZoneUpdate = tick()
    local char = LocalPlayer.Character; if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
    local totalPos = Vector3.zero; local count = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            totalPos = totalPos + player.Character.HumanoidRootPart.Position
            count = count + 1
        end
    end
    if count > 0 then State.ZoneCenter = totalPos / count else State.ZoneCenter = Vector3.new(-1210, 330, 3) end
    if State.ZoneCenter then
        local enemiesNearCenter = 0
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - State.ZoneCenter).Magnitude < Settings.ZoneControlRadius then
                    enemiesNearCenter = enemiesNearCenter + 1
                end
            end
        end
        if enemiesNearCenter > 2 then
            local offset = Vector3.new(math.random(-1,1), 0, math.random(-1,1)).Unit * Settings.ZoneControlRadius * 0.7
            State.ZoneCenter = State.ZoneCenter + offset
        end
    end
end
local function isInZone(pos)
    if not Settings.ZoneControlEnabled or not State.ZoneCenter then return true end
    return (pos - State.ZoneCenter).Magnitude <= Settings.ZoneControlRadius
end
local function getZonePosition()
    if not Settings.ZoneControlEnabled or not State.ZoneCenter then return nil end
    local char = LocalPlayer.Character; if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return nil end
    if not isInZone(root.Position) then
        local dirToZone = (State.ZoneCenter - root.Position).Unit
        return State.ZoneCenter - dirToZone * Settings.ZoneControlRadius * 0.5
    end
    return nil
end

