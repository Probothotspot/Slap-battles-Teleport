local function performStrafe(targetPos, myRoot, humanoid, targetRoot)
    if not Settings.StrafeEnabled then return end

    local now = tick()
    local dist = (myRoot.Position - targetPos).Magnitude
    local minDist = Settings.MinDistance or 5

    if now >= State.StrafeNextChange then
        State.StrafeNextChange = now + 0.2 + math.random() * 0.2
        local dirToTarget = (targetPos - myRoot.Position).Unit
        if dirToTarget.Magnitude == 0 then dirToTarget = Vector3.new(1,0,0) end
        local rightDir = dirToTarget:Cross(Vector3.yAxis).Unit
        local backDir = -dirToTarget

        local choices = {}
        local function addIfSafe(dir)
            local testPos = myRoot.Position + dir * 3
            if isGroundBelow(testPos) then
                table.insert(choices, dir)
            end
        end
        addIfSafe(rightDir)
        addIfSafe(-rightDir)
        if dist < Settings.AttackRange * 0.8 then
            addIfSafe((backDir + rightDir).Unit)
            addIfSafe((backDir - rightDir).Unit)
        end
        if dist > minDist then
            addIfSafe((dirToTarget + rightDir).Unit)
            addIfSafe((dirToTarget - rightDir).Unit)
        end
        addIfSafe(dirToTarget)
        addIfSafe(backDir)

        if #choices > 0 then
            State.StrafeDirection = choices[math.random(#choices)]
        else
            State.StrafeDirection = dirToTarget
        end
    end

    humanoid:Move(State.StrafeDirection * (Settings.WalkSpeed * 0.5), false)
    myRoot.CFrame = CFrame.lookAt(myRoot.Position, targetPos)
end

