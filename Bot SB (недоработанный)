local function shouldHitAndRun(enemy)
    if not Settings.HitAndRunEnabled then return false end
    local char = LocalPlayer.Character; if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return false end
    local myHP = (hum.Health / hum.MaxHealth) * 100
    if isDangerousGlove(enemy) then return true end
    if myHP < Settings.HitAndRunHPThreshold then return true end
    if Settings.EnemyMemoryEnabled and EnemyMemory[enemy.Name] then
        local totalDeaths = 0
        for _, count in pairs(EnemyMemory[enemy.Name].deathsFrom or {}) do totalDeaths = totalDeaths + count end
        if totalDeaths >= 2 then return true end
    end
    return false
end
local function executeHitAndRun(targetPos)
    local char = LocalPlayer.Character; if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid"); local root = char:FindFirstChild("HumanoidRootPart"); local tool = char:FindFirstChildOfClass("Tool")
    if not humanoid or not root or not tool then return end
    humanoid.WalkSpeed = Settings.WalkSpeed * 1.3
    humanoid:MoveTo(targetPos)
    local timeout = tick() + 1.5
    while tick() < timeout do if (root.Position - targetPos).Magnitude < Settings.AttackRange then break end; task.wait(0.1) end
    tool:Activate(); Stats.Slaps = Stats.Slaps + 1; Stats.HitsLanded = Stats.HitsLanded + 1; State.LastSlapTime = tick()
    local retreatDir = (root.Position - targetPos).Unit
    if retreatDir.Magnitude == 0 then retreatDir = -humanoid.MoveDirection.Unit end
    if retreatDir.Magnitude == 0 then retreatDir = Vector3.new(1,0,0) end
    local retreatPos = root.Position + retreatDir * Settings.AttackRange * 2
    humanoid:MoveTo(retreatPos); task.wait(0.5); humanoid.WalkSpeed = Settings.WalkSpeed; State.LastHitAndRun = tick()
    if Settings.DuelTrainingMode then TrainingData.successfulTactics.hitAndRun = (TrainingData.successfulTactics.hitAndRun or 0) + 1 end
end

