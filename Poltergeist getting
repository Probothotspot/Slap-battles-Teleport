-- ========== ФУНКЦИИ ==========
local function updateHitRemotes()
    table.clear(hitRemotes)
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") and string.find(obj.Name:lower(), "hit") then
            table.insert(hitRemotes, obj)
        end
    end
end

local function isAboveGround(part)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {part.Parent}
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local result = workspace:Raycast(part.Position, Vector3.new(0, -50, 0), params)
    return result ~= nil
end

RunService.Heartbeat:Connect(function()
    if not autoHitEnabled then return end
    local now = tick()
    if now - lastHit < HIT_INTERVAL then return end
    lastHit = now
    updateHitRemotes()
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return end
    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
        local head = enemy:FindFirstChild("Head")
        if head and head:IsA("BasePart") and isAboveGround(head) then
            for _, remote in ipairs(hitRemotes) do
                pcall(function()
                    remote:FireServer(head)
                end)
            end
        end
    end
end)

