local function switchTab(tabName)
    if isCollapsed then return end
    local oldTab = activeTab
    activeTab = tabName

    local slideInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    if tabName == "detector" then
        -- Анимация ухода инспектора вправо
        if oldTab == "inspector" then
            TweenService:Create(inspectorContent, slideInfo,
                {Position = UDim2.new(1, 0, 0, 41)}):Play()
            task.delay(0.2, function()
                inspectorContent.Visible = false
                inspectorContent.Position = UDim2.new(0, 5, 0, 41)
            end)
        end
        -- Анимация появления детектора слева
        detectorContent.Position = UDim2.new(-1, 0, 0, 41)
        detectorContent.Visible = true
        TweenService:Create(detectorContent, slideInfo,
            {Position = UDim2.new(0, 5, 0, 41)}):Play()

