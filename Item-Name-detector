local function inspectObject(obj)
    if not obj then return end
    lastInspectedObj = obj
    selectionBox.Adornee = obj
    selectionBox.Color3 = Color3.fromRGB(100, 255, 150)
    objectNameLabel.Text = obj.Name ~= "" and obj.Name or obj.ClassName
    clearInspectorScroll()
    lastInspectedData = {}

    local function safeGet(fn)
        local ok, val = pcall(fn)
        return ok and tostring(val) or "н/д"
    end

    lastInspectedData["Name"] = obj.Name ~= "" and obj.Name or obj.ClassName
    lastInspectedData["ClassName"] = obj.ClassName
    lastInspectedData["Parent"] = obj.Parent and obj.Parent.Name or "nil"
    lastInspectedData["FullPath"] = obj:GetFullName()
    lastInspectedData["Anchored"] = safeGet(function() return obj.Anchored end)
    lastInspectedData["CanCollide"] = safeGet(function() return obj.CanCollide end)
    lastInspectedData["Locked"] = safeGet(function() return obj.Locked end)
    lastInspectedData["Massless"] = safeGet(function() return obj.Massless end)
    lastInspectedData["Material"] = safeGet(function() return tostring(obj.Material):gsub("Enum.Material.", "") end)
    lastInspectedData["ColorRGB"] = safeGet(function()
        local c = obj.Color
        return math.floor(c.R*255)..","..math.floor(c.G*255)..","..math.floor(c.B*255)
    end)
    lastInspectedData["BrickColor"] = safeGet(function() return tostring(obj.BrickColor) end)
    lastInspectedData["Transparency"] = safeGet(function() return obj.Transparency end)
    lastInspectedData["CastShadow"] = safeGet(function() return obj.CastShadow end)
    lastInspectedData["SizeX"] = safeGet(function() return string.format("%.2f", obj.Size.X) end)
    lastInspectedData["SizeY"] = safeGet(function() return string.format("%.2f", obj.Size.Y) end)
    lastInspectedData["SizeZ"] = safeGet(function() return string.format("%.2f", obj.Size.Z) end)
    lastInspectedData["PosX"] = safeGet(function() return string.format("%.2f", obj.Position.X) end)
    lastInspectedData["PosY"] = safeGet(function() return string.format("%.2f", obj.Position.Y) end)
    lastInspectedData["PosZ"] = safeGet(function() return string.format("%.2f", obj.Position.Z) end)
    lastInspectedData["Children"] = safeGet(function() return #obj:GetChildren() end)

    if humanoidRootPart and humanoidRootPart.Parent then
        local distOk, dist = pcall(function() return (obj.Position - humanoidRootPart.Position).Magnitude end)
        if distOk then lastInspectedData["Distance"] = string.format("%.1f", dist) end
    end

    local props = {
        {"Имя", lastInspectedData["Name"]}, {"Класс", lastInspectedData["ClassName"]},
        {"Родитель", lastInspectedData["Parent"]}, {"──", "────────"},
        {"Anchored", lastInspectedData["Anchored"]}, {"CanCollide", lastInspectedData["CanCollide"]},
        {"──", "────────"}, {"Материал", lastInspectedData["Material"]},
        {"RGB", lastInspectedData["ColorRGB"]}, {"──", "────────"},
        {"Size", lastInspectedData["SizeX"].."×"..lastInspectedData["SizeY"].."×"..lastInspectedData["SizeZ"]},
        {"Pos", lastInspectedData["PosX"]..","..lastInspectedData["PosY"]..","..lastInspectedData["PosZ"]},
        {"──", "────────"}, {"Дети", lastInspectedData["Children"]},
    }
    if lastInspectedData["Distance"] then table.insert(props, {"Расст.", lastInspectedData["Distance"].." ст."}) end
    for i, p in ipairs(props) do addInspectorRow(p[1], p[2], i) end
    teleportBtn.Visible = true
    descriptionBtn.Visible = true
    copyAllBtn.Visible = true
    hintLabel.Text = "✓ Выбран"
end

