local function isGenericName(name) return GENERIC_NAMES[name] == true end

local function shortenPath(fullName, maxParts)
    maxParts = maxParts or 3
    local segs = {}
    for seg in string.gmatch(fullName, "[^%.]+") do table.insert(segs, seg) end
    local st = math.max(1, #segs - maxParts + 1)
    local res = {}
    for i = st, #segs do table.insert(res, segs[i]) end
    return table.concat(res, " › ")
end

local function getSmartName(obj)
    local fullPath = obj:GetFullName()
    local objName = (obj.Name ~= "" and obj.Name) or obj.ClassName
    if not isGenericName(objName) then return objName, fullPath end
    local cur = obj.Parent
    local depth = 0
    while cur and cur ~= workspace and cur ~= game and depth < 10 do
        local pn = cur.Name
        if pn and pn ~= "" and not isGenericName(pn) then
            if cur:IsA("Model") then return pn .. "(м)", fullPath
            elseif cur:IsA("Folder") then return pn .. "/" .. objName, fullPath
            else return pn .. "→" .. objName, fullPath end
        end
        cur = cur.Parent
        depth = depth + 1
    end
    return shortenPath(fullPath, 3), fullPath
end

local function findParentContainer(obj)
    local cur = obj.Parent
    while cur and cur ~= workspace and cur ~= game do
        if cur:IsA("Model") or cur:IsA("Folder") then return cur end
        cur = cur.Parent
    end
    return nil
end

local function getModelDisplayName(model)
    if not isGenericName(model.Name) then return model.Name end
    local cur = model.Parent
    local depth = 0
    while cur and cur ~= workspace and cur ~= game and depth < 5 do
        if cur.Name and cur.Name ~= "" and not isGenericName(cur.Name) then
            return cur.Name .. "→" .. model.Name
        end
        cur = cur.Parent
        depth = depth + 1
    end
    return shortenPath(model:GetFullName(), 3)
end

local function isPlayerModel(model)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character == model then return true, p end
    end
    if model:FindFirstChildOfClass("Humanoid") then return true, nil end
    return false, nil
end

local function getDistanceColor(dist)
    if dist <= 30 then return Color3.fromRGB(255, 100, 150)
    elseif dist <= 60 then return Color3.fromRGB(255, 200, 100)
    else return Color3.fromRGB(150, 180, 255) end
end

