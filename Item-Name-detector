local function performScan()
    if not humanoidRootPart or not humanoidRootPart.Parent then
        statusLabel.Text = "⚠ Нет персонажа" return
    end
    local playerPos = humanoidRootPart.Position
    local allDesc = workspace:GetDescendants()
    local modelGroups, soloEntries = {}, {}

    for _, obj in ipairs(allDesc) do
        if obj:IsA("BasePart") then
            local isOwn = character and obj:IsDescendantOf(character)
            if not isOwn then
                local ok, dist = pcall(function() return (obj.Position - playerPos).Magnitude end)
                if ok and dist <= SCAN_RADIUS then
                    local container = findParentContainer(obj)
                    if container then
                        if not modelGroups[container] then
                            modelGroups[container] = {parts = {}, minDist = dist, totalParts = 0, firstPart = obj}
                        end
                        local g = modelGroups[container]
                        table.insert(g.parts, obj) g.totalParts = g.totalParts + 1
                        if dist < g.minDist then g.minDist = dist g.firstPart = obj end
                    else
                        local sn, fp = getSmartName(obj)
                        table.insert(soloEntries, {name=sn, fullPath=fp, className=obj.ClassName, distance=dist, objRef=obj})
                    end
                end
            end
        end
    end

    clearDetectorLog()
    local order, total = 0, 0
    addDetectorSeparator("── 🔮 Радиус:"..SCAN_RADIUS.." ──", order) order = order + 1

    local sorted = {}
    for m, g in pairs(modelGroups) do table.insert(sorted, {model=m, group=g}) end
    table.sort(sorted, function(a,b) return a.group.minDist < b.group.minDist end)

    for _, e in ipairs(sorted) do
        local m, g = e.model, e.group
        local col = getDistanceColor(g.minDist)
        local icon = isPlayerModel(m) and "👤" or "📦"
        local dn = getModelDisplayName(m)
        local txt = string.format("%s %s(%d)|%.0f", icon, dn, g.totalParts, g.minDist)
        addDetectorEntry(txt, col, m:GetFullName(), g.firstPart, order, dn, m.ClassName, g.minDist)
        order = order + 1 total = total + 1
    end

    if #soloEntries > 0 and #sorted > 0 then addDetectorSeparator("── Части ──", order) order = order + 1 end
    table.sort(soloEntries, function(a,b) return a.distance < b.distance end)

    for _, e in ipairs(soloEntries) do
        local col = getDistanceColor(e.distance)
        local txt = string.format("🔹 %s|%.0f", e.name, e.distance)
        addDetectorEntry(txt, col, e.fullPath, e.objRef, order, e.name, e.className, e.distance)
        order = order + 1 total = total + 1
    end

    addDetectorSeparator("── Найдено: "..total.." ──", order)
    statusLabel.Text = "🔮 Найдено: "..total
    task.defer(function() detectorScroll.CanvasPosition = Vector2.new(0, math.huge) end)
end

