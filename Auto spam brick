-- =============================================================
-- AUTO LBRICK v3.0 – Видимый интервал 1с, реальный 0.1с, счётчик +1/с
-- =============================================================
if _G.AutoLbrickRunning then return end
_G.AutoLbrickRunning = true

local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ==================== НАСТРОЙКИ ====================
local Settings = {
    Enabled = false,
    RealInterval = 0.1,     -- реальный интервал вызова RemoteEvent (не виден)
    Count = 0,
    RemoteName = "lbrick",
}

-- ==================== ПЕРЕМЕННЫЕ ====================
local lastFireTime = 0
local loopRunning = false
local renderConnection = nil
local countThread = nil      -- поток для увеличения счётчика раз в секунду

-- Ссылки на GUI
local statsLabel = nil

-- ==================== ЛОГ ====================
local LogLines = {}
local function AddLog(msg)
    local fullMsg = os.date("%X") .. " - " .. msg
    table.insert(LogLines, fullMsg)
    if #LogLines > 20 then table.remove(LogLines, 1) end
    if _G.LogLabel then
        pcall(function() _G.LogLabel.Text = table.concat(LogLines, "\n") end)
    end
    print("[AutoLbrick] " .. msg)
end

-- ==================== ТОЧНЫЙ ЦИКЛ ВЫЗОВА RemoteEvent ====================
local function StartFireLoop()
    if loopRunning then return end
    loopRunning = true

    lastFireTime = tick()
    renderConnection = RunService.RenderStepped:Connect(function()
        if not Settings.Enabled then
            if renderConnection then
                renderConnection:Disconnect()
                renderConnection = nil
            end
            loopRunning = false
            return
        end

        local now = tick()
        if now - lastFireTime >= Settings.RealInterval then
            pcall(function()
                local remote = ReplicatedStorage:FindFirstChild(Settings.RemoteName)
                if remote and remote:IsA("RemoteEvent") then
                    remote:FireServer()
                    -- Счётчик НЕ увеличиваем здесь
                else
                    AddLog("RemoteEvent '" .. Settings.RemoteName .. "' не найден!")
                end
            end)

            lastFireTime = lastFireTime + Settings.RealInterval
            if lastFireTime < now - Settings.RealInterval then
                lastFireTime = now
            end
        end
    end)
end

local function StopFireLoop()
    Settings.Enabled = false
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end
    loopRunning = false
end

-- ==================== ТАЙМЕР СЧЁТЧИКА (раз в 1 секунду) ====================
local function StartCountTimer()
    if countThread then return end
    countThread = task.spawn(function()
        while Settings.Enabled do
            task.wait(1)   -- ждём ровно 1 секунду
            if not Settings.Enabled then break end

            Settings.Count = Settings.Count + 1

            -- Мгновенное обновление GUI
            if statsLabel then
                statsLabel.Text = "Использований: " .. Settings.Count
            end
            AddLog("Использований: " .. Settings.Count)
        end
        countThread = nil
    end)
end

