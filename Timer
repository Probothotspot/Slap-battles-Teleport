-- ========= ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ =========
local function getStopwatchTime()
    if swRunning then
        return swAccum + (tick() - swStart)
    else
        return swAccum
    end
end

local function getTimerTime()
    if tRunning then
        return math.max(0, tRemaining - (tick() - tLastResume))
    else
        return tRemaining
    end
end

function updateDisplay()
    local t
    if activeTab == "stopwatch" then
        t = getStopwatchTime()
    else
        t = getTimerTime()
    end
    displayLabel.Text = formatTime(t)
    -- Для таймера: красный цвет, если дошли до 0
    if activeTab == "timer" and t <= 0 and tTarget > 0 then
        displayLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    else
        displayLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

-- ========= УПРАВЛЕНИЕ СЕКУНДОМЕРОМ =========
