    if not swRunning then
        swRunning = true
        swStart = tick()
        swStartPauseBtn.Text = "Пауза"
        swStartPauseBtn.BackgroundColor3 = Color3.fromRGB(200, 160, 0)
    else
        swRunning = false
        swAccum = swAccum + (tick() - swStart)
        swStartPauseBtn.Text = "Старт"
        swStartPauseBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
        updateDisplay()
    end
end)

