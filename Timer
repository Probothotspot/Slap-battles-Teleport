-- Пауза / Продолжить таймер
tPauseBtn.MouseButton1Click:Connect(function()
    if tTarget <= 0 then return end
    if tRunning then
        -- Поставить на паузу
        tRemaining = math.max(0, tRemaining - (tick() - tLastResume))
        tRunning = false
        tPauseBtn.Text = "Старт"
        tPauseBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
        updateDisplay()
    else
        -- Продолжить
        tRunning = true
        tLastResume = tick()
        tPauseBtn.Text = "Пауза"
        tPauseBtn.BackgroundColor3 = Color3.fromRGB(200, 160, 0)
    end
end)

-- Сброс таймера (останавливает и возвращает к изначально установленному времени)
tResetBtn.MouseButton1Click:Connect(function()
    if tTarget > 0 then
        tRunning = false
        tRemaining = tTarget
        tPauseBtn.Text = "Старт"
        tPauseBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
        updateDisplay()
    end
end)

-- Автоматическая остановка, когда время вышло
local function autoStopTimer()
    if activeTab == "timer" and tRunning and getTimerTime() <= 0 then
        tRunning = false
        tRemaining = 0
        tPauseBtn.Text = "Старт"
        tPauseBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
        updateDisplay()
    end
end

-- ========= ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК =========
local function switchTab(tab)
    activeTab = tab
    if tab == "stopwatch" then
        containerStopwatch.Visible = true
        containerTimer.Visible = false
        tabStopwatch.BackgroundColor3 = Color3.fromRGB(80, 140, 200)
        tabTimer.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
    else
        containerStopwatch.Visible = false
        containerTimer.Visible = true
        tabStopwatch.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
        tabTimer.BackgroundColor3 = Color3.fromRGB(200, 120, 60)
    end
    updateDisplay()
end

tabStopwatch.MouseButton1Click:Connect(function() switchTab("stopwatch") end)
tabTimer.MouseButton1Click:Connect(function() switchTab("timer") end)

