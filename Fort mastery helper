local function addEquipLog(text)
    local time = os.date("%H:%M:%S")
    local logText = "[" .. time .. "] " .. text
    table.insert(equipState.logLines, logText)
    if #equipState.logLines > 3 then table.remove(equipState.logLines, 1) end
    pcall(function()
        for _, child in ipairs(logFrame:GetChildren()) do if child:IsA("TextLabel") then child:Destroy() end end
        for idx, line in ipairs(equipState.logLines) do
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -4, 0, 12)
            lbl.BackgroundTransparency = 1
            lbl.TextColor3 = Color3.fromRGB(160, 140, 200)
            lbl.TextSize = 7
            lbl.Font = Enum.Font.Code
            lbl.Text = line
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = logFrame
        end
