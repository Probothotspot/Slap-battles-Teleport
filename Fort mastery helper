-- ═══ ФУНКЦИЯ ОБНОВЛЕНИЯ ПОЗИЦИИ ВКЛАДОК ═══
local function updateTabPosition(offset, animated)
    -- Ограничить offset в диапазоне [0, MAX_TAB_OFFSET]
    offset = math.clamp(offset, 0, MAX_TAB_OFFSET)
    tabSwipeOffset = offset

    if animated then
        -- Плавная анимация через TweenService
        for i, btn in ipairs(tabButtons) do
            local targetX = (i - 1) * TAB_BUTTON_WIDTH - offset
            TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, targetX, 0, 0)}):Play()
        end
    else
        -- Мгновенное перемещение (во время свайпа)
        for i, btn in ipairs(tabButtons) do
            local targetX = (i - 1) * TAB_BUTTON_WIDTH - offset
            btn.Position = UDim2.new(0, targetX, 0, 0)
        end
    end
end

-- ═══ ОБРАБОТКА СВАЙПА НА TABBAR ═══
tabBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        tabSwiping = true
        tabSwipeStart = input.Position.X
        tabTargetOffset = tabSwipeOffset  -- запомнить начальный offset
    end
end)

tabBar.InputChanged:Connect(function(input)
    if tabSwiping and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        -- Вычислить смещение пальца
        local deltaX = tabSwipeStart - input.Position.X
        -- Обновить позицию (мгновенно, без анимации)
        local newOffset = tabTargetOffset + deltaX
        updateTabPosition(newOffset, false)
    end
end)

tabBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if tabSwiping then
            tabSwiping = false
            -- Проверка: клик или свайп?
            local totalDelta = math.abs(input.Position.X - tabSwipeStart)
            if totalDelta < 5 then
                -- Это был клик — пусть кнопка обработает сама
                return
            end
            -- Это свайп — snap к ближайшей позиции
            local snapped = math.round(tabSwipeOffset / TAB_BUTTON_WIDTH) * TAB_BUTTON_WIDTH
            snapped = math.clamp(snapped, 0, MAX_TAB_OFFSET)
            updateTabPosition(snapped, true)  -- с анимацией
        end
    end
end)

-- ═══ СВАЙП ПО КОНТЕНТУ ДЛЯ ПЕРЕКЛЮЧЕНИЯ ВКЛАДОК ═══
local contentSwiping = false
local contentSwipeStartX = nil
local contentSwipeStartY = nil
local SWIPE_THRESHOLD = 30  -- минимум 30px для переключения

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        -- Только если ниже tabBar (Y > 50)
        local relY = input.Position.Y - mainFrame.AbsolutePosition.Y
        if relY > 50 then
            contentSwiping = true
            contentSwipeStartX = input.Position.X
            contentSwipeStartY = input.Position.Y
        end
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if contentSwiping and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
        contentSwiping = false
        local deltaX = input.Position.X - contentSwipeStartX
        local deltaY = math.abs(input.Position.Y - contentSwipeStartY)
        -- Только горизонтальный свайп (deltaX > deltaY)
        if math.abs(deltaX) >= SWIPE_THRESHOLD and math.abs(deltaX) > deltaY then
            if deltaX < 0 then
                -- Свайп влево → следующая вкладка
                if currentTab < #tabNames then
                    switchTab(currentTab + 1)
                    -- Автоскролл tabBar чтобы показать активную вкладку
                    local neededOffset = math.max(0, (currentTab - 4) * TAB_BUTTON_WIDTH)
                    neededOffset = math.clamp(neededOffset, 0, MAX_TAB_OFFSET)
                    updateTabPosition(neededOffset, true)
                end
            else
                -- Свайп вправо → предыдущая вкладка
                if currentTab > 1 then
                    switchTab(currentTab - 1)
                    -- Автоскролл tabBar чтобы показать активную вкладку
                    local neededOffset = math.max(0, (currentTab - 5) * TAB_BUTTON_WIDTH)
                    neededOffset = math.clamp(neededOffset, 0, MAX_TAB_OFFSET)
                    updateTabPosition(neededOffset, true)
                end
            end
        end
    end
end)

