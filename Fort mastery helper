        setHelpStatus(5, "waiting")  -- особый статус ожидания
        helpInfos[5].Text = "⏳ Ждём стену Fort..."

        local detectedWall5 = nil
        local wallWaitAttempts = 0

        while helpMode and guiOpen and helpGeneration == myGen do
            wallWaitAttempts += 1

            local allWalls5 = {}
            pcall(function()
                for _, obj in ipairs(workspace:GetChildren()) do
                    if isTargetWall(obj) then
                        local ok, dist = pcall(function()
                            return (obj.Position - hrp.Position).Magnitude
                        end)
                        -- РАДИУС 500 СТУДОВ
                        if ok and dist <= 500 then
                            table.insert(allWalls5, {obj = obj, dist = dist})
                        end
                    end
                end
            end)

            table.sort(allWalls5, function(a, b) return a.dist < b.dist end)

            if #allWalls5 > 0 then
                detectedWall5 = allWalls5[1]
                helpInfos[5].Text = string.format("✅ Стена! %d шт. | %.1f ст.", #allWalls5, detectedWall5.dist)
                break
            end

            helpInfos[5].Text = string.format("⏳ Нет стены... (%d)", wallWaitAttempts)
            task.wait(HELP_CHECK_INTERVAL)
        end

        if not detectedWall5 then continue end
        setHelpStatus(5, "done")

        -- ТП к найденной стене (моментально после детекта)
        pcall(function()
            hrp.CFrame = CFrame.new(
                detectedWall5.obj.Position +
                Vector3.new(0, detectedWall5.obj.Size.Y / 2 + 3, 0)
            )
        end)

        if not helpMode or helpGeneration ~= myGen then break end

        -- ═══ ШАГ 6: ПЕРВОЕ ИСПОЛЬЗОВАНИЕ ZZZZ ═══
        helpCurrentStep = 6
        setHelpStatus(6, "active")
        helpInfos[6].Text = "⏳ Используем Zzzz #1..."

        local zzzOk1 = fireZzzzAbility()
        if zzzOk1 then
            helpInfos[6].Text = "✅ Zzzz #1 активирован"
            setHelpStatus(6, "done")
        else
            helpInfos[6].Text = "❌ Ошибка Zzzz #1"
            setHelpStatus(6, "error")
        end
        task.wait(HELP_DELAY_ABILITY1)
        if not helpMode or helpGeneration ~= myGen then break end

        -- ═══ ШАГ 7: ЖДАТЬ 2 СЕК + ВТОРОЕ ИСПОЛЬЗОВАНИЕ ZZZZ ═══
        helpCurrentStep = 7
        setHelpStatus(7, "active")

        -- Отсчёт 2 секунд с отображением
        for countdown = 2, 1, -1 do
            helpInfos[7].Text = string.format("⏳ Ждём %d сек...", countdown)
            task.wait(1)
            if not helpMode or helpGeneration ~= myGen then break end
        end
        if not helpMode or helpGeneration ~= myGen then break end

        helpInfos[7].Text = "⏳ Используем Zzzz #2..."
        local zzzOk2 = fireZzzzAbility()
        if zzzOk2 then
            helpInfos[7].Text = "✅ Zzzz #2 активирован"
            setHelpStatus(7, "done")
        else
            helpInfos[7].Text = "❌ Ошибка Zzzz #2"
            setHelpStatus(7, "error")
        end
        task.wait(HELP_DELAY_ABILITY2)
        if not helpMode or helpGeneration ~= myGen then break end

        -- ═══ ШАГ 8: ТП НА КООРДИНАТЫ -12385 ═══
        helpCurrentStep = 8
        setHelpStatus(8, "active")
        helpInfos[8].Text = "⏳ ТП..."

        pcall(function() hrp.CFrame = CFrame.new(ARENA_COORDS) end)
        task.wait(0.2)
        local ok8, p8 = pcall(function() return hrp.Position end)
        if ok8 then
            helpInfos[8].Text = string.format("✅ %.0f,%.0f,%.0f", p8.X, p8.Y, p8.Z)
        end
        setHelpStatus(8, "done")
        task.wait(HELP_DELAY_COORDS)
        if not helpMode or helpGeneration ~= myGen then break end

        -- ═══ ШАГ 9: ПЕРЕХОД К ПЕТЛЕ ═══
        helpCurrentStep = 9
        setHelpStatus(9, "active")
        helpCycleCount += 1
        helpCycleLabel.Text = "🔁 Полных циклов: " .. helpCycleCount
        helpInfos[9].Text = string.format("🔁 Цикл %d → Шаг 5", helpCycleCount)
        task.wait(0.3)
        setHelpStatus(9, "done")

        -- Сбросить карточки 5-8 для следующей итерации
        for i = 5, 8 do setHelpStatus(i, "idle"); helpInfos[i].Text = "" end
        setHelpStatus(9, "idle"); helpInfos[9].Text = ""

        -- helpPhase уже "loop" — следующая итерация пойдёт с шага 5
        task.wait(0.5)
    end

    -- Выход из цикла
    helpCurrentStep = 0
    helpPhase = "full"
    for i = 1, 9 do setHelpStatus(i, "idle"); helpInfos[i].Text = "" end
    updateHelpIndicator(false)
end

