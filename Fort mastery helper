local function createButton(parent, text, color, pos, size)
    local btn = Instance.new("TextButton")
    btn.Text = text
    btn.Size = size or UDim2.new(0, 96, 0, 20)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 9
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

    local origColor, origSize, origPos = color, btn.Size, pos
    local hoverColor = Color3.fromRGB(math.min(color.R*255+30,255), math.min(color.G*255+30,255), math.min(color.B*255+30,255))
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = hoverColor}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = origColor}):Play() end)
    btn.MouseButton1Down:Connect(function()
        btn.Size = UDim2.new(origSize.X.Scale, origSize.X.Offset-2, origSize.Y.Scale, origSize.Y.Offset-2)
        btn.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset+1, origPos.Y.Scale, origPos.Y.Offset+1)
    end)
    btn.MouseButton1Up:Connect(function() btn.Size = origSize; btn.Position = origPos end)
    return btn
end

