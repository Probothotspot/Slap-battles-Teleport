-- Основной цикл режима помощи
local function runHelpLoop(myGen)
    helpPhase = "full"  -- начинаем с полного цикла

    while helpMode and guiOpen and helpGeneration == myGen do

        -- ════════════════════════════════════════
        -- ПОЛНАЯ ФАЗА (шаги 1-4, только первый раз)
        -- ════════════════════════════════════════

        if helpPhase == "full" then
            -- Сброс всех 9 карточек
            for i = 1, 9 do setHelpStatus(i, "idle"); helpInfos[i].Text = "" end

            helpPhaseLabel.Text = "📋 Фаза: ПОЛНАЯ (1→9)"
            helpPhaseLabel.TextColor3 = Color3.fromRGB(200, 180, 255)

            -- ═══ ШАГ 1: ЭКИПИРОВКА ZZZZZZZ ═══
            helpCurrentStep = 1
            setHelpStatus(1, "active")
            helpInfos[1].Text = "⏳ Экипируем Zzzzz..."

            -- Переискать если потерян
            if not equipState.zzzObj or not equipState.zzzObj.Parent then
                equipState.zzzObj = findGloveObjFast(GLOVES[2])
            end

            local equip1Ok = equipGlove(GLOVES[2], equipState.zzzObj, helpStatusLabel, zzzEquipBtn)
            if equip1Ok then
                helpInfos[1].Text = "✅ Zzzzz экипирован"
                setHelpStatus(1, "done")
            else
                helpInfos[1].Text = "⚠ Экип не подтверждён"
                setHelpStatus(1, "error")
                -- Продолжаем несмотря на ошибку
            end
            task.wait(HELP_DELAY_EQUIP)
            if not helpMode or helpGeneration ~= myGen then break end

            -- ═══ ШАГ 2: ТП В ПОРТАЛ ═══
            helpCurrentStep = 2
            setHelpStatus(2, "active")
            helpInfos[2].Text = "🔍 Ищем портал..."

            local portal2 = findPortal()
            if not portal2 then
                setHelpStatus(2, "error")
                helpInfos[2].Text = "❌ Портал не найден"
                task.wait(HELP_CHECK_INTERVAL)
                continue
            end
            teleportTo(portal2)
            helpInfos[2].Text = "✅ ТП выполнен"
            setHelpStatus(2, "done")
            task.wait(HELP_DELAY_PORTAL)
            if not helpMode or helpGeneration ~= myGen then break end

            -- ═══ ШАГ 3: ПРОВЕРКА АРЕНЫ ═══
            helpCurrentStep = 3
            setHelpStatus(3, "active")
            helpInfos[3].Text = "⏳ Проверяем Y..."

            task.wait(HELP_DELAY_ARENA)

            local onArena3 = false
            local waitAttempts3 = 0
            while helpMode and guiOpen and helpGeneration == myGen do
                waitAttempts3 += 1
                local ok, y = pcall(function() return hrp.Position.Y end)
                if ok then
                    helpInfos[3].Text = string.format("Y: %.1f (%d)", y, waitAttempts3)
                    if y < ARENA_Y_THRESHOLD then
                        onArena3 = true
                        break
                    end
                end
                -- Повторить ТП если застряли в лобби
                if waitAttempts3 > 5 then
                    helpInfos[3].Text = "🔄 Повтор ТП..."
                    local pRetry = findPortal()
                    if pRetry then teleportTo(pRetry) end
                    waitAttempts3 = 0
                end
                task.wait(HELP_CHECK_INTERVAL)
            end
            if not onArena3 then continue end
            helpInfos[3].Text = "✅ На арене!"
            setHelpStatus(3, "done")
            if not helpMode or helpGeneration ~= myGen then break end

            -- ═══ ШАГ 4: ТП НА КООРДИНАТЫ -12385 ═══
            helpCurrentStep = 4
            setHelpStatus(4, "active")
            helpInfos[4].Text = "⏳ ТП..."

            pcall(function() hrp.CFrame = CFrame.new(ARENA_COORDS) end)
            task.wait(0.2)
            local ok4, p4 = pcall(function() return hrp.Position end)
            if ok4 then
                helpInfos[4].Text = string.format("✅ %.0f,%.0f,%.0f", p4.X, p4.Y, p4.Z)
            end
            setHelpStatus(4, "done")
            task.wait(HELP_DELAY_COORDS)
            if not helpMode or helpGeneration ~= myGen then break end

            -- Переходим в петлю
            helpPhase = "loop"
            helpPhaseLabel.Text = "🔁 Фаза: ПЕТЛЯ (5→9)"
            helpPhaseLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
        end

        -- ════════════════════════════════════════
        -- ПЕТЛЯ (шаги 5-9, повторяется)
        -- ════════════════════════════════════════

        -- ═══ ШАГ 5: ЖДЁМ СТЕНУ FORT (радиус 500 студов) ═══
