-- ═══ ФУНКЦИЯ ОПРЕДЕЛЕНИЯ СТЕНЫ FORT ═══
local function isTargetWall(obj)
    local ok, result = pcall(function()
        if not obj:IsA("BasePart") then return false end
        if obj.Parent ~= workspace then return false end
        if obj.Material ~= Enum.Material.Brick then return false end
        if obj.Anchored ~= true then return false end
        if obj.CanCollide ~= true then return false end
        if math.abs(obj.Color.R * 255 - 172) > 10 then return false end
        if math.abs(obj.Color.G * 255 - 73) > 10 then return false end
        if math.abs(obj.Color.B * 255 - 73) > 10 then return false end
        if math.abs(obj.Size.X - 15.0) > 0.5 then return false end
        if math.abs(obj.Size.Y - 17.0) > 0.5 then return false end
        if math.abs(obj.Size.Z - 1.2) > 0.5 then return false end
        if #obj:GetChildren() ~= 5 then return false end
        return true
    end)
    return ok and result
end

-- ═══ ПОИСК СТЕНЫ ═══
local function findWall()
    local walls = {}
    pcall(function()
        for _, obj in ipairs(workspace:GetChildren()) do
            if isTargetWall(obj) then table.insert(walls, obj) end
        end
    end)
    wallCount = #walls
    return walls[1]
end

local function findWallsNearTarget()
    if not selectedTarget then return {} end
    local walls = {}
    pcall(function()
        local targetChar = selectedTarget.Character
        if not targetChar then return end
        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetHRP then return end
        for _, obj in ipairs(workspace:GetChildren()) do
            if isTargetWall(obj) then
                local dist = (obj.Position - targetHRP.Position).Magnitude
                if dist <= SCAN_RADIUS then table.insert(walls, {obj = obj, dist = dist}) end
            end
        end
        table.sort(walls, function(a, b) return a.dist < b.dist end)
    end)
    return walls
end

local function smartFindWall()
    if selectedTarget then
        local walls = findWallsNearTarget()
        wallCount = #walls
        return walls[1] and walls[1].obj
    end
    return findWall()
end

local function findNearestWallToPlayer()
    local allWalls = {}
    pcall(function()
        for _, obj in ipairs(workspace:GetChildren()) do
            if isTargetWall(obj) then
                local ok, dist = pcall(function() return (obj.Position - hrp.Position).Magnitude end)
                if ok then table.insert(allWalls, {obj = obj, dist = dist}) end
            end
        end
    end)
    table.sort(allWalls, function(a, b) return a.dist < b.dist end)
    return allWalls
end

