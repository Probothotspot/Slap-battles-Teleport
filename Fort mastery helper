-- ═══ ПОИСК ОБЪЕКТА ПЕРЧАТКИ ═══
local function findGloveObj(cfg)
    -- Способ 1: прямой путь
    local ok1, obj1 = pcall(function()
        local lobby = workspace:WaitForChild("Lobby", 3)
        if lobby then return lobby:WaitForChild(cfg.searchName, 3) end
        return nil
    end)
    if ok1 and obj1 then return obj1 end

    -- Способ 2: поиск по координатам
    local ok2, obj2 = pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == cfg.searchName and obj:IsA("MeshPart") then
                if math.abs(obj.Position.X - cfg.expectedPos.X) < 2
                and math.abs(obj.Position.Y - cfg.expectedPos.Y) < 2
                and math.abs(obj.Position.Z - cfg.expectedPos.Z) < 2 then
                    return obj
                end
            end
        end
        return nil
    end)
    return ok2 and obj2
end

-- ═══ ОПРЕДЕЛЕНИЕ МЕТОДА ЭКИПИРОВКИ (ИСПРАВЛЕНО) ═══
local function detectGloveMethod(obj)
    if not obj then return "Unknown", nil end

    local okCd, cd = pcall(function()
        return obj:FindFirstChildOfClass("ClickDetector")
    end)
    if okCd and cd then return "ClickDetector", cd end

    local okPp, pp = pcall(function()
        return obj:FindFirstChildOfClass("ProximityPrompt")
    end)
    if okPp and pp then return "ProximityPrompt", pp end

    return "Touched", nil
end

