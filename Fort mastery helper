-- equipGlove возвращает true/false для использования в runAutoLoop
local function equipGlove(cfg, gloveRef, statusLbl, equipBtn)
    -- Проверка и переиск объекта если невалиден
    if not gloveRef or not gloveRef.Parent then
        gloveRef = findGloveObjFast(cfg)
        -- Обновить equipState
        if cfg.name == "Fort" then
            equipState.fortObj = gloveRef
        elseif cfg.name == "ZZZZZZZ" then
            equipState.zzzObj = gloveRef
        end
        if not gloveRef then
            pcall(function() statusLbl.Text = "❌ " .. cfg.name .. ": не найден"; statusLbl.TextColor3 = COLORS.red end)
            addEquipLog(cfg.name .. " → ❌ не найден")
            return false
        end
    end

    -- Метод 1: ClickDetector
    local ok1, cd = pcall(function() return gloveRef:FindFirstChildOfClass("ClickDetector") end)
    if ok1 and cd then
        local fireOk = pcall(function() fireclickdetector(cd) end)
        if fireOk then
            pcall(function()
                statusLbl.Text = "✅ " .. cfg.name .. ": ClickDetector"
                statusLbl.TextColor3 = COLORS.green
                TweenService:Create(equipBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 160, 40)}):Play()
                task.delay(0.5, function() TweenService:Create(equipBtn, TweenInfo.new(0.2), {BackgroundColor3 = cfg.btnColor}):Play() end)
            end)
            addEquipLog(cfg.name .. " → ✅ ClickDetector")
            return true
        end
    end

    -- Метод 2: ProximityPrompt
    local ok2, pp = pcall(function() return gloveRef:FindFirstChildOfClass("ProximityPrompt") end)
    if ok2 and pp then
        local fireOk = pcall(function() fireproximityprompt(pp) end)
        if fireOk then
            pcall(function()
                statusLbl.Text = "✅ " .. cfg.name .. ": ProximityPrompt"
                statusLbl.TextColor3 = COLORS.green
                TweenService:Create(equipBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 160, 40)}):Play()
                task.delay(0.5, function() TweenService:Create(equipBtn, TweenInfo.new(0.2), {BackgroundColor3 = cfg.btnColor}):Play() end)
            end)
            addEquipLog(cfg.name .. " → ✅ ProximityPrompt")
            return true
        end
    end

    -- Метод 3: ТП к объекту
    local ok3 = pcall(function() hrp.CFrame = CFrame.new(gloveRef.Position + Vector3.new(0, gloveRef.Size.Y/2 + 2, 0)) end)
    if ok3 then
        task.wait(0.3)
        pcall(function()
            statusLbl.Text = "✅ " .. cfg.name .. ": ТП"
            statusLbl.TextColor3 = COLORS.green
            TweenService:Create(equipBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 160, 40)}):Play()
            task.delay(0.5, function() TweenService:Create(equipBtn, TweenInfo.new(0.2), {BackgroundColor3 = cfg.btnColor}):Play() end)
        end)
        addEquipLog(cfg.name .. " → ✅ ТП")
        return true
    end

    -- Все методы провалились
    pcall(function() statusLbl.Text = "❌ " .. cfg.name .. ": все методы провалены"; statusLbl.TextColor3 = COLORS.red end)
    addEquipLog(cfg.name .. " → ❌ все методы")
    return false
end

