-- ==================== НАСТРОЙКИ ====================
local Settings = {
    Enabled = false,
    FlySpeed = 250,                -- студий/сек
    StartX = -51.6,
    StartZ = 1645.6,
    FixedY = 65,                  -- высота полёта
    EndZ = 8450,
    LobbyZThreshold = -500,       -- Z меньше этого → телепорт в старт
    CurrentStage = "Ожидание",
    StopRequested = false,
    FlightProgress = 0,
    FlightStartZ = 0,
    FlightTargetZ = 0,
}

-- ==================== ЛОГ ====================
local LogLines = {}
local function AddLog(msg)
    local fullMsg = os.date("%X") .. " - " .. msg
    table.insert(LogLines, fullMsg)
    if #LogLines > 30 then table.remove(LogLines, 1) end
    if _G.LogLabel then
        pcall(function() _G.LogLabel.Text = table.concat(LogLines, "\n") end)
    end
    print("[FlyFarm] " .. msg)
end

-- ==================== ПОЛУЧЕНИЕ КОРНЕВОЙ ЧАСТИ ====================
local function GetCharacterRoot()
    local char = LP.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
end

-- ==================== РЕСПАВН ====================
local function RespawnCharacter()
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then hum.Health = 0 else char:BreakJoints() end
    end
    local waited = 0
    while not GetCharacterRoot() do
        if waited > 15 then
            AddLog("Ошибка: персонаж не появился после респавна")
            return false
        end
        task.wait(0.5)
        waited = waited + 0.5
    end
    task.wait(2)  -- даём время на загрузку
    AddLog("Респавн выполнен")
    return true
end

-- ==================== ТЕЛЕПОРТ В СТАРТ ====================
local function TeleportToStart()
    local root = GetCharacterRoot()
    if not root then return false end
    root.CFrame = CFrame.new(Settings.StartX, Settings.FixedY, Settings.StartZ)
    AddLog("ТП в старт (Y=" .. Settings.FixedY .. ")")
    return true
end

-- ==================== СТАБИЛЬНЫЙ ПОЛЁТ (Heartbeat, Y фиксирован) ====================
local function FlyToEnd()
    local root = GetCharacterRoot()
    if not root then return false end

    local startX = root.Position.X
    local startZ = root.Position.Z
    local targetZ = Settings.EndZ
    local distance = math.abs(targetZ - startZ)
    if distance < 1 then return true end

    local speed = Settings.FlySpeed
    local duration = distance / speed
    local startTime = tick()

    Settings.FlightStartZ = startZ
    Settings.FlightTargetZ = targetZ
    Settings.FlightProgress = 0
    Settings.CurrentStage = "Полёт"
    AddLog(string.format("Полёт до Z=%.1f (%.1f сек)", targetZ, duration))

    local finished = false
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not Settings.Enabled or Settings.StopRequested then
            connection:Disconnect()
            return
        end
        local rootNow = GetCharacterRoot()
        if not rootNow then
            connection:Disconnect()
            AddLog("Потерян персонаж – прерывание")
            return
        end
        local elapsed = tick() - startTime
        local progress = math.min(elapsed / duration, 1)
        local currentZ = startZ + (targetZ - startZ) * progress
        rootNow.CFrame = CFrame.new(startX, Settings.FixedY, currentZ)
        Settings.FlightProgress = progress
        if progress >= 1 then
            finished = true
            connection:Disconnect()
        end
    end)

    -- Ждём завершения полёта
    while not finished do
        if not Settings.Enabled or Settings.StopRequested then
            connection:Disconnect()
            return false
        end
        if not GetCharacterRoot() then
            connection:Disconnect()
            AddLog("Персонаж исчез – прерывание полёта")
            return false
        end
        task.wait(0.1)
    end

    Settings.FlightProgress = 1
    AddLog("Полёт успешно завершён")
    return true
end

-- ==================== ГЛАВНЫЙ ЦИКЛ ====================
local function MainLoop()
    AddLog("Главный цикл запущен")
    while Settings.Enabled and not Settings.StopRequested do
        pcall(function()
            -- Ждём персонажа
            while Settings.Enabled and not GetCharacterRoot() do
                Settings.CurrentStage = "Ожидание персонажа"
                task.wait(0.5)
            end
            if not Settings.Enabled then return end

            -- Если в лобби – телепорт в старт
            local root = GetCharacterRoot()
            if root and root.Position.Z < Settings.LobbyZThreshold then
                Settings.CurrentStage = "Телепорт в старт (лобби)"
                TeleportToStart()
                task.wait(0.5)
            end

            -- Полёт
            local flySuccess = FlyToEnd()
            if not flySuccess then
                AddLog("Полёт не удался, пауза 1 сек")
                task.wait(1)
                return
            end

            -- Ресет только после успешного завершения полёта
            Settings.CurrentStage = "Ресет"
            if not RespawnCharacter() then
                AddLog("Ресет не удался, пауза 3 сек")
                task.wait(3)
            end
            task.wait(1)
        end)
    end
    Settings.Enabled = false
    _G.FlyFarmRunning = false
    AddLog("Фарм остановлен")
end

