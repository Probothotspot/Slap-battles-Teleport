    if collapseTween then collapseTween:Cancel() end
    if isCollapsed then
        mainFrame.ClipsDescendants = false
        collapseTween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = MAIN_SIZE})
        collapseTween:Play()
        collapseTween.Completed:Connect(function()
            mainFrame.ClipsDescendants = true
            contentFrame.Visible = true
        end)
        contentFrame.Visible = true
        minimizeBtn.Text = "–"
        isCollapsed = false
    else
        contentFrame.Visible = false
        mainFrame.ClipsDescendants = true
        collapseTween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(MAIN_SIZE.X.Scale, MAIN_SIZE.X.Offset, 0, MINIMIZED_HEIGHT)})
        collapseTween:Play()
        minimizeBtn.Text = "+"
        isCollapsed = true
    end
end)
 
