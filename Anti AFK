-- Применение темы
function applyTheme()
    local theme = themes[currentThemeName]
    mainFrame.BackgroundColor3 = theme.Background
    mainGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, theme.Gradient1),
        ColorSequenceKeypoint.new(1, theme.Gradient2),
    })
    titleBar.BackgroundColor3 = theme.TitleBar
    titleText.TextColor3 = theme.TextColor
    statusLabel.TextColor3 = theme.TextColor
    authorLabel.TextColor3 = theme.TextColor
    settingsBtn.BackgroundColor3 = theme.ButtonColor
    settingsBtn.TextColor3 = theme.ButtonText
    minimizeBtn.BackgroundColor3 = theme.ButtonColor
    minimizeBtn.TextColor3 = theme.ButtonText
    closeBtn.BackgroundColor3 = theme.ButtonColor
    closeBtn.TextColor3 = theme.ButtonText
    if settingsFrame.Visible then
        applyThemeToSettingsFrame()
    end
end
 
function applyThemeToSettingsFrame()
    local theme = themes[currentThemeName]
    settingsFrame.BackgroundColor3 = theme.Background
    setGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, theme.Gradient1),
        ColorSequenceKeypoint.new(1, theme.Gradient2),
    })
    settingsTitleBar.BackgroundColor3 = theme.TitleBar
    settingsTitleText.TextColor3 = theme.TextColor
    settingsCloseBtn.BackgroundColor3 = theme.ButtonColor
    settingsCloseBtn.TextColor3 = theme.ButtonText
    langLabel.TextColor3 = theme.TextColor
    themeLabel.TextColor3 = theme.TextColor
    themeScroll.BackgroundColor3 = theme.Background
    themeScroll.ScrollBarImageColor3 = theme.TextColor
    for _, btn in pairs(themeButtons) do
        btn.BackgroundColor3 = themes[btn.Name].ButtonColor
        btn.TextColor3 = themes[btn.Name].ButtonText
    end
    for l, b in pairs(langButtons) do
        b.BackgroundColor3 = l == currentLanguage and themes[currentThemeName].ButtonColor or themes[currentThemeName].Background
    end
end
 
-- Обновление языка
function updateLanguageUI()
    local lang = translations[currentLanguage]
    titleText.Text = lang.title
    statusLabel.Text = isEnabled and lang.status_on or lang.status_off
    toggleBtn.Text = isEnabled and lang.toggle_on or lang.toggle_off
    settingsBtn.Text = "⚙️ " .. lang.settings_title
    authorLabel.Text = lang.author
    settingsTitleText.Text = lang.settings_title
    langLabel.Text = lang.language_label
    themeLabel.Text = lang.theme_label
    for l, btn in pairs(langButtons) do
        btn.Text = lang["lang_"..l:lower()]
    end
    -- Обновить названия тем
    for name, btn in pairs(themeButtons) do
        btn.Text = lang.theme_names[name]
    end
end
 
