local function getSafeParent()
    if typeof(gethui) == "function" then
        local ok, res = pcall(gethui)
        if ok and res then return res end
    end
    return player:WaitForChild("PlayerGui", 10)
end

local parentGui = getSafeParent()

pcall(function()
    local old = parentGui:FindFirstChild("BabftLoaderNotification")
    if old then old:Destroy() end
    local pGuiOld = player.PlayerGui:FindFirstChild("BabftLoaderNotification")
    if pGuiOld then pGuiOld:Destroy() end
end)

