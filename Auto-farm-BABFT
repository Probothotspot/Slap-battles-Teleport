-- Функция обновления шкалы и текста
local function setStatus(msg, progressRatio, isError)
    statusText.Text = msg
    if isError then
        statusText.TextColor3 = Color3.fromRGB(255, 80, 90)
        icon.Text = "⚠"
    end
    TweenService:Create(barFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(math.clamp(progressRatio, 0, 1), 0, 1, 0)
    }):Play()
end

-- 3. Безопасный загрузчик файлов
local function fetchAndRun(url, logName)
    local fetchOk, code = pcall(function()
        return game:HttpGet(url .. "?t=" .. tostring(os.time()))
    end)

    if not fetchOk or not code or #code == 0 then
        setStatus("Ошибка сети: " .. logName, 0.5, true)
        warn(string.format("[BABFT Loader] Не удалось загрузить %s: %s", logName, tostring(code)))
        return false
    end

    if string.find(code, "404: Not Found") then
        setStatus("404 Файл не найден: " .. logName, 0.5, true)
        warn("[BABFT Loader] 404: Файл отсутствует на GitHub: " .. url)
        return false
    end

    local compileOk, runErr = pcall(function()
        local fn, err = loadstring(code)
        if not fn then error(err) end
        fn()
    end)

    if not compileOk then
        setStatus("Ошибка в коде: " .. logName, 0.5, true)
        warn(string.format("[BABFT Loader] Сбой выполнения %s: %s", logName, tostring(runErr)))
        return false
    end

    return true
end

