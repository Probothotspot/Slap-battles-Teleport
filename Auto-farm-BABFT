local function formatTime(seconds)
    local hrs = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    return string.format("%02d:%02d:%02d", hrs, mins, secs)
end

local function getGoldObject()
    if goldValObject and goldValObject.Parent then
        return goldValObject
    end
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Gold") then
        goldValObject = data.Gold
        return goldValObject
    end
    local ls = player:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Gold") then
        goldValObject = ls.Gold
        return goldValObject
    end
    return nil
end

local function getCurrentGold()
    local obj = getGoldObject()
    if obj then
        return tonumber(obj.Value) or 0
    end
    return 0
end

-- Динамический поиск предмета и извлечение реальной цены
local function searchItemInGame(query)
    query = string.lower(string.gsub(query, "%s+", ""))
    if query == "" then return nil, 0 end

    -- 1. Сверка с базой цен по видео
    for key, data in pairs(KNOWN_ITEMS) do
        local cleanKey = string.lower(string.gsub(key, "%s+", ""))
        if cleanKey == query or string.find(cleanKey, query) or string.find(query, cleanKey) then
            return data.name, data.price
        end
    end

    -- 2. Динамический поиск по Shop GUI с парсингом цены
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        local shop = pGui:FindFirstChild("Shop")
        if shop then
            for _, frame in ipairs(shop:GetDescendants()) do
                if frame:IsA("TextLabel") or frame:IsA("TextButton") then
                    local cleanText = string.lower(string.gsub(frame.Text, "%s+", ""))
                    if string.find(cleanText, query) then
                        -- Поиск ценника рядом в том же контейнере
                        local parent = frame.Parent
                        if parent then
                            for _, child in ipairs(parent:GetDescendants()) do
                                if child:IsA("TextLabel") and string.find(string.lower(child.Text), "gold") then
                                    local parsedPrice = tonumber(string.match(child.Text, "(%d+)"))
                                    if parsedPrice and parsedPrice > 0 then
                                        return frame.Text, parsedPrice
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- 3. Проверка ReplicatedStorage
    for _, item in ipairs(ReplicatedStorage:GetDescendants()) do
        local cleanName = string.lower(string.gsub(item.Name, "%s+", ""))
        if cleanName == query then
            return item.Name, 0
        end
    end

    return nil, 0
end

local function checkAndAutoBuy()
    if not autoBuyActive or targetItemRealName == "" or targetItemPrice <= 0 then return end
    local totalCost = targetItemPrice * buyAmount
    local currentGold = getCurrentGold()

    if currentGold >= totalCost then
        local buyRemote = Workspace:FindFirstChild("ItemBoughtFromShop")
        if buyRemote then
            pcall(function()
                buyRemote:InvokeServer(targetItemRealName, buyAmount)
            end)
        end
    end
end

