-- 3. Функция скачивания и выполнения модулей
local function executeScript(url, logName)
    local fetchSuccess, code = pcall(function()
        return game:HttpGet(url .. "?t=" .. tostring(os.time()))
    end)

    if not fetchSuccess or not code or #code == 0 then
        warn(string.format("[BABFT Loader] Ошибка скачивания [%s]: %s", logName, tostring(code)))
        return false
    end

    local loadSuccess, runError = pcall(function()
        local func, compileErr = loadstring(code)
        if not func then error("Ошибка компиляции: " .. tostring(compileErr)) end
        func()
    end)

    if not loadSuccess then
        warn(string.format("[BABFT Loader] Ошибка выполнения [%s]: %s", logName, tostring(runError)))
        return false
    end

    return true
end

