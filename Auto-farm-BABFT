-- Плавное вращение персонажа
local function setSpin(hrp, enabled)
    if not hrp then return end
    local spin = hrp:FindFirstChild("FarmSpin")
    if enabled then
        if not spin then
            spin = Instance.new("BodyAngularVelocity")
            spin.Name = "FarmSpin"
            spin.MaxTorque = Vector3.new(0, 4e5, 0)
            spin.AngularVelocity = Vector3.new(0, 2.5, 0)
            spin.Parent = hrp
        end
    else
        if spin then
            spin:Destroy()
        end
    end
end

-- Поиск живого персонажа и HRP
local function getCurrentHRP()
    local char = player.Character
    if char and char.Parent then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            return hrp, char, hum
        end
    end
    return nil, nil, nil
end

-- Перемещение игрока на платформу
local function placeOnPlatform(targetPos, hrp)
    platform.Position = targetPos - Vector3.new(0, 3.1, 0)
    platform.Parent = Workspace
    
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(targetPos)
    setSpin(hrp, true)
end

