local function syncTelegramOffset()
    if httpRequest and tgToken ~= "" then
        pcall(function()
            local res = httpRequest({
                Url = "https://api.telegram.org/bot" .. tgToken .. "/getUpdates?offset=-1",
                Method = "GET"
            })
            if res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data and data.ok and data.result and #data.result > 0 then
                    lastUpdateId = data.result[#data.result].update_id
                    httpRequest({
                        Url = "https://api.telegram.org/bot" .. tgToken .. "/getUpdates?offset=" .. tostring(lastUpdateId + 1) .. "&limit=1",
                        Method = "GET"
                    })
                end
            end
        end)
    end
end

