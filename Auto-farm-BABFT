local function updateGoldStats()
    local current = getCurrentGold()
    if farming then
        local delta = current - previousGold
        if delta > 0 then
            totalEarned = totalEarned + delta
        end
        previousGold = current
        startAndCurrentGoldLabel.Text = "Старт: " .. tostring(startGold) .. "  |  Сейчас: " .. tostring(current)
        goldTrackerLabel.Text = "Заработано: +" .. tostring(totalEarned) .. " Gold"
    else
        previousGold = current
        startAndCurrentGoldLabel.Text = "Старт: 0  |  Сейчас: " .. tostring(current)
    end
    checkAndAutoBuy()
end

