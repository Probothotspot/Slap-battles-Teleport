local function loadConfig()
    if isfile and readfile and isfile(CONFIG_FILE) then
        pcall(function()
            local content = readfile(CONFIG_FILE)
            local data = HttpService:JSONDecode(content)
            if data and type(data) == "table" then
                if data.farmMode then
                    farmMode = data.farmMode
                    if farmMode == "Chest" then
                        chestModeBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
                        chestModeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        goldModeBtn.BackgroundColor3 = Color3.fromRGB(35, 28, 45)
                        goldModeBtn.TextColor3 = Color3.fromRGB(160, 145, 185)
                    else
                        goldModeBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
                        goldModeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        chestModeBtn.BackgroundColor3 = Color3.fromRGB(35, 28, 45)
                        chestModeBtn.TextColor3 = Color3.fromRGB(160, 145, 185)
                    end
                end
                if data.chestDelay then
                    chestDelay = tonumber(data.chestDelay) or 2
                    delayBox.Text = tostring(chestDelay)
                end
                if data.buyAmount then
                    buyAmount = tonumber(data.buyAmount) or 1
                    amountBox.Text = tostring(buyAmount)
                end
                if data.targetItem then
                    itemInputBox.Text = data.targetItem
                    local rName, price = searchItemInGame(data.targetItem)
                    if rName and price > 0 then
                        targetItemRealName = rName
                        targetItemPrice = price
                        itemStatusLabel.Text = "Блок найден: " .. rName .. " (" .. tostring(price) .. " Gold)"
                        itemStatusLabel.TextColor3 = Color3.fromRGB(80, 240, 130)
                    end
                end
                if data.tgToken then
                    tgToken = data.tgToken
                    tgTokenInputBox.Text = tgToken
                end
                if data.tgChatId then
                    tgChatId = data.tgChatId
                    tgChatIdInputBox.Text = tgChatId
                end
                if data.autoBuyActive then
                    autoBuyActive = data.autoBuyActive
                    if autoBuyActive then
                        autoBuyToggleBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
                        autoBuyToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        autoBuyToggleBtn.Text = "Авто-закупка: ВКЛ"
                    end
                end

                -- Автоматический старт, если был перезаход
                if data.autoStart then
                    autoStartOnJoin = true
                    task.spawn(function()
                        repeat task.wait(0.5) until game:IsLoaded()
                        local hrp = getCurrentHRP()
                        while not hrp do
                            task.wait(0.5)
                            hrp = getCurrentHRP()
                        end
                        task.wait(1.5)
                        if not farming then
                            startFarming()
                            sendTelegramMessage("✅ <b>Успешный перезаход! Фарм автоматически продолжен.</b>")
                        end
                    end)
                end
            end
        end)
    end
end

