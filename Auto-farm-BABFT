local dragging, dragStart, startPos
topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

local function setNoclip(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part ~= platform then
            part.CanCollide = false
        end
    end
end

local function startFarmingLoop()
    farmThread = task.spawn(function()
        while farming do
            local hrp, char, hum = getCurrentHRP()
            while farming and not hrp do
                task.wait(0.2)
                hrp, char, hum = getCurrentHRP()
            end
            if not farming then break end

            local resetToFirstStage = false

            if farmMode == "Chest" then
                for index = 1, 2 do
                    if not farming then break end
                    hrp, char, hum = getCurrentHRP()
                    if not hrp then resetToFirstStage = true break end

                    statusLabel.Text = "Зона " .. index .. "/10"
                    setNoclip(char)
                    placeOnPlatform(STAGE_COORDINATES[index], hrp)

                    local stageStart = tick()
                    while tick() - stageStart < 1.5 do
                        task.wait(0.05)
                        if not farming then break end
                        local curHrp = getCurrentHRP()
                        if not curHrp or (index > 1 and curHrp.Position.Z < SPAWN_Z_MAX) then
                            resetToFirstStage = true
                            break
                        end
                    end
                    if resetToFirstStage then break end
                end

                if resetToFirstStage or not farming then
                    platform.Parent = nil
                    task.wait(0.5)
                    continue
                end

                hrp, char, hum = getCurrentHRP()
                if hrp then
                    statusLabel.Text = "Сундук (" .. tostring(chestDelay) .. " сек)..."
                    setNoclip(char)
                    placeOnPlatform(CHEST_POSITION, hrp)

                    local chestStart = tick()
                    while tick() - chestStart < chestDelay do
                        task.wait(0.1)
                        if not farming then break end
                        local curHrp = getCurrentHRP()
                        if not curHrp or curHrp.Position.Z < SPAWN_Z_MAX then
                            resetToFirstStage = true
                            break
                        end
                    end
                end

                if resetToFirstStage or not farming then
                    platform.Parent = nil
                    task.wait(0.5)
                    continue
                end

                hrp, char, hum = getCurrentHRP()
                if hrp then
                    statusLabel.Text = "Возврат на зону 2..."
                    setNoclip(char)
                    placeOnPlatform(STAGE_COORDINATES[2], hrp)
                    task.wait(1.5)
                end

                for index = 3, 10 do
                    if not farming then break end
                    hrp, char, hum = getCurrentHRP()
                    if not hrp then resetToFirstStage = true break end

                    statusLabel.Text = "Зона " .. index .. "/10"
                    setNoclip(char)
                    placeOnPlatform(STAGE_COORDINATES[index], hrp)

                    local stageStart = tick()
                    while tick() - stageStart < 1.5 do
                        task.wait(0.05)
                        if not farming then break end
                        local curHrp = getCurrentHRP()
                        if not curHrp or curHrp.Position.Z < SPAWN_Z_MAX then
                            resetToFirstStage = true
                            break
                        end
                    end
                    if resetToFirstStage then break end
                end

                if resetToFirstStage or not farming then
                    platform.Parent = nil
                    task.wait(0.5)
                    continue
                end

                statusLabel.Text = "10 этап: ожидание спавна..."
                while farming do
                    task.wait(0.1)
                    local curHrp = getCurrentHRP()
                    if curHrp and curHrp.Position.Z < SPAWN_Z_MAX then
                        break
                    end
                end

                checkAndAutoBuy()
                platform.Parent = nil
                task.wait(0.8)

            elseif farmMode == "Gold" then
                for index, coord in ipairs(STAGE_COORDINATES) do
                    if not farming then break end
                    hrp, char, hum = getCurrentHRP()
                    if not hrp then resetToFirstStage = true break end

                    statusLabel.Text = "Зона " .. index .. "/10"
                    setNoclip(char)
                    placeOnPlatform(coord, hrp)

                    local stageStart = tick()
                    while tick() - stageStart < 1.5 do
                        task.wait(0.05)
                        if not farming then break end
                        local curHrp = getCurrentHRP()
                        if not curHrp or curHrp.Position.Z < SPAWN_Z_MAX then
                            resetToFirstStage = true
                            break
                        end
                    end
                    if resetToFirstStage then break end
                end

                if resetToFirstStage or not farming then
                    platform.Parent = nil
                    task.wait(0.5)
                    continue
                end

                hrp, char, hum = getCurrentHRP()
                if hum then
                    statusLabel.Text = "10 этап: сброс..."
                    platform.Parent = nil
                    hum.Health = 0

                    statusLabel.Text = "Возрождение на спавне..."
                    while farming do
                        task.wait(0.1)
                        local curHrp = getCurrentHRP()
                        if curHrp and curHrp.Position.Z < SPAWN_Z_MAX then
                            break
                        end
                    end
                    checkAndAutoBuy()
                    task.wait(0.8)
                end
            end
        end
    end)
end

toggleButton.MouseButton1Click:Connect(function()
    farming = not farming

    if farming then
        startGold = getCurrentGold()
        updateGoldStats()

        startTime = os.time()
        timeTrackerLabel.Text = "Время фарма: 00:00:00"

        timerThread = task.spawn(function()
            while farming do
                local elapsed = os.time() - startTime
                timeTrackerLabel.Text = "Время фарма: " .. formatTime(elapsed)
                task.wait(1)
            end
        end)

        toggleButton.Text = "STOP AUTO FARM"
        toggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 70)
        statusLabel.Text = "Запуск: " .. (farmMode == "Chest" and "Сундук" or "Золото")
        startFarmingLoop()
    else
        toggleButton.Text = "START AUTO FARM"
        toggleButton.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
        statusLabel.Text = "Статус: Остановлен"
        
        if timerThread then
            task.cancel(timerThread)
            timerThread = nil
        end

        local hrp = getCurrentHRP()
        if hrp then
            setSpin(hrp, false)
        end
        platform.Parent = nil
        if farmThread then
            task.cancel(farmThread)
            farmThread = nil
        end
    end
end)
