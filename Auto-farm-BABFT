repeat task.wait(0.2) until game:IsLoaded()

local function executeScript(url, name)
    print(string.format("[BABFT Loader] Загрузка: %s...", name))
    
    local fetchSuccess, code = pcall(function()
        return game:HttpGet(url .. "?t=" .. tostring(os.time()))
    end)

    if not fetchSuccess or not code or #code == 0 then
        warn(string.format("[BABFT Loader] Ошибка скачивания [%s]: %s", name, tostring(code)))
        return false
    end

    local loadSuccess, runError = pcall(function()
        local func, compileErr = loadstring(code)
        if not func then error("Ошибка компиляции: " .. tostring(compileErr)) end
        func()
    end)

    if not loadSuccess then
        warn(string.format("[BABFT Loader] Ошибка выполнения [%s]: %s", name, tostring(runError)))
        return false
    end

    print(string.format("[BABFT Loader] [%s] успешно активирован!", name))
    return true
end

local BASE = "https://raw.githubusercontent.com/Probothotspot/Slap-battles-Teleport/main/"

-- Строгая последовательность сборки
if executeScript(BASE .. "Auto-farm-BABFT-Main.lua", "1. Main Logic") then
    task.wait(0.1)
    if executeScript(BASE .. "Auto-farm-BABFT-Data.lua", "2. Data & Network") then
        task.wait(0.1)
        if executeScript(BASE .. "Auto-Farm-BABFT-GUI.lua", "3. GUI Interface") then
            task.wait(0.1)
            executeScript(BASE .. "Auto-Farm-BABFT-Space.lua", "4. Space FX")
            task.wait(0.1)
            executeScript(BASE .. "Auto-Farm-BABFT-Cart.lua", "5. Shopping Cart")
            
            -- Финальная загрузка сохраненного конфига
            if _G.BABFT and _G.BABFT.loadConfig then
                _G.BABFT.loadConfig()
            end
        end
    end
end
