    lastAntiLagRun = os.clock()

    task.spawn(function()
        pcall(function()
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") and not v:IsDescendantOf(player.Character) and v.Name ~= "FarmPlatform" then
                    v.Material = Enum.Material.SmoothPlastic
                    v.CastShadow = false
                elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
                    if not v:IsDescendantOf(player.Character) then
                        v:Destroy()
                    end
                end
            end
        end)
    end)
end

-- Защита от воды с кэшированием
local cachedHazards = {}
local hazardConnection = nil

local function refreshHazardCache()
    table.clear(cachedHazards)
    local stages = Workspace:FindFirstChild("BoatStages")
    if stages then
        for _, v in ipairs(stages:GetDescendants()) do
            if v:IsA("BasePart") then
                local name = v.Name:lower()
                if name:find("water") or name:find("lava") or name:find("kill") or name:find("damage") then
                    table.insert(cachedHazards, v)
                end
            end
        end
    end
end

applyAntiHazard = function(state)
    for i = #cachedHazards, 1, -1 do
        local part = cachedHazards[i]
        if part and part.Parent then
            part.CanTouch = not state
        else
            table.remove(cachedHazards, i)
        end
    end
end

toggleAntiHazard = function(enabled)
    antiHazardActive = enabled
    if antiHazardActive then
        refreshHazardCache()
        applyAntiHazard(true)
        if not hazardConnection then
            hazardConnection = Workspace.DescendantAdded:Connect(function(v)
                if antiHazardActive and v:IsA("BasePart") then
                    local name = v.Name:lower()
                    if name:find("water") or name:find("lava") or name:find("kill") or name:find("damage") then
                        table.insert(cachedHazards, v)
                        v.CanTouch = false
                    end
                end
            end)
        end
    else
        if hazardConnection then
            hazardConnection:Disconnect()
            hazardConnection = nil
        end
        applyAntiHazard(false)
    end
end

