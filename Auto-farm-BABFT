-- Функция сохранения конфига с поддержкой autoStart
saveConfig = function(customAutoStart)
    tgToken = tgTokenInputBox.Text
    tgChatId = tgChatIdInputBox.Text
    local valDelay = tonumber(delayBox.Text)
    if valDelay and valDelay > 0 then chestDelay = valDelay end
    local valAmt = tonumber(amountBox.Text)
    if valAmt and valAmt > 0 then buyAmount = math.floor(valAmt) end

    local shouldAutoStart = autoStartOnJoin
    if customAutoStart ~= nil then
        shouldAutoStart = customAutoStart
    end

    local data = {
        farmMode = farmMode,
        chestDelay = chestDelay,
        autoBuyActive = autoBuyActive,
        buyAmount = buyAmount,
        targetItem = itemInputBox.Text,
        tgToken = tgToken,
        tgChatId = tgChatId,
        autoStart = shouldAutoStart
    }

    if writefile then
        pcall(function()
            writefile(CONFIG_FILE, HttpService:JSONEncode(data))
        end)
    end
end

-- Функция безопасного перезахода с авто-стартом
executeRejoin = function()
    sendTelegramMessage("🔄 <b>Перезахожу на сервер... Фарм продолжится автоматически!</b>")
    saveConfig(true)

    if queue_on_teleport then
        pcall(function()
            queue_on_teleport([[
                repeat task.wait() until game:IsLoaded()
                if isfile and isfile("babft_farm.lua") then
                    loadstring(readfile("babft_farm.lua"))()
                end
            ]])
        end)
    end

    task.wait(0.5)
    if #Players:GetPlayers() <= 1 then
        TeleportService:Teleport(game.PlaceId, player)
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
    end
end

