tgPollingThread = task.spawn(function()
    task.wait(2)
    syncTelegramOffset()

    while true do
        task.wait(3)
        if httpRequest and tgToken ~= "" and tgChatId ~= "" and not isRejoining then
            pcall(function()
                local pollUrl = "https://api.telegram.org/bot" .. tgToken .. "/getUpdates?offset=" .. tostring(lastUpdateId + 1) .. "&limit=5"
                local res = httpRequest({ Url = pollUrl, Method = "GET" })

                if res and res.Body then
                    local data = HttpService:JSONDecode(res.Body)
                    if data and data.ok and data.result then
                        for _, update in ipairs(data.result) do
                            lastUpdateId = update.update_id
                            local msg = update.message
                            if msg and tostring(msg.chat.id) == tostring(tgChatId) and msg.text then
                                local fullText = msg.text
                                local parts = string.split(fullText, " ")
                                local cmd = string.lower(parts[1] or "")

                                if cmd == "/stop" then
                                    if farming then
                                        stopFarming()
                                        sendTelegramMessage("🛑 <b>Фарм остановлен дистанционно!</b>")
                                    else
                                        sendTelegramMessage("⚠️ Фарм уже выключен.")
                                    end
                                elseif cmd == "/start" then
                                    if not farming then
                                        startFarming()
                                        sendTelegramMessage("🚀 <b>Фарм запущен дистанционно!</b>")
                                    else
                                        sendTelegramMessage("⚠️ Фарм уже работает.")
                                    end
                                elseif cmd == "/mode" then
                                    farmMode = (farmMode == "Chest" and "Gold" or "Chest")
                                    chestModeBtn.BackgroundColor3 = (farmMode == "Chest") and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(35, 28, 45)
                                    chestModeBtn.TextColor3 = (farmMode == "Chest") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 145, 185)
                                    goldModeBtn.BackgroundColor3 = (farmMode == "Gold") and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(35, 28, 45)
                                    goldModeBtn.TextColor3 = (farmMode == "Gold") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 145, 185)
                                    saveConfig()
                                    sendTelegramMessage("🔄 <b>Режим фарма переключен на:</b> " .. (farmMode == "Chest" and "Сундук" or "Золото"))
                                elseif cmd == "/afk" or cmd == "/screen" then
                                    toggleBlackScreen(not isBlackScreen)
                                    batterySaverBtn.BackgroundColor3 = isBlackScreen and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(35, 28, 45)
                                    batterySaverBtn.TextColor3 = isBlackScreen and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(175, 160, 205)
                                    batterySaverBtn.Text = isBlackScreen and "🔋 Ночной режим (Экран): ВКЛ" or "🔋 Ночной режим (Экран): ВЫКЛ"
                                    sendTelegramMessage("🔋 <b>Ночной режим энергосбережения:</b> " .. (isBlackScreen and "ВКЛЮЧЕН" or "ВЫКЛЮЧЕН"))
                                elseif cmd == "/lag" then
                                    antiLagActive = not antiLagActive
                                    antiLagBtn.BackgroundColor3 = antiLagActive and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(35, 28, 45)
                                    antiLagBtn.TextColor3 = antiLagActive and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(175, 160, 205)
                                    antiLagBtn.Text = antiLagActive and "⚡ Анти-лаг очистка: ВКЛ" or "⚡ Анти-лаг очистка: ВЫКЛ"
                                    if antiLagActive then applyAntiLag(true) end
                                    saveConfig()
                                    sendTelegramMessage("⚡ <b>Анти-лаг очистка:</b> " .. (antiLagActive and "ВКЛЮЧЕНА" or "ВЫКЛЮЧЕНА"))
                                elseif cmd == "/buy" then
                                    local itemArg = parts[2]
                                    local amountArg = tonumber(parts[3]) or 1
                                    if not itemArg then
                                        sendTelegramMessage("⚠️ Формат команды: <code>/buy [блок] [кол-во]</code>\nПример: <code>/buy лего 5</code>")
                                    else
                                        local success, resultMsg = executeBuy(itemArg, amountArg)
                                        if success then
                                            sendTelegramMessage("🛍 <b>" .. resultMsg .. "</b>")
                                            showAchievementToast("ПОКУПКА ИЗ TELEGRAM", resultMsg)
                                        else
                                            sendTelegramMessage("❌ <b>Ошибка:</b> " .. resultMsg)
                                        end
                                    end
                                elseif cmd == "/god" or cmd == "/water" then
                                    toggleAntiHazard(not antiHazardActive)
                                    antiHazardBtn.BackgroundColor3 = antiHazardActive and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(35, 28, 45)
                                    antiHazardBtn.TextColor3 = antiHazardActive and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(175, 160, 205)
                                    antiHazardBtn.Text = antiHazardActive and "🛡 Анти-урон / Вода: ВКЛ" or "🛡 Анти-урон / Вода: ВЫКЛ"
                                    saveConfig()
                                    sendTelegramMessage("🛡 <b>Защита от воды/урона:</b> " .. (antiHazardActive and "ВКЛ" or "ВЫКЛ"))
                                elseif cmd == "/kill" or cmd == "/shutdown" then
                                    saveConfig(false)
                                    sendTelegramMessage("💀 <b>Скрипт полностью остановлен и деактивирован!</b>\nАвто-старт и авто-перезаход отключены.")
                                    fullCleanup()
                                elseif cmd == "/status" then
                                    local currentG = getCurrentGold()
                                    local elapsed = farming and math.max(os.time() - startTime, 1) or 0
                                    local etaReportLine = ""
                                    if autoBuyActive and targetItemPrice > 0 and buyAmount > 0 then
                                        local targetTotal = targetItemPrice * buyAmount
                                        local needed = targetTotal - currentG
                                        if needed <= 0 then
                                            etaReportLine = "\n• Автопокупка: <b>Готово (хватает)</b>"
                                        elseif avgGoldPerMinute > 0 then
                                            local secondsNeeded = math.floor((needed / avgGoldPerMinute) * 60)
                                            etaReportLine = "\n• Автопокупка через: <b>" .. formatTime(secondsNeeded) .. "</b>"
                                        else
                                            etaReportLine = "\n• Автопокупка: <b>расчёт после 1 мин...</b>"
                                        end
                                    end

                                    local report = string.format(
                                        "📊 <b>Статистика BABFT:</b>\n\n" ..
                                        "• Состояние: <b>%s</b>\n" ..
                                        "• Режим: <b>%s</b>\n" ..
                                        "• Среднее: <b>%.1f Gold/мин</b>\n" ..
                                        "• Прогноз: <b>~%d Gold/час</b>%s\n" ..
                                        "• Анти-темнота: <b>%s</b>\n" ..
                                        "• Анти-вода/урон: <b>%s</b>\n" ..
                                        "• Анти-лаг: <b>%s</b>\n" ..
                                        "• Ночной экран: <b>%s</b>\n" ..
                                        "• Время сессии: <b>%s</b>\n" ..
                                        "• Баланс: <b>%d Gold</b>\n" ..
                                        "• Заработано: <b>+%d Gold</b>",
                                        farming and "🟢 Работает" or "🔴 Остановлен",
                                        farmMode == "Chest" and "Сундук" or "Золото",
                                        avgGoldPerMinute,
                                        estGoldPerHour,
                                        etaReportLine,
                                        antiDarknessActive and "ВКЛ" or "ВЫКЛ",
                                        antiHazardActive and "ВКЛ" or "ВЫКЛ",
                                        antiLagActive and "ВКЛ" or "ВЫКЛ",
                                        isBlackScreen and "ВКЛ" or "ВЫКЛ",
                                        formatTime(elapsed),
                                        currentG,
                                        totalEarned
                                    )
                                    sendTelegramMessage(report)
                                elseif cmd == "/rejoin" then
                                    executeRejoin()
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Загрузка сохраненного конфига
loadConfig()
