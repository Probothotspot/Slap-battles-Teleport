local function updateGoldStats()
    local current = getCurrentGold()
    if farming then
        local earned = math.max(0, current - startGold)
        startAndCurrentGoldLabel.Text = "Старт: " .. tostring(startGold) .. "  |  Сейчас: " .. tostring(current)
        goldTrackerLabel.Text = "Заработано: +" .. tostring(earned) .. " Gold"
    else
        startAndCurrentGoldLabel.Text = "Старт: 0  |  Сейчас: " .. tostring(current)
    end
    checkAndAutoBuy()
end

task.spawn(function()
    local obj = getGoldObject()
    while not obj do
        task.wait(1)
        obj = getGoldObject()
    end
    updateGoldStats()
    obj.Changed:Connect(function()
        updateGoldStats()
    end)
end)

