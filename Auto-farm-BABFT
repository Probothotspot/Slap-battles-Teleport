repeat task.wait(0.2) until game:IsLoaded()

local function executeScript(url, name)
    print(string.format("[BABFT Loader] Загрузка: %s...", name))
    
    local fetchSuccess, code = pcall(function()
        -- Добавляем метку времени (?t=), чтобы GitHub не отдавал старый закэшированный код
        return game:HttpGet(url .. "?t=" .. tostring(os.time()))
    end)

    if not fetchSuccess or not code or #code == 0 then
        warn(string.format("[BABFT Loader] Ошибка скачивания [%s]: %s", name, tostring(code)))
        return false
    end

    local loadSuccess, runError = pcall(function()
        local func, compileErr = loadstring(code)
        if not func then
            error("Ошибка компиляции: " .. tostring(compileErr))
        end
        func()
    end)

    if not loadSuccess then
        warn(string.format("[BABFT Loader] Ошибка выполнения [%s]: %s", name, tostring(runError)))
        return false
    end

    print(string.format("[BABFT Loader] Модуль [%s] успешно активирован!", name))
    return true
end

-- Ссылки на модули
local BASE_URL = "https://raw.githubusercontent.com/Probothotspot/Slap-battles-Teleport/main/"
local mainUrl = BASE_URL .. "Auto-farm-BABFT-Main.lua"
local guiUrl  = BASE_URL .. "Auto-Farm-BABFT-GUI.lua"
local cartUrl = BASE_URL .. "Auto-Farm-BABFT-Cart.lua"

-- 1. Запуск логического ядра (Main)
if executeScript(mainUrl, "1. Main Logic") then
    task.wait(0.1)

    -- 2. Запуск основного интерфейса (GUI)
    if executeScript(guiUrl, "2. GUI Interface") then
        task.wait(0.1)

        -- 3. Запуск модуля корзины (Cart)
        executeScript(cartUrl, "3. Shopping Cart")
    end
end
