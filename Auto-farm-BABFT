repeat task.wait(0.2) until game:IsLoaded()

local function loadScript(url, name)
    local success, code = pcall(function()
        return game:HttpGet(url .. "?t=" .. tostring(os.time()))
    end)
    
    if not success or not code or #code == 0 then
        warn("[BABFT Loader] Не удалось загрузить: " .. name)
        return false
    end
    
    local runSuccess, runError = pcall(function()
        loadstring(code)()
    end)
    
    if not runSuccess then
        warn("[BABFT Loader] Ошибка выполнения " .. name .. ": " .. tostring(runError))
        return false
    end
    
    return true
end

-- 1. Загрузка логического ядра (Main)
local mainUrl = "https://raw.githubusercontent.com/Probothotspot/Slap-battles-Teleport/main/Auto-farm-BABFT-Main.lua"
if loadScript(mainUrl, "Main Logic") then
    -- 2. Загрузка интерфейса (GUI) после инициализации ядра
    local guiUrl = "https://raw.githubusercontent.com/Probothotspot/Slap-battles-Teleport/main/Auto-Farm-BABFT-GUI.lua"
    loadScript(guiUrl, "GUI Interface")
end
