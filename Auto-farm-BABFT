        startFarming()
    else
        stopFarming()
    end
end)

-- Фоновый опрос команд из Telegram
tgPollingThread = task.spawn(function()
    while true do
        task.wait(3)
        if httpRequest and tgToken ~= "" and tgChatId ~= "" then
            pcall(function()
                local pollUrl = "https://api.telegram.org/bot" .. tgToken .. "/getUpdates?offset=" .. tostring(lastUpdateId + 1) .. "&limit=5"
                local res = httpRequest({
                    Url = pollUrl,
                    Method = "GET"
                })

                if res and res.Body then
                    local data = HttpService:JSONDecode(res.Body)
                    if data and data.ok and data.result then
                        for _, update in ipairs(data.result) do
                            lastUpdateId = update.update_id
                            local msg = update.message
                            if msg and tostring(msg.chat.id) == tostring(tgChatId) and msg.text then
                                local cmd = string.lower(string.gsub(msg.text, "%s+", ""))

                                if cmd == "/stop" then
                                    if farming then
                                        stopFarming()
                                        sendTelegramMessage("🛑 <b>Фарм остановлен дистанционно!</b>")
                                    else
                                        sendTelegramMessage("⚠️ Фарм уже выключен.")
                                    end
                                elseif cmd == "/start" then
                                    if not farming then
                                        startFarming()
                                        sendTelegramMessage("🚀 <b>Фарм запущен дистанционно!</b>")
                                    else
                                        sendTelegramMessage("⚠️ Фарм уже работает.")
                                    end
                                elseif cmd == "/status" then
                                    local currentG = getCurrentGold()
                                    local elapsed = farming and (os.time() - startTime) or 0
                                    local report = string.format(
                                        "📊 <b>Статистика BABFT:</b>\n\n" ..
                                        "• Состояние: <b>%s</b>\n" ..
                                        "• Режим: <b>%s</b>\n" ..
                                        "• Время сессии: <b>%s</b>\n" ..
                                        "• Баланс: <b>%d Gold</b>\n" ..
                                        "• Заработано: <b>+%d Gold</b>",
                                        farming and "🟢 Работает" or "🔴 Остановлен",
                                        farmMode == "Chest" and "Сундук" or "Золото",
                                        formatTime(elapsed),
                                        currentG,
                                        totalEarned
                                    )
                                    sendTelegramMessage(report)
                                elseif cmd == "/rejoin" then
                                    executeRejoin()
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

