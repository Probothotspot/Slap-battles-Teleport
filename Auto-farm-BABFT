local function setNoclip(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part ~= platform then
            part.CanCollide = false
        end
    end
end

local function startFarmingLoop()
    farmThread = task.spawn(function()
        while farming do
            local hrp, char, hum = getCurrentHRP()
            while farming and not hrp do
                task.wait(0.2)
                hrp, char, hum = getCurrentHRP()
            end
            if not farming then break end

            local resetToFirstStage = false

            if farmMode == "Chest" then
                for index = 1, 2 do
                    if not farming then break end
                    hrp, char, hum = getCurrentHRP()
                    if not hrp then resetToFirstStage = true break end

                    statusLabel.Text = "Зона " .. index .. "/10"
                    setNoclip(char)
                    placeOnPlatform(STAGE_COORDINATES[index], hrp)

                    local stageStart = tick()
                    while tick() - stageStart < 1.5 do
                        task.wait(0.05)
                        if not farming then break end
                        local curHrp = getCurrentHRP()
                        if not curHrp or (index > 1 and curHrp.Position.Z < SPAWN_Z_MAX) then
                            resetToFirstStage = true
                            break
                        end
                    end
                    if resetToFirstStage then break end
                end

                if resetToFirstStage or not farming then
                    platform.Parent = nil
                    disableClearVision()
                    task.wait(0.5)
                    continue
                end

                hrp, char, hum = getCurrentHRP()
                if hrp then
                    statusLabel.Text = "Сундук (" .. tostring(chestDelay) .. " сек)..."
                    enableClearVision()
                    setNoclip(char)
                    placeOnPlatform(CHEST_POSITION, hrp)

                    local chestStart = tick()
                    while tick() - chestStart < chestDelay do
                        task.wait(0.1)
                        if not farming then break end
                        local curHrp = getCurrentHRP()
                        if not curHrp or curHrp.Position.Z < SPAWN_Z_MAX then
                            resetToFirstStage = true
                            break
                        end
                    end
                end

                if resetToFirstStage or not farming then
                    platform.Parent = nil
                    disableClearVision()
                    task.wait(0.5)
                    continue
                end

                hrp, char, hum = getCurrentHRP()
                if hrp then
                    statusLabel.Text = "Возврат на зону 2..."
                    disableClearVision()
                    setNoclip(char)
                    placeOnPlatform(STAGE_COORDINATES[2], hrp)
                    task.wait(1.5)
                end

                for index = 3, 10 do
                    if not farming then break end
                    hrp, char, hum = getCurrentHRP()
                    if not hrp then resetToFirstStage = true break end

                    statusLabel.Text = "Зона " .. index .. "/10"
                    setNoclip(char)
                    placeOnPlatform(STAGE_COORDINATES[index], hrp)

                    local stageStart = tick()
                    while tick() - stageStart < 1.5 do
                        task.wait(0.05)
                        if not farming then break end
                        local curHrp = getCurrentHRP()
                        if not curHrp or curHrp.Position.Z < SPAWN_Z_MAX then
                            resetToFirstStage = true
                            break
                        end
                    end
                    if resetToFirstStage then break end
                end

                if resetToFirstStage or not farming then
                    platform.Parent = nil
                    disableClearVision()
                    task.wait(0.5)
                    continue
                end

                statusLabel.Text = "10 этап: ожидание спавна..."
                while farming do
                    task.wait(0.1)
                    local curHrp = getCurrentHRP()
                    if curHrp and curHrp.Position.Z < SPAWN_Z_MAX then break end
                end

                disableClearVision()
                checkAndAutoBuy()
                platform.Parent = nil
                task.wait(0.8)

            elseif farmMode == "Gold" then
                disableClearVision()
                for index, coord in ipairs(STAGE_COORDINATES) do
                    if not farming then break end
                    hrp, char, hum = getCurrentHRP()
                    if not hrp then resetToFirstStage = true break end

                    statusLabel.Text = "Зона " .. index .. "/10"
                    setNoclip(char)
                    placeOnPlatform(coord, hrp)

                    local stageStart = tick()
                    while tick() - stageStart < 1.5 do
                        task.wait(0.05)
                        if not farming then break end
                        local curHrp = getCurrentHRP()
                        if not curHrp or curHrp.Position.Z < SPAWN_Z_MAX then
                            resetToFirstStage = true
                            break
                        end
                    end
                    if resetToFirstStage then break end
                end

                if resetToFirstStage or not farming then
                    platform.Parent = nil
                    task.wait(0.5)
                    continue
                end

                hrp, char, hum = getCurrentHRP()
                if hum then
                    statusLabel.Text = "10 этап: сброс..."
                    platform.Parent = nil
                    hum.Health = 0

                    statusLabel.Text = "Возрождение на спавне..."
                    while farming do
                        task.wait(0.1)
                        local curHrp = getCurrentHRP()
                        if curHrp and curHrp.Position.Z < SPAWN_Z_MAX then break end
                    end
                    checkAndAutoBuy()
                    task.wait(0.8)
                end
            end
        end
    end)
end

startFarming = function()
    if farming then return end
    farming = true
    autoStartOnJoin = true
    saveConfig(true)

    startGold = getCurrentGold()
    previousGold = startGold
    totalEarned = 0
    table.clear(reachedMilestones)

    -- Полный сброс минутной статистики для новой сессии
    statsStartTime = time()
    lastCompletedMinuteIndex = 0
    currentMinuteGold = 0
    table.clear(completedMinutesList)
    completedMinutesSum = 0
    avgGoldPerMinute = 0
    estGoldPerHour = 0
    currentETA = "Выкл"

    updateGoldStats()
    if antiHazardActive then applyAntiHazard(true) end

    startTime = os.time()
