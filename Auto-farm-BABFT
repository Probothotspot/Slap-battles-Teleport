-- Обновление статистики (учет только входящих начислений delta > 0)
updateGoldStats = function()
    local current = getCurrentGold()
    if farming then
        local delta = current - previousGold
        if delta > 0 then
            totalEarned = totalEarned + delta
            currentMinuteGold = currentMinuteGold + delta
            playSfx(coinSfx)

            for _, m in ipairs(MILESTONES) do
                if totalEarned >= m and not reachedMilestones[m] then
                    reachedMilestones[m] = true
                    showAchievementToast("НОВОЕ ДОСТИЖЕНИЕ!", "Заработано +" .. tostring(m) .. " Gold!")
                    sendTelegramMessage(string.format("🏆 <b>ДОСТИЖЕНИЕ РАЗБЛОКИРОВАНО!</b>\nСессия принесла уже более <b>+%d Gold</b>!", m))
                end
            end
        end
        previousGold = current
        startAndCurrentGoldLabel.Text = "Старт: " .. tostring(startGold) .. "  |  Сейчас: " .. tostring(current)
        goldTrackerLabel.Text = "Заработано: +" .. tostring(totalEarned) .. " Gold"
    else
        previousGold = current
        startAndCurrentGoldLabel.Text = "Старт: 0  |  Сейчас: " .. tostring(current)
    end
    checkAndAutoBuy()
    updateSpeedAndEtaMetrics()
end

