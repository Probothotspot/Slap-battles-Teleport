-- 5. ТОЧНЫЙ РАСЧЕТ СКОРОСТИ, МИНУТНОЙ СТАТИСТИКИ И ETA
-- =====================================================================
updateSpeedAndEtaMetrics = function()
    if not farming then
        if #completedMinutesList == 0 then
            goldSpeedLabel.Text = "Скорость: ~0 G/ч (0.0 G/мин)"
            minuteStatsLabel.Text = "Мин. статистика: фарм остановлен"
        end
        etaLabel.Text = "До покупки: Выкл"
        return
    end

    local elapsed = time() - statsStartTime
    local completedMinutes = math.floor(elapsed / 60)

    -- Фиксация завершенных полных минут
    if completedMinutes > lastCompletedMinuteIndex then
        while lastCompletedMinuteIndex < completedMinutes do
            lastCompletedMinuteIndex = lastCompletedMinuteIndex + 1
            if lastCompletedMinuteIndex == completedMinutes then
                table.insert(completedMinutesList, currentMinuteGold)
                completedMinutesSum = completedMinutesSum + currentMinuteGold
                currentMinuteGold = 0
            else
                table.insert(completedMinutesList, 0)
            end
        end

        local count = #completedMinutesList
        if count > 0 then
            avgGoldPerMinute = completedMinutesSum / count
            estGoldPerHour = math.floor(avgGoldPerMinute * 60)
        end
    end

    local count = #completedMinutesList
    if count == 0 then
        -- Сбор данных до первой завершенной минуты
        goldSpeedLabel.Text = "Скорость: сбор данных до 1-й минуты..."
        minuteStatsLabel.Text = string.format("Замер минуты 1: +%d G (%dс/60с)", currentMinuteGold, math.floor(elapsed % 60))
    else
        goldSpeedLabel.Text = string.format("Скорость: ~%d G/ч (%.1f G/мин)", estGoldPerHour, avgGoldPerMinute)
        if count == 1 then
            minuteStatsLabel.Text = string.format("М1: +%d | Среднее: %.1f G/мин", completedMinutesList[1], avgGoldPerMinute)
        else
            local mPrev = count - 1
            minuteStatsLabel.Text = string.format("М%d:+%d | М%d:+%d | Ср:%.1f/мин", mPrev, completedMinutesList[mPrev], count, completedMinutesList[count], avgGoldPerMinute)
        end
    end

    -- Расчет ETA
    if autoBuyActive and targetItemPrice > 0 and buyAmount > 0 then
        local currentG = getCurrentGold()
        local targetTotal = targetItemPrice * buyAmount
        local needed = targetTotal - currentG

        if needed <= 0 then
            currentETA = "Готово (хватает)"
            etaLabel.TextColor3 = Color3.fromRGB(120, 255, 150)
            etaLabel.Text = "Нужно 0 G | ETA: Готово (хватает)"
        elseif count == 0 or avgGoldPerMinute <= 0 then
            currentETA = "после 1 мин."
            etaLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
            etaLabel.Text = string.format("Нужно %d G | ETA после 1 мин.", needed)
        else
            local minutesNeeded = needed / avgGoldPerMinute
            local secondsNeeded = math.floor(minutesNeeded * 60)
            currentETA = formatTime(secondsNeeded)
            etaLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
            etaLabel.Text = string.format("Нужно %d G | ETA: %s", needed, currentETA)
        end
    else
        currentETA = "Выкл"
        etaLabel.TextColor3 = Color3.fromRGB(160, 150, 180)
        etaLabel.Text = "До покупки: Выкл"
    end

    if isBlackScreen then
        bsStats.Text = string.format(
            "Заработано: +%d Gold\nСкорость: ~%d Gold/час (%.1f/мин)\nВремя: %s",
            totalEarned,
            estGoldPerHour,
            avgGoldPerMinute,
            timeTrackerLabel.Text:gsub("Время фарма: ", "")
        )
    end
end

-- Полная выгрузка скрипта
fullCleanup = function()
    farming = false
    autoBuyActive = false
    autoStartOnJoin = false
    disableClearVision()
    toggleAntiHazard(false)
    toggleBlackScreen(false)

    if idledConn then idledConn:Disconnect() end
    if playerAddedConn then playerAddedConn:Disconnect() end
    if masterRenderConn then masterRenderConn:Disconnect() end
    if farmThread then task.cancel(farmThread) end
    if timerThread then task.cancel(timerThread) end
    if tgPollingThread then task.cancel(tgPollingThread) end
    if cometThread then task.cancel(cometThread) end

    local hrp = getCurrentHRP()
    if hrp then setSpin(hrp, false) end
    if platform then platform:Destroy() end
    if screenGui and screenGui.Parent then screenGui:Destroy() end
end

_G.BabftActiveScript = { Destroy = fullCleanup }

