local function getGlobalText(key, lang)
    lang = lang or (_G.TeleportClickSettings and _G.TeleportClickSettings.language or "en")
    return Translations[lang] and Translations[lang][key] or Translations.en[key] or key
end

-- ===================== ОСНОВНАЯ ФУНКЦИЯ =====================
function StartClickTeleport()
    local settings = _G.TeleportClickSettings
    local currentLang = settings.language or "en"
    local device = settings.device or "PC"
    local currentTheme = settings.theme or "purple"

    local function L(key) return getGlobalText(key, currentLang) end

    local theme = Themes[currentTheme] or Themes.purple
    local GuiBackgroundColor = theme.mainBg
    local GuiTextColor = theme.textColor
    local AccentColor = theme.accent
    local CursorColor = theme.cursorColor

    pcall(function()
        local coreGui = game:GetService("CoreGui")
        for _, name in ipairs({"ClickTeleportGUI", "MobileTeleportButton", "CursorGUI"}) do
            local obj = coreGui:FindFirstChild(name)
            if obj then obj:Destroy() end
        end
    end)

    local ScriptSettings = {
        Enabled = true,
        ToggleKey = Enum.KeyCode.T,
        TeleportKey = Enum.KeyCode.F,
        PreviewKey = Enum.KeyCode.G,
        SmoothTeleport = false,
        TeleportDuration = 0.3,
        TeleportOffset = 2,
        ShowMarker = true,
        MarkerColor = Color3.fromRGB(0, 255, 255),
        MarkerLifetime = 3,
        MarkerTransparency = 0.2,
        EnableFlash = true,
        TeleportSoundId = "",
        HistoryEnabled = true,
        HistoryKey = Enum.KeyCode.R,
        StartMinimized = false,
    }

    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local Workspace = game:GetService("Workspace")
    local Camera = Workspace.CurrentCamera
    local LP = Players.LocalPlayer
    local Char = LP.Character or LP.CharacterAdded:Wait()
    local HRP = Char:WaitForChild("HumanoidRootPart")
    local Hum = Char:WaitForChild("Humanoid")

    local ModeEnabled = _G.ClickTeleportEnabled ~= nil and _G.ClickTeleportEnabled or ScriptSettings.Enabled
    local Connections = {}
    local Markers = {}
    local History = {}
    local TeleportQueue = {}
    local IsTeleporting = false
    local Destroyed = false

    -- GUI элементы
    local StatusGui, StatusFrame, StatusLabel, ToggleButton, MinimizeBtn, CloseBtn, IconBtn
    local isMinimized = false
    local savedPosition = nil

    -- Виртуальный курсор и мобильные элементы
    local VirtualCursor, CursorGui
    local MobileControlFrame, TeleportButton, PreviewButton, MobileButtonGui
    local previewZone = nil

    local function refreshCharacter()
        if Destroyed then return end
        Char = LP.Character
        if Char then
            HRP = Char:WaitForChild("HumanoidRootPart")
            Hum = Char:WaitForChild("Humanoid")
        end
    end

    local function createMarker(position)
        if Destroyed or not ScriptSettings.ShowMarker then return end
        local marker = Instance.new("Part")
        marker.Name = "TeleportMarker"
        marker.Size = Vector3.new(1, 1, 1)
        marker.Shape = Enum.PartType.Ball
        marker.Material = Enum.Material.Neon
        marker.Color = ScriptSettings.MarkerColor
        marker.Transparency = ScriptSettings.MarkerTransparency
        marker.Anchored = true
        marker.CanCollide = false
        marker.Position = position
        marker.Parent = Workspace
        local appearTween = TweenService:Create(marker, TweenInfo.new(0.2), {Size = Vector3.new(1, 1, 1)})
        marker.Size = Vector3.new(0, 0, 0)
        appearTween:Play()
        task.delay(ScriptSettings.MarkerLifetime, function()
            if Destroyed then return end
            if marker and marker.Parent then
                local disappearTween = TweenService:Create(marker, TweenInfo.new(0.3), {Transparency = 1})
                disappearTween:Play()
                disappearTween.Completed:Wait()
                marker:Destroy()
            end
        end)
        table.insert(Markers, marker)
    end

    local function createFlash(position)
        if Destroyed or not ScriptSettings.EnableFlash then return end
        local flash = Instance.new("Part")
        flash.Size = Vector3.new(0.2, 0.2, 0.2)
        flash.Transparency = 1
        flash.Anchored = true
        flash.CanCollide = false
        flash.Position = position
        flash.Parent = Workspace
        local emitter = Instance.new("ParticleEmitter")
        emitter.Rate = 200
        emitter.Lifetime = NumberRange.new(0.5, 1)
        emitter.Speed = NumberRange.new(5, 10)
        emitter.SpreadAngle = Vector2.new(360, 360)
        emitter.Texture = "rbxassetid://244221925"
        emitter.Color = ColorSequence.new(ScriptSettings.MarkerColor)
        emitter.VelocityInheritance = 0
        emitter.Parent = flash
        emitter:Emit(30)
        task.delay(1, function()
            if not Destroyed then flash:Destroy() end
        end)
    end

    local function addToHistory(position)
        if not ScriptSettings.HistoryEnabled then return end
        table.insert(History, position)
        if #History > 5 then table.remove(History, 1) end
    end

    local function goBackHistory()
        if Destroyed or not ScriptSettings.HistoryEnabled or #History == 0 then return end
        local prevPos = table.remove(History)
        queueTeleport(prevPos)
    end

    local function processQueue()
        if Destroyed or IsTeleporting then return end
        IsTeleporting = true
        while #TeleportQueue > 0 and not Destroyed do
            local targetPos = table.remove(TeleportQueue, 1)
            if not Char or not HRP or not HRP.Parent then break end
            createMarker(targetPos)
            createFlash(targetPos)
            addToHistory(HRP.Position)
            local currentRotation = HRP.CFrame.Rotation
            if ScriptSettings.SmoothTeleport then
                local targetCF = CFrame.new(targetPos) * currentRotation
                local tweenInfo = TweenInfo.new(ScriptSettings.TeleportDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                local tween = TweenService:Create(HRP, tweenInfo, {CFrame = targetCF})
                tween:Play()
                tween.Completed:Wait()
            else
                HRP.CFrame = CFrame.new(targetPos) * currentRotation
            end
            if Hum and Hum:GetState() ~= Enum.HumanoidStateType.Jumping then
                Hum.Jump = true
            end
            task.wait(0.05)
        end
        IsTeleporting = false
    end

    function queueTeleport(position)
        if Destroyed then return end
        table.insert(TeleportQueue, position)
        if not IsTeleporting then processQueue() end
    end

    local RAY_LENGTH = 1000000
    local function getTargetPosition(screenX, screenY)
        local ray = Camera:ScreenPointToRay(screenX, screenY)
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {Char}
        local raycastResult = Workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, raycastParams)
        if raycastResult then
            local hitPos = raycastResult.Position
            local hitNormal = raycastResult.Normal
            return hitPos + hitNormal * ScriptSettings.TeleportOffset
        end
        return nil
    end

    local function removePreviewZone()
        if previewZone and previewZone.Parent then
            previewZone:Destroy()
            previewZone = nil
        end
    end

    -- Телепорт (ПК – системный курсор, Mobile – виртуальный)
    local function teleportFromCursor()
        if Destroyed or not ModeEnabled then return end
        local centerX, centerY
        if device == "PC" then
            local mousePos = UIS:GetMouseLocation()
            centerX, centerY = mousePos.X, mousePos.Y
        else
            if not VirtualCursor then return end
            local absPos = VirtualCursor.AbsolutePosition
            local size = VirtualCursor.AbsoluteSize
            centerX = absPos.X + size.X/2
            centerY = absPos.Y + size.Y/2
        end
        local target = getTargetPosition(centerX, centerY)
        if target then
            removePreviewZone()
            local currentRotation = HRP.CFrame.Rotation
            HRP.CFrame = CFrame.new(target) * currentRotation
            addToHistory(target)
        end
    end

    local function previewTP()
        if Destroyed or not ModeEnabled then return end
        local centerX, centerY
        if device == "PC" then
            local mousePos = UIS:GetMouseLocation()
            centerX, centerY = mousePos.X, mousePos.Y
        else
            if not VirtualCursor then return end
            local absPos = VirtualCursor.AbsolutePosition
            local size = VirtualCursor.AbsoluteSize
            centerX = absPos.X + size.X/2
            centerY = absPos.Y + size.Y/2
        end
        local targetPos = getTargetPosition(centerX, centerY)
        if not targetPos then
            removePreviewZone()
            game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
                Text = L("preview_removed"), Color = Color3.fromRGB(255,200,100), Font = Enum.Font.SourceSansBold
            })
            return
        end
        removePreviewZone()
        previewZone = Instance.new("Part")
        previewZone.Name = "PreviewZone"
        previewZone.Size = Vector3.new(10, 0.5, 10)
        previewZone.Shape = Enum.PartType.Cylinder
        previewZone.Material = Enum.Material.Neon
        previewZone.Color = Color3.fromRGB(255, 255, 0)
        previewZone.Transparency = 0.4
        previewZone.Anchored = true
        previewZone.CanCollide = false
        previewZone.Position = targetPos
        previewZone.Parent = Workspace
        game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
            Text = L("preview_created"), Color = Color3.fromRGB(100,255,100), Font = Enum.Font.SourceSansBold
        })
        task.delay(5, function()
            if previewZone and previewZone.Parent then
                previewZone:Destroy()
                previewZone = nil
            end
        end)
    end

    -- Виртуальный курсор (только для мобильных)
    local function setupVirtualCursor()
        if CursorGui then return end
        CursorGui = Instance.new("ScreenGui")
        CursorGui.Name = "CursorGUI"
        CursorGui.ResetOnSpawn = false
        pcall(function() CursorGui.Parent = game:GetService("CoreGui") end)
        if not CursorGui.Parent then CursorGui.Parent = LP:WaitForChild("PlayerGui") end

        VirtualCursor = Instance.new("Frame", CursorGui)
        VirtualCursor.Size = UDim2.new(0, 32, 0, 32)
        VirtualCursor.Position = UDim2.new(0.5, -16, 0.5, -16)
        VirtualCursor.BackgroundColor3 = CursorColor
        VirtualCursor.BackgroundTransparency = 0.3
        VirtualCursor.BorderSizePixel = 0
        Instance.new("UICorner", VirtualCursor).CornerRadius = UDim.new(1, 0)
        VirtualCursor.ZIndex = 100

        if device == "PC" then
            VirtualCursor.Visible = false  -- На ПК курсор не нужен
        else
            -- Мобильная логика: тап + перетаскивание
            local cursorDrag = false
            local moved = false
            VirtualCursor.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    cursorDrag = true
                    moved = false
                end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch and cursorDrag then
                    if not moved then
                        local pos = input.Position
                        VirtualCursor.Position = UDim2.new(0, pos.X - VirtualCursor.AbsoluteSize.X/2,
                                                            0, pos.Y - VirtualCursor.AbsoluteSize.Y/2)
                    end
                    cursorDrag = false
                end
            end)
            UIS.TouchMoved:Connect(function(input, processed)
                if processed or not cursorDrag then return end
                moved = true
                local pos = input.Position
                VirtualCursor.Position = UDim2.new(0, pos.X - VirtualCursor.AbsoluteSize.X/2,
                                                    0, pos.Y - VirtualCursor.AbsoluteSize.Y/2)
            end)

            -- Защита от касаний кнопок
            UIS.InputBegan:Connect(function(input, gameProcessed)
                if Destroyed or gameProcessed then return end
                if input.UserInputType == Enum.UserInputType.Touch then
                    local touchPos = input.Position
                    if MobileControlFrame and MobileControlFrame.Visible then
                        local absPos = MobileControlFrame.AbsolutePosition
                        local absSize = MobileControlFrame.AbsoluteSize
                        if touchPos.X >= absPos.X and touchPos.X <= absPos.X + absSize.X and
                           touchPos.Y >= absPos.Y and touchPos.Y <= absPos.Y + absSize.Y then
                            cursorDrag = false
                            return
                        end
                    end
                end
            end)
        end
    end

    local function createMobileButtons()
        if MobileButtonGui then return end
        MobileButtonGui = Instance.new("ScreenGui")
        MobileButtonGui.Name = "MobileTeleportButton"
        MobileButtonGui.ResetOnSpawn = false
        pcall(function() MobileButtonGui.Parent = game:GetService("CoreGui") end)
        if not MobileButtonGui.Parent then MobileButtonGui.Parent = LP:WaitForChild("PlayerGui") end

        MobileControlFrame = Instance.new("Frame", MobileButtonGui)
        MobileControlFrame.Size = UDim2.new(0, 150, 0, 80)
        MobileControlFrame.Position = UDim2.new(1, -160, 1, -160)
        MobileControlFrame.BackgroundColor3 = GuiBackgroundColor
        MobileControlFrame.BackgroundTransparency = 0
        MobileControlFrame.Active = true
        MobileControlFrame.Draggable = true
        MobileControlFrame.BorderSizePixel = 0
        Instance.new("UICorner", MobileControlFrame).CornerRadius = UDim.new(0, 10)

        local whiteColor = Color3.fromRGB(255, 255, 255)

        PreviewButton = Instance.new("TextButton", MobileControlFrame)
        PreviewButton.Size = UDim2.new(0, 60, 0, 60)
        PreviewButton.Position = UDim2.new(0, 0, 0.5, -30)
        PreviewButton.Text = "👁"
        PreviewButton.TextSize = 28
        PreviewButton.Font = Enum.Font.GothamBold
        PreviewButton.BackgroundColor3 = whiteColor
        PreviewButton.BackgroundTransparency = 0
        PreviewButton.TextColor3 = Color3.fromRGB(0,0,0)
        PreviewButton.BorderSizePixel = 0
        Instance.new("UICorner", PreviewButton).CornerRadius = UDim.new(1, 0)

        TeleportButton = Instance.new("TextButton", MobileControlFrame)
        TeleportButton.Size = UDim2.new(0, 70, 0, 70)
        TeleportButton.Position = UDim2.new(0, 75, 0.5, -35)
        TeleportButton.Text = "🌀"
        TeleportButton.TextSize = 30
        TeleportButton.Font = Enum.Font.GothamBold
        TeleportButton.BackgroundColor3 = whiteColor
        TeleportButton.BackgroundTransparency = 0
        TeleportButton.TextColor3 = Color3.fromRGB(0,0,0)
        TeleportButton.BorderSizePixel = 0
        Instance.new("UICorner", TeleportButton).CornerRadius = UDim.new(1, 0)

        TeleportButton.MouseButton1Click:Connect(teleportFromCursor)
        PreviewButton.MouseButton1Click:Connect(previewTP)
        TeleportButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                task.delay(0.1, teleportFromCursor)
            end
        end)
        PreviewButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                task.delay(0.1, previewTP)
            end
        end)
    end

    -- ===== GUI СТАТУСА =====
    local function updateStatusGui()
        if Destroyed or not StatusLabel or not ToggleButton then return end
        StatusLabel.Text = ModeEnabled and L("status_on") or L("status_off")
        ToggleButton.Text = ModeEnabled and L("toggle_on") or L("toggle_off")
    end

    local function toggleMode()
        if Destroyed then return end
        ModeEnabled = not ModeEnabled
        _G.ClickTeleportEnabled = ModeEnabled
        updateStatusGui()
        local msg = ModeEnabled and "🟢 Click Teleport: ON" or "🔴 Click Teleport: OFF"
        game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
            Text = msg, Color = Color3.fromRGB(255,255,255),
            Font = Enum.Font.SourceSansBold, FontSize = Enum.FontSize.Size18
        })
    end

    local function toggleMinimize()
        if Destroyed then return end
        if isMinimized then
            local targetPos = savedPosition or UDim2.new(0.5, -130, 0, 10)
            StatusFrame.Size = UDim2.new(0, 260, 0, 50)
            StatusFrame.Position = targetPos
            IconBtn.Visible = false
            StatusLabel.Visible = true
            ToggleButton.Visible = true
            MinimizeBtn.Visible = true
            CloseBtn.Visible = true
            MinimizeBtn.Text = "–"
            isMinimized = false
        else
            savedPosition = StatusFrame.Position
            local tween = TweenService:Create(StatusFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, 44, 0, 44)})
            tween:Play()
            tween.Completed:Connect(function()
                if Destroyed then return end
                StatusLabel.Visible = false
                ToggleButton.Visible = false
                MinimizeBtn.Visible = false
                CloseBtn.Visible = false
                IconBtn.Visible = true
                MinimizeBtn.Text = "+"
            end)
            isMinimized = true
        end
        _G.ClickTeleportMinimized = isMinimized
    end

    local function cleanup()
        if Destroyed then return end
        Destroyed = true
        TeleportQueue = {}
        IsTeleporting = false
        for _, conn in ipairs(Connections) do conn:Disconnect() end
        Connections = {}
        for _, marker in ipairs(Markers) do
            if marker and marker.Parent then marker:Destroy() end
        end
        Markers = {}
        removePreviewZone()
        pcall(function()
            if StatusGui then StatusGui:Destroy() end
            if MobileButtonGui then MobileButtonGui:Destroy() end
