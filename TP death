local function refreshPlayerList()
    playerList:ClearAllChildren()
    local y = 0
    local btn1 = Instance.new("TextButton", playerList)
    btn1.Size = UDim2.new(1, -5, 0, 26)
    btn1.Position = UDim2.new(0, 0, 0, y)
    btn1.Text = "(Nearest)"
    btn1.BackgroundColor3 = Color3.fromRGB(60, 30, 80)
    btn1.TextColor3 = Color3.new(1,1,1)
    btn1.Font = Enum.Font.SourceSans
    btn1.TextSize = 14
    btn1.Parent = playerList
    Instance.new("UICorner", btn1).CornerRadius = UDim.new(0, 4)
    btn1.MouseButton1Click:Connect(function()
        Settings.TargetPlayer = nil
        updateTargetLabel()
    end)
    y = y + 30

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local btn = Instance.new("TextButton", playerList)
            btn.Size = UDim2.new(1, -5, 0, 26)
            btn.Position = UDim2.new(0, 0, 0, y)
            btn.Text = p.Name
            btn.BackgroundColor3 = Color3.fromRGB(60, 30, 80)
            btn.TextColor3 = Color3.new(1,1,1)
            btn.Font = Enum.Font.SourceSans
            btn.TextSize = 14
            btn.Parent = playerList
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            btn.MouseButton1Click:Connect(function()
                Settings.TargetPlayer = p
                updateTargetLabel()
            end)
            y = y + 30
        end
    end
    playerList.CanvasSize = UDim2.new(0, 0, 0, y)
end

