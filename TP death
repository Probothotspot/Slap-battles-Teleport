local RESET_POINT = CFrame.new(-1210, -80, 4)

-- ==================== ФУНКЦИИ ====================
local function GetNearestEnemyRoot()
    if stopScript then return nil end
    local myChar = LP.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local nearest, nearestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = root
                end
            end
        end
    end
    return nearest
end

-- ==================== FREEZE (как в проверенном скрипте) ====================
local function onFreezeHeartbeat()
    local char = LP.Character
    if char and char:FindFirstChild("HumanoidRootPart") and freezeCFrame then
        char.HumanoidRootPart.CFrame = freezeCFrame
    else
        -- персонаж исчез – отключаем фриз
        freezeEnabled = false
        if freezeConnection then
            freezeConnection:Disconnect()
            freezeConnection = nil
        end
    end
end

local function StartFreeze(targetCF)
    StopFreeze()
    freezeEnabled = true
    freezeCFrame = targetCF
    freezeConnection = RunService.Heartbeat:Connect(onFreezeHeartbeat)
    AddLog("🔒 Freeze активирован – позиция зафиксирована")
end

local function StopFreeze()
    if freezeEnabled then
        AddLog("🔓 Freeze деактивирован")
    end
    freezeEnabled = false
    freezeCFrame = nil
    if freezeConnection then
        freezeConnection:Disconnect()
        freezeConnection = nil
    end
end

-- ==================== DICE RESET ====================
local function extractNumber(text)
    if not text then return nil end
    local numStr = string.match(text, "%d+")
    return numStr and tonumber(numStr)
end

local function findNumberInGui(obj)
    if obj:IsA("TextLabel") then
        local num = extractNumber(obj.Text)
        if num then return num end
    end
    for _, child in ipairs(obj:GetChildren()) do
        local num = findNumberInGui(child)
        if num then return num end
    end
    return nil
end

local function findDiceNumber(char)
    for _, child in ipairs(char:GetDescendants()) do
        if child:IsA("BillboardGui") then
            local num = findNumberInGui(child)
            if num and num >= 5 and num <= 100 and num > Settings.DiceThreshold then
                return num
            end
        end
    end
    return nil
end

local function DoDiceReset(char)
    StopFreeze()
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = RESET_POINT
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Health = 0
    else
        char:BreakJoints()
    end
    AddLog("🎲 Dice reset (число > " .. Settings.DiceThreshold .. ")")
    lastDiceHitTime = 0
    diceSearchActive = false
end

local function StartDiceSearch(char)
    if diceSearchActive then return end
    diceSearchActive = true
    local startTime = tick()
    while diceSearchActive and tick() - startTime < 0.8 do
        if not char or char ~= LP.Character then
            diceSearchActive = false
            return
        end
        local num = findDiceNumber(char)
        if num then
            DoDiceReset(char)
            return
        end
        task.wait(0.05)
    end
    diceSearchActive = false
end

-- ==================== ОСНОВНАЯ ЛОГИКА ====================
local function ProcessZones()
    if stopScript or not Settings.Enabled then return end
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local y = root.Position.Y
    local now = tick()

    -- Лобби
    if y >= 320 and y <= 330 then
        arenaLastTeleport = 0
        lowZoneLastTime = 0
        root.CFrame = LOBBY_PORTAL
        StopFreeze()
        AddLog("Телепорт к порталу")
        return
    end

    -- Низкая зона
    if Settings.EnableLowZone and y >= -150 and y <= -110 then
        if now - lowZoneLastTime >= math.max(Settings.LowZoneCooldown, 0) then
            local target = Settings.LowZoneTarget
            local dist = (root.Position - target.Position).Magnitude
            if dist > 5 then
                root.CFrame = target
                lowZoneLastTime = now
                AddLog("Телепорт в низкой зоне")
            end
        end
        return
    end

    -- Арена
    if y >= -50 and y <= 80 then
        -- Если включен Lock и фриз ещё не активен – сразу замораживаем на текущем месте
        if Settings.LockAfterArenaTeleport and not freezeEnabled and not Settings.InstantDeathOnHPChange then
            StartFreeze(root.CFrame)
        end

        local function doTeleport()
            local targetRoot = nil
            if Settings.TargetPlayer and Settings.TargetPlayer.Character then
                targetRoot = Settings.TargetPlayer.Character:FindFirstChild("HumanoidRootPart")
            end
            if not targetRoot then targetRoot = GetNearestEnemyRoot() end
            if targetRoot then
                local distance = Settings.ArenaTeleportDistance
                local targetCF = targetRoot.CFrame * CFrame.new(0, 0, -distance)
                root.CFrame = targetCF
                arenaLastTeleport = tick()
                local targetName = Settings.TargetPlayer and Settings.TargetPlayer.Name or "ближайший"
                AddLog("Телепорт к " .. targetName .. " (" .. distance .. " студ.)")

                -- Обновляем точку фриза на новую позицию
                if Settings.LockAfterArenaTeleport and not Settings.InstantDeathOnHPChange then
                    StartFreeze(targetCF)
                end
                return true
            else
                AddLog("Нет цели для телепорта")
                return false
            end
        end

        if Settings.ArenaTeleportContinuous then
            if now - arenaLastTeleport >= Settings.ArenaTeleportCooldown then
                doTeleport()
            end
        else
            if arenaLastTeleport == 0 then
                doTeleport()
            end
        end
    else
        -- Вне известных зон – снимаем фриз
        if freezeEnabled then
            StopFreeze()
        end
    end
end

local function OnHealthChanged(newHealth)
    if stopScript then return end
    local char = LP.Character
    if not char then return end

    if Settings.InstantDeathOnHPChange then
        StopFreeze()
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = RESET_POINT
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = 0
        else
            char:BreakJoints()
        end
        AddLog("Мгновенная смерть: HP изменилось")
        return
    end

    if Settings.ResetOnDiceRoll and lastHealth and newHealth < lastHealth then
        lastDiceHitTime = tick()
        AddLog("Удар зафиксирован, поиск числа кубика (> " .. Settings.DiceThreshold .. ")")
        task.spawn(function() StartDiceSearch(char) end)
    end

    if Settings.AutoResetOnHit and not Settings.ResetOnDiceRoll and lastHealth and newHealth < lastHealth then
        local now = tick()
        if now - lastResetTime >= 1 then
            if not freezeEnabled then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    root.CFrame = RESET_POINT
                    lastResetTime = now
                    AddLog("Авто‑ресет: HP " .. lastHealth .. " → " .. newHealth)
                end
            end
        end
    end
    lastHealth = newHealth
end

local function SetupHealthListener(char)
    if stopScript then return end
    if healthConnection then healthConnection:Disconnect() end
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        lastHealth = hum.Health
        healthConnection = hum.HealthChanged:Connect(OnHealthChanged)
        hum.Died:Once(function()
            arenaLastTeleport = 0
            lowZoneLastTime = 0
            StopFreeze()
            lastDiceHitTime = 0
            diceSearchActive = false
            AddLog("Смерть – Freeze снят")
        end)
        AddLog("Защита активирована (HP = " .. lastHealth .. ")")
    end
end

local function StopAll()
    stopScript = true
    StopFreeze()
    if healthConnection then healthConnection:Disconnect() end
    _G.TeleportRunning = false
    AddLog("Скрипт полностью остановлен.")
end

-- ==================== ЛОГ ====================
local logLines = {}
local logLabel = nil
function AddLog(msg)
    local fullMsg = os.date("%X") .. " - " .. msg
    table.insert(logLines, fullMsg)
    if #logLines > 10 then table.remove(logLines, 1) end
    print("[Teleport] " .. msg)
    if logLabel then pcall(function() logLabel.Text = table.concat(logLines, "\n") end) end
end

