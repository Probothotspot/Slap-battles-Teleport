-- ==================== НАСТРОЙКИ (индивидуальны для каждого экземпляра) ====================
local Settings = {
    Enabled = true,
    SlapRadius = 15,
    SlapInterval = 1,
    AutoRange = true,
}

-- Попытка загрузить сохранённые настройки (из общей переменной, но это не страшно)
pcall(function()
    if _G.AutoSlapSettings then
        for k, v in pairs(_G.AutoSlapSettings) do
            if Settings[k] ~= nil then
                Settings[k] = v
            end
        end
    end
end)

local lastSlapTime = 0
local currentAutoRadius = Settings.SlapRadius

-- ==================== ОПРЕДЕЛЕНИЕ РАДИУСА АТАКИ ПЕРЧАТКИ ====================
local function CalculateGloveRange(tool)
    local handle = tool:FindFirstChild("Handle")
    local refPos = handle and handle.Position or tool:GetPivot().Position
    local maxDist = 0
    for _, part in ipairs(tool:GetDescendants()) do
        if part:IsA("BasePart") then
            local dist = (part.Position - refPos).Magnitude
            if dist > maxDist then
                maxDist = dist
            end
        end
    end
    return maxDist + 10  -- запас
end

local function GetCurrentRadius()
    if not Settings.AutoRange then
        return Settings.SlapRadius
    end
    local char = LP.Character
    if not char then return Settings.SlapRadius end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return Settings.SlapRadius end
    local calculated = CalculateGloveRange(tool)
    if calculated > 0 then
        currentAutoRadius = calculated
        return calculated
    else
        return Settings.SlapRadius
    end
end

-- ==================== ПОИСК БЛИЖАЙШЕГО ВРАГА ====================
local function GetNearestEnemy(radius)
    local char = LP.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local nearest = nil
    local nearestDist = radius
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChild("Humanoid")
            local enemyRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and enemyRoot and hum.Health > 0 then
                local dist = (root.Position - enemyRoot.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = plr
                end
            end
        end
    end
    return nearest, nearestDist
end

-- ==================== АВТОУДАР ====================
local function ProcessAutoSlap()
    if stopScript or not Settings.Enabled then return end
    local char = LP.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    local radius = GetCurrentRadius()
    local enemy, dist = GetNearestEnemy(radius)
    if not enemy then return end

    local now = tick()
    if now - lastSlapTime >= Settings.SlapInterval then
        lastSlapTime = now
        tool:Activate()
        AddLog(string.format("Удар по %s (дист: %.1f, радиус: %.1f)", enemy.Name, dist, radius))
    end
end

-- ==================== ОСТАНОВКА ====================
local function StopAll()
    stopScript = true
    AddLog("Auto Slap остановлен.")
end

-- ==================== ЛОГ ====================
local logLines = {}
local logLabel = nil
function AddLog(msg)
    local fullMsg = os.date("%X") .. " - " .. msg
    table.insert(logLines, fullMsg)
    if #logLines > 10 then table.remove(logLines, 1) end
    print("[AutoSlap " .. uniqueID .. "] " .. msg)
    if logLabel then pcall(function() logLabel.Text = table.concat(logLines, "\n") end) end
end

-- ==================== ГЛАВНЫЙ ЦИКЛ ====================
RunService.Heartbeat:Connect(function()
    if stopScript then return end
    ProcessAutoSlap()
end)

