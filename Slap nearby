local function CreateToggle(parent, text, yPos, settingName)
    local label = Instance.new("TextLabel", parent)
    label.Size = UDim2.new(0, 120, 0, 20)
    label.Position = UDim2.new(0, 12, 0, yPos)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(0.9,0.9,1)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 13

    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0, 60, 0, 24)
    btn.Position = UDim2.new(1, -72, 0, yPos-2)
    btn.BackgroundColor3 = Settings[settingName] and Color3.fromRGB(0,200,0) or Color3.fromRGB(200,0,0)
    btn.Text = Settings[settingName] and "ON" or "OFF"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
    Instance.new("UIStroke", btn).Thickness = 1.5
    btn.MouseButton1Click:Connect(function()
        Settings[settingName] = not Settings[settingName]
        btn.BackgroundColor3 = Settings[settingName] and Color3.fromRGB(0,200,0) or Color3.fromRGB(200,0,0)
        btn.Text = Settings[settingName] and "ON" or "OFF"
        _G.AutoSlapSettings = Settings
        AddLog(settingName .. " = " .. tostring(Settings[settingName]))
    end)
    return btn
end

local function CreateTextBox(parent, text, yPos, settingName, isNumber, enabled)
    local label = Instance.new("TextLabel", parent)
    label.Size = UDim2.new(0, 120, 0, 20)
    label.Position = UDim2.new(0, 12, 0, yPos)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(0.9,0.9,1)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 13

    local box = Instance.new("TextBox", parent)
    box.Size = UDim2.new(0, 90, 0, 24)
    box.Position = UDim2.new(1, -102, 0, yPos-2)
    box.Text = tostring(Settings[settingName])
    box.TextColor3 = Color3.new(0,0,0)
    box.BackgroundColor3 = enabled and Color3.new(1,1,1) or Color3.fromRGB(180,180,180)
    box.Font = Enum.Font.GothamMedium
    box.TextSize = 13
    box.ClearTextOnFocus = false
    box.TextEditable = enabled
    Instance.new("UICorner", box).CornerRadius = UDim.new(0,5)
    box.FocusLost:Connect(function()
        if not enabled then return end
        local val = box.Text
        if isNumber then
            local num = tonumber(val)
            if num then
                Settings[settingName] = num
                _G.AutoSlapSettings = Settings
                AddLog(settingName .. " = " .. num)
            else
                box.Text = tostring(Settings[settingName])
            end
        else
            Settings[settingName] = val
            _G.AutoSlapSettings = Settings
            AddLog(settingName .. " = " .. val)
        end
    end)
    return box
end

