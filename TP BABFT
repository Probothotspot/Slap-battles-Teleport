    -- Переключение вкладок
    local function switchTab(tab)
        playersFrame.Visible = (tab == "players")
        locationsFrame.Visible = (tab == "locations")
        tabPlayers.BackgroundColor3 = (tab=="players") and Color3.fromRGB(120,120,220) or Color3.fromRGB(70,70,130)
        tabLocations.BackgroundColor3 = (tab=="locations") and Color3.fromRGB(120,120,220) or Color3.fromRGB(70,70,130)
        if tab == "players" then refreshPlayerList() elseif tab == "locations" then refreshLocationsList() end
    end
    tabPlayers.MouseButton1Click:Connect(function() switchTab("players") end)
    tabLocations.MouseButton1Click:Connect(function() switchTab("locations") end)

    refreshPlayerList()
    refreshLocationsList()
    switchTab("players")

    UserInput.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.P then
            sg:Destroy()
