    local function getPlayerTeam(player)
        local char = player.Character
        if not char then return nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local pos = hrp.Position
        local bestTeam = nil
        local bestDist = TEAM_RADIUS
        for _, loc in ipairs(teamLocations) do
            local d = (pos - loc.pos).Magnitude
            if d < bestDist then
                bestDist = d
                bestTeam = loc
            end
        end
        return bestTeam
    end

    local function refreshPlayerList()
        playerList:ClearAllChildren()
        local all = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and (searchFilter=="" or p.Name:lower():find(searchFilter:lower())) then
                table.insert(all, p)
            end
        end
        if sortByDistance then
            table.sort(all, function(a,b)
                local aRoot = a.Character and a.Character:FindFirstChild("HumanoidRootPart")
                local bRoot = b.Character and b.Character:FindFirstChild("HumanoidRootPart")
                local aDist = aRoot and (aRoot.Position - (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") or Vector3.zero).Position).Magnitude or 9999
                local bDist = bRoot and (bRoot.Position - (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") or Vector3.zero).Position).Magnitude or 9999
                return aDist < bDist
            end)
        else
            table.sort(all, function(a,b) return a.Name < b.Name end)
        end
        local y = 0
        for _, p in ipairs(all) do
            local team = getPlayerTeam(p)
            local btnColor = team and (team.baseColor * 0.5) or Color3.fromRGB(0.2,0.3,0.6)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1,-5,0,34)
            btn.Position = UDim2.new(0,2,0,y)
            btn.Text = p.Name
            btn.BackgroundColor3 = btnColor
            btn.TextColor3 = Color3.new(1,1,1)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 13
            btn.Parent = playerList
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
            btn.MouseButton1Click:Connect(function()
                local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if root then SmartTP(root.CFrame * CFrame.new(0,0,2)) end
            end)
            y = y + 38
        end
        playerList.CanvasSize = UDim2.new(0,0,0,y)
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        searchFilter = searchBox.Text
        refreshPlayerList()
    end)

