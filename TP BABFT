        local transVal = guiTransparency * 100
        local transBtn = makeRow(getText("transparency"), math.floor(transVal).."%", function(btn)
            btn.MouseButton1Click:Connect(function()
                guiTransparency = (guiTransparency + 0.1) % 1.1
