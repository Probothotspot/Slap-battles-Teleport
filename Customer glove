-- ================== ЛОГИКА СТИЛЕЙ ==================
local function getCurrentGloveName()
    tool = char and char:FindFirstChildOfClass("Tool")
    return tool and tool.Name or nil
end

function applyStyleToCurrentGlove(styleId, color)
    local gloveName = getCurrentGloveName()
    if not gloveName then return end
    if not tool then return end

    -- Сохраняем в таблицу индивидуальный стиль для этой перчатки
    gloveStyles[gloveName] = {
        styleId = styleId,
        color = (styleId == 5) and color or nil
    }
    currentStyleId = styleId
    if styleId == 5 then currentCustomColor = color end

    -- Применяем визуал к текущей перчатке
    applyVisualStyle(tool, styleId, color)
end

function applyVisualStyle(targetTool, styleId, color)
    local handle = targetTool:FindFirstChild("Handle")
    if not handle then return end

    local parts = applyToAll and targetTool:GetDescendants() or {handle}
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") then
            part.Material = Enum.Material.SmoothPlastic
            if styleId == 1 then
                part.Color = Color3.new(1, 1, 1)
            elseif styleId == 2 then
                part.Material = Enum.Material.Metal
                part.Color = Color3.fromRGB(255, 215, 0)
            elseif styleId == 3 then
                part.Material = Enum.Material.Neon
                part.Color = Color3.fromRGB(0, 255, 255)
            elseif styleId == 4 then
                part.Material = Enum.Material.Neon
                local hue = tick() * 0.5 % 1
                local r, g, b = Color3.fromHSV(hue, 1, 1).R, Color3.fromHSV(hue, 1, 1).G, Color3.fromHSV(hue, 1, 1).B
                part.Color = Color3.fromRGB(r * 255, g * 255, b * 255)
            elseif styleId == 5 and color then
                part.Color = color
            end
        end
    end
end

function updateStyleButtons(activeStyleId)
    for i, btn in ipairs(styleBtns) do
        btn.BackgroundColor3 = (i == activeStyleId) and Color3.fromRGB(120, 60, 200) or Color3.fromRGB(50, 50, 70)
    end
end

-- Программная установка слайдеров (вызывается при переключении перчатки)
function updateSlidersForColor(color)
    if not color then return end
    local r = math.floor(color.R * 255)
    local g = math.floor(color.G * 255)
    local b = math.floor(color.B * 255)
    customRSlider.setValue(r)
    customGSlider.setValue(g)
    customBSlider.setValue(b)
    rLabel.Text = string.format("Цвет: R %d G %d B %d", r, g, b)
end

-- При переключении перчатки загружаем её стиль или ставим обычный
local function onGloveChanged(newTool)
    tool = newTool
    if not tool then return end
    local gloveName = tool.Name
    local saved = gloveStyles[gloveName]
    local styleId, color
    if saved then
        styleId = saved.styleId
        color = saved.color
    else
        -- По умолчанию обычный
        styleId = 1
        color = nil
        gloveStyles[gloveName] = { styleId = 1, color = nil }
    end

    currentStyleId = styleId
    if styleId == 5 then currentCustomColor = color or Color3.new(1,1,1)
    else currentCustomColor = Color3.new(1,1,1) end

    -- Обновляем GUI
    updateStyleButtons(styleId)
    if styleId == 5 then
        updateSlidersForColor(color or Color3.new(1,1,1))
    else
        -- Сбрасываем слайдеры в стандартное положение (просто визуально не меняем, но они могут остаться от предыдущего цвета; можно установить дефолт)
        updateSlidersForColor(Color3.new(1,1,1)) -- сброс на белый, чтобы не путать
    end

    -- Применяем визуал
    applyVisualStyle(tool, styleId, color)
end

-- Обработчики событий
LP.CharacterAdded:Connect(function(c)
    char = c
    task.wait(0.5)
    -- Проверяем, есть ли уже тул
    local existingTool = c:FindFirstChildOfClass("Tool")
    if existingTool then
        onGloveChanged(existingTool)
    end
    -- Следим за добавлением
    c.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            onGloveChanged(child)
        end
    end)
end)

-- Первоначальная инициализация
if char then
    local existingTool = char:FindFirstChildOfClass("Tool")
