-- Функция создания слайдера с возможностью программной установки
local function makeSlider(min, max, default, posY, colorCallback)
    local frame = Instance.new("Frame", inner)
    frame.Size = UDim2.new(0.8, -40, 0, 16)
    frame.Position = UDim2.new(0, 70, 0, posY)
    frame.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)

    local fill = Instance.new("Frame", frame)
    local knob = Instance.new("TextButton", frame)
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.Text = ""
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 8)

    local val = default
    local function setValue(newVal)
        val = math.clamp(newVal, min, max)
        local frac = (val - min) / (max - min)
        fill.Size = UDim2.new(frac, 0, 1, 0)
        knob.Position = UDim2.new(frac, -8, 0, 0)
        colorCallback()
    end

    fill.Size = UDim2.new((default-min)/(max-min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(150, 100, 255)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)
    knob.Position = UDim2.new((default-min)/(max-min), -8, 0, 0)

    knob.MouseButton1Down:Connect(function()
        local moveCon
        moveCon = RunService.RenderStepped:Connect(function()
            if not UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                moveCon:Disconnect()
                return
            end
            local relX = math.clamp(UserInput:GetMouseLocation().X - frame.AbsolutePosition.X, 0, frame.AbsoluteSize.X)
            local frac = relX / frame.AbsoluteSize.X
            val = min + frac * (max - min)
            fill.Size = UDim2.new(frac, 0, 1, 0)
            knob.Position = UDim2.new(frac, -8, 0, 0)
            colorCallback()
        end)
    end)

    return { frame = frame, fill = fill, knob = knob, setValue = setValue, getValue = function() return val end }
end

