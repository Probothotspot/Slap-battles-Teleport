-- Интервалы
local function setIntervalFromInput(inputBox, label, flag)
    local text = inputBox.Text:gsub(",", ".")
    local num = tonumber(text)
    if num and num > 0 then
        if flag == "E" then
            intervalE = num
            label.Text = "Интервал: " .. intervalE .. " сек"
            if autoEEnabled then lastE = 0 end
        else
            intervalClick = num
            label.Text = "Интервал: " .. intervalClick .. " сек"
            if autoClickEnabled then lastClick = 0 end
        end
        inputBox.Text = ""
    else
        inputBox.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
        task.wait(0.4)
        inputBox.BackgroundColor3 = Color3.fromRGB(45, 25, 65)
    end
end

setE.MouseButton1Click:Connect(function() setIntervalFromInput(inputE, intervalE_label, "E") end)
inputE.FocusLost:Connect(function(enterPressed)
    if enterPressed then setIntervalFromInput(inputE, intervalE_label, "E") end
end)

setClick.MouseButton1Click:Connect(function() setIntervalFromInput(inputClick, intervalClick_label, "Click") end)
inputClick.FocusLost:Connect(function(enterPressed)
    if enterPressed then setIntervalFromInput(inputClick, intervalClick_label, "Click") end
end)

-- Циклы с плавным таймером
local function autoLoop(interval, timerLabel, actionFn, activeFlag)
    local lastPress = (activeFlag == "E" and lastE) or lastClick
    while (activeFlag == "E" and autoEEnabled) or (activeFlag == "Click" and autoClickEnabled) do
        if not screenGui or not screenGui.Parent then return end
        local remaining = interval - (tick() - lastPress)
        while remaining > 0.05 do
            if not screenGui or not screenGui.Parent then return end
            remaining = interval - (tick() - lastPress)
            timerLabel.Text = string.format("До нажатия: %.1f сек", math.max(0, remaining))
            task.wait(0.05)
        end
        if remaining > 0 then
            task.wait(remaining)
        end
        if not ((activeFlag == "E" and autoEEnabled) or (activeFlag == "Click" and autoClickEnabled)) then break end
        if not screenGui or not screenGui.Parent then return end
        actionFn()
        lastPress = tick()
        if activeFlag == "E" then lastE = lastPress else lastClick = lastPress end
        timerLabel.Text = string.format("До нажатия: %.1f сек", interval)
    end
    timerLabel.Text = "До нажатия: --"
end

-- Вкл/выкл
local function toggleAction(flag, statusLabel, toggleBtn, loopFunc)
    local enabled
    if flag == "E" then
        autoEEnabled = not autoEEnabled
        enabled = autoEEnabled
        if enabled then lastE = 0 end
    else
        autoClickEnabled = not autoClickEnabled
        enabled = autoClickEnabled
        if enabled then lastClick = 0 end
    end

    if enabled then
        statusLabel.Text = "Статус: ВКЛ"
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        toggleBtn.Text = "Выключить " .. (flag == "E" and "авто-E" or "авто-удар")
        toggleBtn.BackgroundColor3 = Color3.fromRGB(160, 50, 70)
        task.spawn(loopFunc)
    else
        statusLabel.Text = "Статус: ВЫКЛ"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        toggleBtn.Text = "Включить " .. (flag == "E" and "авто-E" or "авто-удар")
        toggleBtn.BackgroundColor3 = Color3.fromRGB(100, 50, 170)
    end
end

