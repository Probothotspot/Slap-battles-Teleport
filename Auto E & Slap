-- Анимация сворачивания
local currentTween = nil
local function updateMinimized()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end

    local targetHeight = isMinimized and minimizedHeight or fullHeight
    local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(main, tweenInfo, { Size = UDim2.new(0, 280, 0, targetHeight) })

    if isMinimized then
        tabFrame.Visible = false
        containerE.Visible = false
        containerClick.Visible = false
        creditFrame.Visible = false
        footer.Visible = false
    else
        tabFrame.Visible = true
        if tabE.BackgroundColor3 == Color3.fromRGB(120, 70, 200) then
            containerE.Visible = true
            containerClick.Visible = false
        else
            containerE.Visible = false
            containerClick.Visible = true
        end
        creditFrame.Visible = true
        footer.Visible = true
    end

    minimizeBtn.Text = isMinimized and "+" or "–"

    tween:Play()
    currentTween = tween
    tween.Completed:Connect(function()
        currentTween = nil
    end)
end

minimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    updateMinimized()
end)

