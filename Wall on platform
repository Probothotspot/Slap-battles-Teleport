-- Простой локальный GUI для создания стены (поднятой на 20 studs)
print(">>> GUI Script started <<<")

local player = game:GetService("Players").LocalPlayer
if not player then
    warn("Игрок не найден, GUI не будет создан")
    return
end

local parentGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LocalWallGUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = parentGui

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 200, 0, 110)
mainFrame.Position = UDim2.new(0.5, -100, 0.4, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
mainFrame.BorderSizePixel = 1
mainFrame.Active = true
mainFrame.Parent = screenGui

local titleBar = Instance.new("Frame")
titleBar.Size = UDim2.new(1, 0, 0, 24)
titleBar.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
titleBar.BorderSizePixel = 0
titleBar.Parent = mainFrame

local titleText = Instance.new("TextLabel")
titleText.Size = UDim2.new(1, 0, 1, 0)
titleText.BackgroundTransparency = 1
titleText.Text = "Wall Builder (Local)"
titleText.Font = Enum.Font.SourceSans
titleText.TextColor3 = Color3.fromRGB(255, 255, 255)
titleText.TextSize = 14
titleText.Parent = titleBar

local createBtn = Instance.new("TextButton")
createBtn.Size = UDim2.new(1, -20, 0, 28)
createBtn.Position = UDim2.new(0, 10, 0, 32)
createBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
createBtn.Text = "Создать стену"
createBtn.Font = Enum.Font.SourceSans
createBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
createBtn.TextSize = 14
createBtn.Parent = mainFrame

local deleteBtn = Instance.new("TextButton")
deleteBtn.Size = UDim2.new(1, -20, 0, 28)
deleteBtn.Position = UDim2.new(0, 10, 0, 65)
deleteBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
deleteBtn.Text = "Удалить стену"
deleteBtn.Font = Enum.Font.SourceSans
deleteBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
deleteBtn.TextSize = 14
deleteBtn.Parent = mainFrame

local hint = Instance.new("TextLabel")
hint.Size = UDim2.new(1, -20, 0, 18)
hint.Position = UDim2.new(0, 10, 0, 95)
hint.BackgroundTransparency = 1
hint.Text = "P = скрыть"
hint.Font = Enum.Font.SourceSans
hint.TextColor3 = Color3.fromRGB(180, 180, 180)
hint.TextSize = 12
hint.Parent = mainFrame

-- Перетаскивание
local UserInputService = game:GetService("UserInputService")
local dragging = false
local dragStartPos, frameStartPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStartPos = UserInputService:GetMouseLocation()
        frameStartPos = mainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = UserInputService:GetMouseLocation() - dragStartPos
        mainFrame.Position = UDim2.new(
            frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- Локальная стена (поднята на 20 studs)
local POINT = Vector3.new(-5, -12385, 20.4)   -- <-- изменено здесь
local WALL_HEIGHT = 50
local WALL_LENGTH = 20
local WALL_THICKNESS = 1

local wallParts = {}

local function createLocalWalls()
    for _, part in ipairs(wallParts) do
        part:Destroy()
    end
    wallParts = {}

    local centerY = POINT.Y

    local wallX = Instance.new("Part")
    wallX.Name = "LocalWallX"
    wallX.Size = Vector3.new(WALL_LENGTH, WALL_HEIGHT, WALL_THICKNESS)
    wallX.CFrame = CFrame.new(
        POINT.X + WALL_LENGTH/2,
        centerY,
        POINT.Z + WALL_THICKNESS/2
    )
    wallX.Anchored = true
    wallX.Material = Enum.Material.Concrete
    wallX.BrickColor = BrickColor.new("Medium stone grey")
    wallX.Parent = workspace
    table.insert(wallParts, wallX)

    local wallZ = Instance.new("Part")
    wallZ.Name = "LocalWallZ"
    wallZ.Size = Vector3.new(WALL_THICKNESS, WALL_HEIGHT, WALL_LENGTH)
    wallZ.CFrame = CFrame.new(
        POINT.X - WALL_THICKNESS/2,
        centerY,
        POINT.Z + WALL_LENGTH/2
    )
    wallZ.Anchored = true
    wallZ.Material = Enum.Material.Concrete
    wallZ.BrickColor = BrickColor.new("Medium stone grey")
    wallZ.Parent = workspace
    table.insert(wallParts, wallZ)
end

local function deleteLocalWalls()
    for _, part in ipairs(wallParts) do
        part:Destroy()
    end
    wallParts = {}
end

createBtn.MouseButton1Click:Connect(createLocalWalls)
deleteBtn.MouseButton1Click:Connect(deleteLocalWalls)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.P then
        deleteLocalWalls()
        screenGui:Destroy()
        print("GUI удалён, стены убраны")
    end
end)

print(">>> GUI успешно создан <<<")
