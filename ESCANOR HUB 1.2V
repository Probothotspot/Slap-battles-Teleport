    local function startSequentialTeleport(waypoints)
        task.spawn(function()
            for i, cf in ipairs(waypoints) do
                local myChar = LP.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myHrp then myHrp.CFrame = cf end
                task.wait(1)
            end
        end)
    end

    -- ========== ТЕЛЕПОРТАЦИЯ ==========
    local function SmartTP(targetCF)
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not (char and hrp) then return end
        local distance = (targetCF.Position - hrp.Position).Magnitude
        if distance < 5 then return end
        if loadingFrame then loadingFrame.Visible = true end
        local duration = distance / teleportSpeed
        local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCF})
        tween:Play()
        tween.Completed:Wait()
        for i = 1, math.random(2,4) do
            hrp.CFrame = hrp.CFrame + Vector3.new(math.random(-50,50)/100, math.random(-20,20)/100, math.random(-50,50)/100)
            task.wait(0.01)
        end
        hrp.CFrame = targetCF
        if loadingFrame then loadingFrame.Visible = false end
        addHistoryEntry("Coordinates", targetCF)
    end

    local function teleportToPlate()
        -- Оптимизированный поиск тарелки — ищем по имени сначала (быстро)
        local plate = nil
        -- Быстрый поиск по имени
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("BasePart") and (v.Name == "MovingPlate" or v.Name:lower():find("plate")) then
                plate = v
                break
            end
            if v:IsA("Model") then
                local found = v:FindFirstChild("MovingPlate")
                if found and found:IsA("BasePart") then plate = found break end
                for _, child in pairs(v:GetChildren()) do
                    if child:IsA("BasePart") and child.Name:lower():find("plate") then
                        plate = child break
                    end
                end
                if plate then break end
            end
        end
        -- Если не нашли — расширенный поиск в координатной области
        if not plate then
            local minX, maxX = -293, 291
            local minY, maxY = -10, 10
            local minZ, maxZ = -293, 288
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    local p = v.Position
                    if p.X > minX and p.X < maxX and p.Y > minY and p.Y < maxY and p.Z > minZ and p.Z < maxZ then
                        if v.Name:lower():find("plate") or v.Name:lower():find("move") then
                            plate = v break
                        end
                    end
                end
            end
        end
        if plate then
            -- ТП в точный центр тарелки (используем CFrame центра + небольшой сдвиг вверх)
            local centerCF = plate.CFrame * CFrame.new(0, plate.Size.Y/2 + 3, 0)
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = centerCF end
        else
            showNotification("🛸 " .. getText("plate_location") .. " not found", 2)
        end
    end

    local function parseNumber(str)
        return tonumber(string.gsub(str, ",", "."))
    end

    local function addCurrentLocation()
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local pos = hrp.Position
        local name = string.format("Saved #%d [%d, %d, %d]", #locations + 1, math.floor(pos.X), math.floor(pos.Y), math.floor(pos.Z))
        table.insert(locations, {name = name, cframe = hrp.CFrame, isDefault = false})
        -- Мгновенно обновить список локаций — кнопка Save сдвинется вниз
        refreshLocationsList()
        -- Прокрутить к новой локации
        if locationListFrame and locationListFrame.Parent and locationListFrame.Parent:IsA("ScrollingFrame") then
            local scroll = locationListFrame.Parent
            local btnH = isMobile and 30 or 36
            local targetY = (#locations - 1) * (btnH + 6)
            TweenService:Create(scroll, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {CanvasPosition = Vector2.new(0, math.max(0, targetY - 50))}):Play()
        end
    end

    local function teleportToCoordinates(inputText)
        if not inputText or inputText == "" then return end
        local x,y,z = nil,nil,nil
        for num in string.gmatch(inputText, "[-]?%d+[.]?%d*") do
            if x == nil then x = parseNumber(num)
            elseif y == nil then y = parseNumber(num)
            elseif z == nil then z = parseNumber(num)
            else break end
        end
        if x and y and z then
            SmartTP(CFrame.new(x,y,z) * CFrame.new(0,0,2))
        else
            LP:Chat(getText("invalid_coords"))
        end
    end

    local function updateCoordsLabel()
        if not coordsLabel then return end
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local pos = hrp.Position
            coordsLabel.Text = string.format("📍 X: %.1f, Y: %.1f, Z: %.1f", pos.X, pos.Y, pos.Z)
        else
            coordsLabel.Text = "📍 Ожидание персонажа..."
        end
    end

    local function getDistanceToPlayer(p)
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return 1e9 end
        local tChar = p.Character
        local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not tHrp then return 1e9 end
        return (hrp.Position - tHrp.Position).Magnitude
    end

    -- Таблица для хранения связей кнопка -> игрок (для обновления дистанции)
    local btnPlayerMap = {}

    local function refreshButtons()
        if not bc then return end
        for _, v in ipairs(btns) do v:Destroy() end
        btns = {}
        btnPlayerMap = {}
        local playersList = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and (searchFilter == "" or string.find(string.lower(p.Name), string.lower(searchFilter))) then
                table.insert(playersList, p)
            end
        end
        -- Всегда сортируем по дистанции (ByDist + ByName совмещены)
        table.sort(playersList, function(a,b) return getDistanceToPlayer(a) < getDistanceToPlayer(b) end)
        for _, p in ipairs(playersList) do
            local dist = getDistanceToPlayer(p)
            local distText = (dist < 1000) and string.format(" (%.0fm)", dist) or string.format(" (%.1fkm)", dist/1000)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -10, 0, isMobile and 24 or 36)
            btn.Position = UDim2.new(0, 5, 0, 0)
            btn.Text = p.Name .. distText
            btn.TextColor3 = Color3.new(1,1,1)
            btn.TextSize = isMobile and 10 or 14
            btn.Font = Enum.Font.GothamSemibold
            btn.BackgroundColor3 = Color3.new(1,0,0)
            btn.BackgroundTransparency = 0.2
            btn.BorderSizePixel = 0
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0,6)
            corner.Parent = btn
            btn.Parent = bc
            btnPlayerMap[btn] = p
            btn.MouseButton1Click:Connect(function()
                if autoTeleportActive then
                    if autoTargetPlayer == p then stopAutoTeleport() else startAutoTeleport(p) end
                else
                    local tChar = p.Character
                    if tChar and tChar:FindFirstChild("HumanoidRootPart") then
                        local targetCF = tChar.HumanoidRootPart.CFrame * CFrame.new(0,0,playerTPOffset)
                        SmartTP(targetCF)
                        addHistoryEntry(p.Name, tChar.HumanoidRootPart.CFrame)
                    end
                    autoTargetPlayer = p
                end
            end)
            table.insert(btns, btn)
        end
        local th = #btns * ((isMobile and 24 or 36) + (lay and lay.Padding.Offset or 6)) + 50
        if lf then lf.CanvasSize = UDim2.new(0,0,0,th) end
    end

    -- Обновление дистанции на кнопках игроков в реальном времени (без пересоздания)
    local function updatePlayerDistances()
        for btn, p in pairs(btnPlayerMap) do
            if btn and btn.Parent and p and p.Parent then
                local dist = getDistanceToPlayer(p)
                local distText = (dist < 1000) and string.format(" (%.0fm)", dist) or string.format(" (%.1fkm)", dist/1000)
                btn.Text = p.Name .. distText
            end
        end
    end

    -- Переменная для instant-teleport на локации
    local autoLocationCFrame = nil
    local autoLocationName = nil

    local function stopAutoTeleport()
        if autoLoopConnection then autoLoopConnection:Disconnect() end
        autoLoopConnection = nil
        autoTeleportActive = false
        autoTargetPlayer = nil
        autoLocationCFrame = nil
        autoLocationName = nil
        if instantBtn then
            instantBtn.BackgroundColor3 = Color3.new(0.3,0.3,0.3)
            instantBtn.Text = "🎯"
        end
        showNotification(getText("auto_off"), 1.5)
    end

    local function startAutoTeleport(targetPlayer)
        if not targetPlayer then return end
        autoTargetPlayer = targetPlayer
        autoLocationCFrame = nil
        autoLocationName = nil
        autoTeleportActive = true
        if autoLoopConnection then autoLoopConnection:Disconnect() end
        autoLoopConnection = RunService.Heartbeat:Connect(function()
            if autoTeleportActive and autoTargetPlayer and autoTargetPlayer.Character and autoTargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local targetCF = autoTargetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0,0,playerTPOffset)
                local myChar = LP.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myHrp then myHrp.CFrame = targetCF end
            end
        end)
        if instantBtn then
            instantBtn.BackgroundColor3 = Color3.new(0,0.7,0)
            instantBtn.Text = "✅"
        end
        showNotification("🎯 " .. getText("auto_on") .. ": " .. targetPlayer.Name, 2)
    end

    -- Instant-teleport на локацию (бесконечный ТП к точке)
    local function startAutoTeleportLocation(cframe, name)
        autoTargetPlayer = nil
        autoLocationCFrame = cframe
        autoLocationName = name or "Location"
        autoTeleportActive = true
        if autoLoopConnection then autoLoopConnection:Disconnect() end
        autoLoopConnection = RunService.Heartbeat:Connect(function()
            if autoTeleportActive and autoLocationCFrame then
                local myChar = LP.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myHrp then myHrp.CFrame = autoLocationCFrame end
            end
        end)
        if instantBtn then
            instantBtn.BackgroundColor3 = Color3.new(0,0.7,0)
            instantBtn.Text = "✅"
        end
        showNotification("📍 " .. getText("auto_on") .. ": " .. autoLocationName, 2)
    end

    -- ========== ПРИМЕНЕНИЕ ТЕМЫ ==========
    local function applyTheme(themeName)
        local t = themes[themeName] or themes["dark"]
        currentTheme = themeName
        if mainFrame then
            mainFrame.BackgroundColor3 = t.mainBg
        end
        -- Обновить переливание рамки под новую тему
        if themeElements.mainStroke then
            themeElements.mainStroke.Color = getShimmerColor(t, 0)
        end
        if themeElements.topStroke then
            themeElements.topStroke.Color = getShimmerColorOffset(t, 0, 1.0)
        end
        if themeElements.mainGradient then
            themeElements.mainGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, t.mainGradStart),
                ColorSequenceKeypoint.new(1, t.mainGradEnd)
            }
        end
        if themeElements.topBar then themeElements.topBar.BackgroundColor3 = t.topBg end
        if themeElements.topGradient then
            themeElements.topGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, t.topGradStart),
                ColorSequenceKeypoint.new(1, t.topGradEnd)
            }
        end
        for _, element in ipairs(themeElements.textElements or {}) do
            if element and element.Parent then
                element.TextColor3 = t.textColor
            end
        end
        if themeElements.tabPlayers then themeElements.tabPlayers.BackgroundColor3 = (currentTab=="players") and t.tabActive or t.tabInactive end
        if themeElements.tabLocations then themeElements.tabLocations.BackgroundColor3 = (currentTab=="locations") and t.tabActive or t.tabInactive end
        if themeElements.tabPlaces then themeElements.tabPlaces.BackgroundColor3 = (currentTab=="places") and t.tabActive or t.tabInactive end
        if themeElements.tabHelp then themeElements.tabHelp.BackgroundColor3 = (currentTab=="help") and t.tabActive or t.tabInactive end
        if themeElements.tabFavorites then themeElements.tabFavorites.BackgroundColor3 = (currentTab=="favorites") and t.tabActive or t.tabInactive end
        if themeElements.tabHistory then themeElements.tabHistory.BackgroundColor3 = (currentTab=="history") and t.tabActive or t.tabInactive end
        if themeElements.tabOther then themeElements.tabOther.BackgroundColor3 = (currentTab=="other") and t.tabActive or t.tabInactive end
        if themeElements.searchBox then themeElements.searchBox.TextColor3 = t.textColor end
        if themeElements.locSearchBox then themeElements.locSearchBox.TextColor3 = t.textColor end
        if themeElements.sortBtn then themeElements.sortBtn.TextColor3 = t.textColor end
        if themeElements.helpTitle then themeElements.helpTitle.TextColor3 = t.textColor end
        if themeElements.helpText then themeElements.helpText.TextColor3 = t.textColor end
    end

    -- ===== ПЛАВАЮЩАЯ ИКОНКА =====
    local function createFloatingIcon()
        if floatingGui then return end
        floatingGui = Instance.new("ScreenGui")
        floatingGui.Name = "FloatingIcon"
        floatingGui.ResetOnSpawn = false
        floatingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        pcall(function() floatingGui.Parent = game:GetService("CoreGui") end)
        if not floatingGui.Parent then
            floatingGui.Parent = LP:WaitForChild("PlayerGui")
        end

        local btnSize = isMobile and 40 or 48
        floatingButton = Instance.new("TextButton")
        floatingButton.Size = UDim2.new(0, btnSize, 0, btnSize)
        floatingButton.Position = UDim2.new(0.05, 0, 0.5, -btnSize/2)
        floatingButton.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
        floatingButton.Text = "🚀"
        floatingButton.TextColor3 = Color3.new(1, 1, 1)
        floatingButton.TextSize = isMobile and 22 or 28
        floatingButton.Font = Enum.Font.GothamBold
        floatingButton.Draggable = true

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = floatingButton

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2
        stroke.Color = Color3.fromRGB(0, 255, 255)
        stroke.Parent = floatingButton

        floatingButton.Parent = floatingGui

        -- Анимация появления плавающей кнопки
        floatingButton.Size = UDim2.new(0, 0, 0, 0)
        floatingButton.BackgroundTransparency = 1
        TweenService:Create(floatingButton, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, btnSize, 0, btnSize),
            BackgroundTransparency = 0
        }):Play()

        floatingButton.MouseButton1Click:Connect(function()
            -- Анимация пульса при нажатии
            TweenService:Create(floatingButton, TweenInfo.new(0.1), {Size = UDim2.new(0, btnSize+8, 0, btnSize+8)}):Play()
            task.delay(0.12, function()
                if floatingButton and floatingButton.Parent then
                    TweenService:Create(floatingButton, TweenInfo.new(0.15, Enum.EasingStyle.Back), {Size = UDim2.new(0, btnSize, 0, btnSize)}):Play()
                end
            end)
            -- Эмулируем нажатие K — toggle GUI
            if mainFrame then
                mainFrame.Visible = not mainFrame.Visible
                if mainFrame.Visible then
                    -- Восстановить размер и позицию
                    local guiW = isMobile and 210 or 360
                    local guiH = isMinimized and ((isMobile and 28 or 40) + 4) or originalHeight
                    mainFrame.Size = UDim2.new(0, guiW, 0, guiH)
                    mainFrame.Position = UDim2.new(0.5, -guiW/2, 0.5, -guiH/2)
                    mainFrame.BackgroundTransparency = guiTransparency
                end
            end
        end)
    end

    -- ===== АНИМАЦИЯ ПОЯВЛЕНИЯ/СКРЫТИЯ GUI =====
    local guiAnimating = false

    local function animateIn(frame, callback)
        if not frame or guiAnimating then return end
        guiAnimating = true
        frame.Visible = true
        frame.BackgroundTransparency = 1
        local guiW = isMobile and 210 or 360
        local guiH = isMinimized and ((isMobile and 28 or 40) + 4) or originalHeight
        local targetSize = UDim2.new(0, guiW, 0, guiH)
        frame.Size = UDim2.new(0, guiW * 0.85, 0, guiH * 0.85)
        frame.Position = UDim2.new(0.5, -guiW*0.425, 0.5, -guiH*0.425)
        local tw1 = TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = targetSize,
            Position = UDim2.new(0.5, -guiW/2, 0.5, -guiH/2),
            BackgroundTransparency = guiTransparency
        })
        tw1:Play()
        tw1.Completed:Connect(function()
            guiAnimating = false
            if callback then callback() end
        end)
    end

    local function animateOut(frame, callback)
        if not frame or guiAnimating then return end
        guiAnimating = true
        local guiW = isMobile and 210 or 360
        local guiH = isMinimized and ((isMobile and 28 or 40) + 4) or originalHeight
        local tw = TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, guiW * 0.85, 0, guiH * 0.85),
            Position = UDim2.new(0.5, -guiW*0.425, 0.5, -guiH*0.425)
        })
        tw:Play()
        tw.Completed:Connect(function()
            frame.Visible = false
            frame.Size = UDim2.new(0, guiW, 0, guiH)
            frame.Position = UDim2.new(0.5, -guiW/2, 0.5, -guiH/2)
            frame.BackgroundTransparency = guiTransparency
            guiAnimating = false
            if callback then callback() end
        end)
    end

    -- Анимация появления элемента (для кнопок, вкладок)
    local function animateElement(element, delay)
        if not element then return end
        local origTrans = element.BackgroundTransparency
        element.BackgroundTransparency = 1
        if element:IsA("TextLabel") or element:IsA("TextButton") or element:IsA("TextBox") then
            local origTextTrans = element.TextTransparency
            element.TextTransparency = 1
            task.delay(delay or 0, function()
                if not element or not element.Parent then return end
                TweenService:Create(element, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
                    BackgroundTransparency = origTrans,
                    TextTransparency = origTextTrans
                }):Play()
            end)
        else
            task.delay(delay or 0, function()
                if not element or not element.Parent then return end
                TweenService:Create(element, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
                    BackgroundTransparency = origTrans
                }):Play()
            end)
        end
    end

    -- Всплывающее уведомление
    local function showNotification(text, duration)
        if not sg then return end
        local notif = Instance.new("TextLabel")
        notif.Size = UDim2.new(0, 250, 0, 35)
        notif.Position = UDim2.new(0.5, -125, 0, -40)
        notif.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        notif.BackgroundTransparency = 0.1
        notif.Text = text
        notif.TextColor3 = Color3.new(1,1,1)
        notif.TextSize = 13
        notif.Font = Enum.Font.GothamBold
        notif.BorderSizePixel = 0
        Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 8)
        notif.Parent = sg
        -- Появление сверху
        TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, -125, 0, 10)
        }):Play()
        -- Исчезновение
        task.delay(duration or 2, function()
            if notif and notif.Parent then
                local tw = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
                    Position = UDim2.new(0.5, -125, 0, -40),
                    BackgroundTransparency = 1,
                    TextTransparency = 1
                })
                tw:Play()
                tw.Completed:Connect(function()
                    if notif and notif.Parent then notif:Destroy() end
                end)
            end
        end)
    end

    local function showMainGUI()
        if mainFrame and not guiAnimating then
            mainFrame.Visible = true
            local guiW = isMobile and 210 or 360
            local guiH = isMinimized and ((isMobile and 28 or 40) + 4) or originalHeight
            mainFrame.Size = UDim2.new(0, guiW, 0, guiH)
            mainFrame.Position = UDim2.new(0.5, -guiW/2, 0.5, -guiH/2)
            mainFrame.BackgroundTransparency = guiTransparency
        end
    end

    local function hideMainGUI()
        if mainFrame and not guiAnimating then
            mainFrame.Visible = false
        end
    end

    local function destroyGUI()
        if guiDestroyed then return end
        guiDestroyed = true
        _G.EscanorHubClosed = true
        _G.EscanorHubAlreadyRunning = nil -- Разрешить повторный запуск через loadstring
        if sg then sg:Destroy() end
        sg = nil; mainFrame = nil; btns = {}; locationBtns = {}
        if settingsPanel then settingsPanel:Destroy() end
        settingsPanel = nil
        settingsOpen = false
        if connection then connection:Disconnect() end
        connection = nil
        if sortTimer then sortTimer:Disconnect() end
        sortTimer = nil
        if floatingGui then floatingGui:Destroy(); floatingGui = nil; floatingButton = nil end
        if antiAFKConnection then stopAntiAFK() end
        if fpsConnection then stopFPS() end
        stopFullbright()
        stopCoordsDisplay()
        stopTimer()
        _G.TeleportHubSettings = nil
        _G.FavoriteLocations = nil
        _G.TeleportHistory = nil
        _G.AntiAFKEnabled = false
        _G.ShowFPS = false
        _G.FPSPosition = UDim2.new(0,5,0,5)
        _G.FullbrightEnabled = false
        _G.CoordsDisplayEnabled = false
        _G.TimerEnabled = false
    end

    -- ========== ОБНОВЛЕНИЕ СПИСКА ЛОКАЦИЙ (с анимациями) ==========
    local function refreshLocationsList()
        if not locationListFrame then return end
        for _, v in ipairs(locationBtns) do v:Destroy() end
        locationBtns = {}

        local filteredLocs = {}
        for _, loc in ipairs(locations) do
            if locationSearchFilter == "" or string.find(string.lower(getLocalizedLocationName(loc.name)), string.lower(locationSearchFilter)) then
                table.insert(filteredLocs, loc)
            end
        end

        for i, loc in ipairs(filteredLocs) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -40, 0, isMobile and 30 or 36)
            btn.Position = UDim2.new(0, 5, 0, 0)
            local displayName = getLocalizedLocationName(loc.name)
            if loc.waypoints then displayName = displayName .. " (sequence)" end
            if isMobile then
                btn.Text = displayName
            else
                btn.Text = displayName .. (loc.cframe and (" [" .. math.floor(loc.cframe.X) .. ", " .. math.floor(loc.cframe.Y) .. ", " .. math.floor(loc.cframe.Z) .. "]") or "")
            end
            btn.TextColor3 = Color3.new(1,1,1)
            btn.TextSize = isMobile and 10 or 13
            btn.Font = Enum.Font.GothamSemibold
            btn.BackgroundColor3 = Color3.new(0.2,0.5,0.8)
            btn.BackgroundTransparency = 1
            btn.TextTransparency = 1
            btn.BorderSizePixel = 0
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0,6)
            corner.Parent = btn
            btn.Parent = locationListFrame

            -- Анимация появления каждой кнопки локации
            local delay = math.min(i * 0.03, 0.5)
            task.delay(delay, function()
                if btn and btn.Parent then
                    TweenService:Create(btn, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundTransparency = 0.2,
                        TextTransparency = 0
                    }):Play()
                end
            end)

            -- Анимация нажатия
            btn.MouseButton1Down:Connect(function()
                if btn and btn.Parent then
                    TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(1, -44, 0, (isMobile and 30 or 36) - 2)}):Play()
                end
            end)
            btn.MouseButton1Up:Connect(function()
                if btn and btn.Parent then
                    TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Back), {Size = UDim2.new(1, -40, 0, isMobile and 30 or 36)}):Play()
                end
            end)

            local favBtn = Instance.new("TextButton")
            favBtn.Size = UDim2.new(0, 22, 0, 22)
            favBtn.Position = UDim2.new(1, -28, 0.5, -11)
            favBtn.Text = table.find(favorites, loc.name) and "★" or "☆"
            favBtn.TextColor3 = Color3.new(1, 1, 0)
            favBtn.TextSize = 16
            favBtn.Font = Enum.Font.GothamBold
            favBtn.BackgroundColor3 = Color3.fromRGB(0,0,0)
            favBtn.BackgroundTransparency = 0.6
            favBtn.BorderSizePixel = 0
            local favCorner = Instance.new("UICorner")
            favCorner.CornerRadius = UDim.new(0, 5)
            favCorner.Parent = favBtn
            favBtn.Parent = btn
            favBtn.MouseButton1Click:Connect(function()
                -- Анимация звезды
                TweenService:Create(favBtn, TweenInfo.new(0.15, Enum.EasingStyle.Back), {
                    Size = UDim2.new(0, 28, 0, 28),
                    Position = UDim2.new(1, -31, 0.5, -14)
                }):Play()
                task.delay(0.15, function()
                    if favBtn and favBtn.Parent then
                        TweenService:Create(favBtn, TweenInfo.new(0.15), {
                            Size = UDim2.new(0, 22, 0, 22),
                            Position = UDim2.new(1, -28, 0.5, -11)
                        }):Play()
                    end
                end)
                local idx = table.find(favorites, loc.name)
                if idx then
                    table.remove(favorites, idx)
                else
                    table.insert(favorites, loc.name)
                end
                _G.FavoriteLocations = favorites
                task.delay(0.2, function() refreshLocationsList() end)
            end)

            if not loc.isDefault then
                local delBtn = Instance.new("TextButton")
                delBtn.Size = UDim2.new(0, 22, 0, 22)
                delBtn.Position = UDim2.new(1,-54,0.5,-11)
                delBtn.Text = "X"
                delBtn.TextColor3 = Color3.new(1,1,1)
                delBtn.TextSize = 10
                delBtn.BackgroundColor3 = Color3.new(0.5,0.1,0.1)
                delBtn.BorderSizePixel = 0
                local delCorner = Instance.new("UICorner")
                delCorner.CornerRadius = UDim.new(0,5)
                delCorner.Parent = delBtn
                delBtn.Parent = btn
                delBtn.MouseButton1Click:Connect(function()
                    -- Анимация удаления — сжатие и исчезновение
                    TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        BackgroundTransparency = 1,
                        TextTransparency = 1,
                        Size = UDim2.new(1, -40, 0, 0)
                    }):Play()
                    task.delay(0.25, function()
                        table.remove(locations, table.find(locations, loc))
                        refreshLocationsList()
                    end)
                end)
            end

            btn.MouseButton1Click:Connect(function()
                -- Подсветка при нажатии — вспышка
                local origColor = btn.BackgroundColor3
                TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.new(1,1,1)}):Play()
                task.delay(0.1, function()
                    if btn and btn.Parent then
                        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = origColor}):Play()
                    end
                end)
                -- Если instant-teleport активен — привязать к этой локации
                if autoTeleportActive then
                    if loc.cframe then
                        startAutoTeleportLocation(loc.cframe * CFrame.new(0,0,2), getLocalizedLocationName(loc.name))
                    end
                else
                    if loc.waypoints then
                        startSequentialTeleport(loc.waypoints)
                    elseif loc.cframe then
                        if loc.name == "Plate" then
                            teleportToPlate()
                        else
                            SmartTP(loc.cframe * CFrame.new(0,0,2))
                        end
                    end
                end
                addHistoryEntry(loc.name, loc.cframe)
            end)
            table.insert(locationBtns, btn)
        end

        -- Кнопка "Сохранить текущее место" — всегда внизу списка
        local addLocBtn = Instance.new("TextButton")
        addLocBtn.Size = UDim2.new(1, -10, 0, isMobile and 30 or 36)
        addLocBtn.Position = UDim2.new(0, 5, 0, 0)
        addLocBtn.Text = getText("save_loc")
        addLocBtn.TextColor3 = Color3.new(1,1,1)
        addLocBtn.TextSize = isMobile and 10 or 13
        addLocBtn.Font = Enum.Font.GothamSemibold
        addLocBtn.BackgroundColor3 = Color3.new(0.1,0.5,0.1)
        addLocBtn.BackgroundTransparency = 0.2
        addLocBtn.BorderSizePixel = 0
        local addCorner = Instance.new("UICorner")
        addCorner.CornerRadius = UDim.new(0,6)
        addCorner.Parent = addLocBtn
        addLocBtn.Parent = locationListFrame
        addLocBtn.MouseButton1Click:Connect(function()
            -- Анимация нажатия Save
            TweenService:Create(addLocBtn, TweenInfo.new(0.1), {
                BackgroundColor3 = Color3.new(0.3, 0.9, 0.3),
                Size = UDim2.new(1, -14, 0, (isMobile and 30 or 36) - 2)
            }):Play()
            task.delay(0.12, function()
                if addLocBtn and addLocBtn.Parent then
                    TweenService:Create(addLocBtn, TweenInfo.new(0.15, Enum.EasingStyle.Back), {
                        BackgroundColor3 = Color3.new(0.1, 0.5, 0.1),
                        Size = UDim2.new(1, -10, 0, isMobile and 30 or 36)
                    }):Play()
                end
            end)
            addCurrentLocation()
            showNotification(getText("pos_saved"), 1.5)
        end)
        table.insert(locationBtns, addLocBtn)

        local th = #locationBtns * ((isMobile and 30 or 36) + 6) + 50
        local scroll = locationListFrame.Parent
        if scroll and scroll:IsA("ScrollingFrame") then scroll.CanvasSize = UDim2.new(0,0,0,th) end
    end

    -- ===== НАСТРОЙКИ (полноэкранная панель внутри GUI) =====
    local settingsOpen = false
    local settingsPanel = nil

    local function createSettingsWindow()
        -- Если уже открыта — закрыть с анимацией
        if settingsOpen and settingsPanel and settingsPanel.Parent then
            TweenService:Create(settingsPanel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(1, 0, 0, 0)
            }):Play()
            task.delay(0.3, function()
                if settingsPanel and settingsPanel.Parent then settingsPanel:Destroy() end
                settingsPanel = nil
                settingsOpen = false
            end)
            return
        end

        settingsOpen = true
        settingsPanel = Instance.new("Frame")
        settingsPanel.Size = UDim2.new(1, 0, 1, 0)
        settingsPanel.Position = UDim2.new(1, 0, 0, 0) -- начинаем за правым краем
        settingsPanel.BackgroundColor3 = Color3.fromRGB(18, 18, 30)
        settingsPanel.BackgroundTransparency = 0.02
        settingsPanel.BorderSizePixel = 0
        settingsPanel.ZIndex = 10
        settingsPanel.ClipsDescendants = true
        settingsPanel.Parent = mainFrame

        -- Анимация выезда слева
        TweenService:Create(settingsPanel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0)
        }):Play()

        -- Кнопка "Назад"
        local backBtn = Instance.new("TextButton")
        backBtn.Size = UDim2.new(1, 0, 0, isMobile and 28 or 36)
        backBtn.Position = UDim2.new(0, 0, 0, 0)
        backBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
        backBtn.BorderSizePixel = 0
        backBtn.Text = "< " .. getText("settings_title")
        backBtn.TextColor3 = Color3.new(1,1,1)
        backBtn.TextSize = isMobile and 12 or 15
        backBtn.Font = Enum.Font.GothamBold
        backBtn.TextXAlignment = Enum.TextXAlignment.Left
        backBtn.ZIndex = 11
        Instance.new("UICorner", backBtn).CornerRadius = UDim.new(0, 8)
        local backPad = Instance.new("UIPadding", backBtn)
        backPad.PaddingLeft = UDim.new(0, 10)
        backBtn.Parent = settingsPanel

        backBtn.MouseButton1Click:Connect(function()
            TweenService:Create(settingsPanel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(1, 0, 0, 0)
            }):Play()
            task.delay(0.3, function()
                if settingsPanel and settingsPanel.Parent then settingsPanel:Destroy() end
                settingsPanel = nil
                settingsOpen = false
            end)
        end)

        local scroll = Instance.new("ScrollingFrame")
        scroll.Size = UDim2.new(1, -10, 1, -(isMobile and 34 or 42))
        scroll.Position = UDim2.new(0, 5, 0, isMobile and 32 or 40)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ZIndex = 11
        scroll.ScrollBarThickness = 3
        scroll.Parent = settingsPanel

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 10)
        layout.Parent = scroll

        local function makeRow(text, btnText, onClick, height)
            local fr = Instance.new("Frame")
            fr.Size = UDim2.new(1, 0, 0, height or 36)
            fr.BackgroundTransparency = 1
            fr.ZIndex = 12
            fr.Parent = scroll
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.55, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = Color3.new(1,1,1)
            lbl.TextSize = isMobile and 11 or 12
            lbl.Font = Enum.Font.Gotham
            lbl.ZIndex = 12
            lbl.Parent = fr
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0.35, 0, 1, 0)
            btn.Position = UDim2.new(0.6, 0, 0, 0)
            btn.Text = btnText
            btn.TextColor3 = Color3.new(0,0,0)
            btn.BackgroundColor3 = Color3.new(1,1,1)
            btn.BorderSizePixel = 0
            btn.ZIndex = 12
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 5)
            btnCorner.Parent = btn
            btn.Parent = fr
            onClick(btn)
            return btn
        end

        local sizeText = {getText("small"), getText("medium"), getText("large")}
        local sizeIdx = 2
        makeRow(getText("gui_size"), sizeText[sizeIdx], function(btn)
            btn.MouseButton1Click:Connect(function()
                sizeIdx = sizeIdx % 3 + 1
                btn.Text = sizeText[sizeIdx]
                local w,h = 350,400
                if sizeIdx == 1 then w,h=250,300 elseif sizeIdx == 2 then w,h=350,400 else w,h=450,480 end
                if isMobile then h = 250 end
                mainFrame.Size = UDim2.new(0,w,0,h)
                mainFrame.Position = UDim2.new(0.5,-w/2,0.5,-h/2)
                originalHeight = h
                refreshButtons(); refreshLocationsList()
            end)
        end, 36)

        local transVal = guiTransparency
        makeRow(getText("transparency"), math.floor(transVal*100).."%", function(btn)
            btn.MouseButton1Click:Connect(function()
                transVal = (transVal+0.1)%1.1
                if transVal>1 then transVal=0 end
                btn.Text = math.floor(transVal*100).."%"
                mainFrame.BackgroundTransparency = transVal
                guiTransparency = transVal
            end)
        end, 36)

        local speeds = {10000,25000,50000,100000,200000}
        local spIdx = 3
        makeRow(getText("speed"), tostring(teleportSpeed).." stud/s", function(btn)
            btn.MouseButton1Click:Connect(function()
                spIdx = spIdx%5+1
                teleportSpeed = speeds[spIdx]
                btn.Text = tostring(teleportSpeed).." stud/s"
            end)
        end, 36)

        local themesList = {"dark", "light", "pink", "green", "blue"}
        local themeIdx = 1
        for i, name in ipairs(themesList) do if name == currentTheme then themeIdx = i break end end
        local themeNames = {
            dark = getText("theme_dark"),
            light = getText("theme_light"),
            pink = getText("theme_pink"),
            green = getText("theme_green"),
            blue = getText("theme_blue")
        }
        makeRow(getText("theme"), themeNames[themesList[themeIdx]], function(btn)
            btn.MouseButton1Click:Connect(function()
                themeIdx = themeIdx % #themesList + 1
                local newTheme = themesList[themeIdx]
                btn.Text = themeNames[newTheme]
                applyTheme(newTheme)
            end)
        end, 36)

        -- TP offset
        local tpOffsetFrame = Instance.new("Frame")
        tpOffsetFrame.Size = UDim2.new(1,0,0,44)
        tpOffsetFrame.BackgroundTransparency = 1
        tpOffsetFrame.ZIndex = 12
        tpOffsetFrame.Parent = scroll

        local tpOffsetLabel = Instance.new("TextLabel")
        tpOffsetLabel.Size = UDim2.new(0.55,0,1,0)
        tpOffsetLabel.BackgroundTransparency = 1
        tpOffsetLabel.Text = getText("tp_offset")
        tpOffsetLabel.TextColor3 = Color3.new(1,1,1)
        tpOffsetLabel.TextSize = isMobile and 11 or 12
        tpOffsetLabel.Font = Enum.Font.Gotham
        tpOffsetLabel.ZIndex = 12
        tpOffsetLabel.Parent = tpOffsetFrame

        local tpOffsetContainer = Instance.new("Frame")
        tpOffsetContainer.Size = UDim2.new(0.4,0,1,0)
        tpOffsetContainer.Position = UDim2.new(0.6,0,0,0)
        tpOffsetContainer.BackgroundTransparency = 1
        tpOffsetContainer.ZIndex = 12
        tpOffsetContainer.Parent = tpOffsetFrame

        local tpOffsetBox = Instance.new("TextBox")
        tpOffsetBox.Size = UDim2.new(0,50,1,-4)
        tpOffsetBox.Position = UDim2.new(0,0,0,2)
        tpOffsetBox.BackgroundColor3 = Color3.new(0.2,0.2,0.25)
        tpOffsetBox.Text = tostring(playerTPOffset)
        tpOffsetBox.TextColor3 = Color3.new(1,1,1)
        tpOffsetBox.TextSize = 13
        tpOffsetBox.Font = Enum.Font.Gotham
        tpOffsetBox.ZIndex = 12
        tpOffsetBox.Parent = tpOffsetContainer
        Instance.new("UICorner", tpOffsetBox).CornerRadius = UDim.new(0,4)

        local minusBtn = Instance.new("TextButton")
        minusBtn.Size = UDim2.new(0,20,0,20)
        minusBtn.Position = UDim2.new(0,55,0.5,-10)
        minusBtn.Text = "-"
        minusBtn.TextColor3 = Color3.new(1,1,1)
        minusBtn.BackgroundColor3 = Color3.new(0.4,0.4,0.5)
        minusBtn.Font = Enum.Font.GothamBold
        minusBtn.TextSize = 14
        minusBtn.ZIndex = 12
        minusBtn.Parent = tpOffsetContainer
        Instance.new("UICorner", minusBtn).CornerRadius = UDim.new(0,4)
        minusBtn.MouseButton1Click:Connect(function()
            playerTPOffset = math.max(-100, playerTPOffset - 1)
            tpOffsetBox.Text = tostring(playerTPOffset)
        end)

        local plusBtn = Instance.new("TextButton")
        plusBtn.Size = UDim2.new(0,20,0,20)
        plusBtn.Position = UDim2.new(0,78,0.5,-10)
        plusBtn.Text = "+"
        plusBtn.TextColor3 = Color3.new(1,1,1)
        plusBtn.BackgroundColor3 = Color3.new(0.4,0.4,0.5)
        plusBtn.Font = Enum.Font.GothamBold
        plusBtn.TextSize = 14
        plusBtn.ZIndex = 12
        plusBtn.Parent = tpOffsetContainer
        Instance.new("UICorner", plusBtn).CornerRadius = UDim.new(0,4)
        plusBtn.MouseButton1Click:Connect(function()
            playerTPOffset = math.min(100, playerTPOffset + 1)
            tpOffsetBox.Text = tostring(playerTPOffset)
        end)

        tpOffsetBox.FocusLost:Connect(function()
            local val = tonumber(tpOffsetBox.Text)
            if val then
                playerTPOffset = math.clamp(math.floor(val), -100, 100)
                tpOffsetBox.Text = tostring(playerTPOffset)
            else
                tpOffsetBox.Text = tostring(playerTPOffset)
            end
        end)

        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            scroll.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+20)
        end)
        task.wait()
        scroll.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+20)
    end

    -- ===== СБОРКА ГЛАВНОГО GUI =====
    local function createGUI()
        if guiDestroyed then return end
        if sg and sg.Parent then sg:Destroy() end

        sg = Instance.new("ScreenGui")
        sg.Name = "EscanorHUB"
        sg.ResetOnSpawn = false
        pcall(function() sg.Parent = LP:WaitForChild("PlayerGui") end)

        local guiWidth = isMobile and 210 or 360
        local guiHeight = isMobile and 270 or 425
        originalHeight = guiHeight

        mainFrame = Instance.new("Frame")
        mainFrame.Size = UDim2.new(0, guiWidth, 0, guiHeight)
        mainFrame.Position = UDim2.new(0.5, -guiWidth/2, 0.5, -guiHeight/2)
        mainFrame.BackgroundColor3 = themes[currentTheme].mainBg
        mainFrame.BackgroundTransparency = guiTransparency
        mainFrame.BorderSizePixel = 0
        mainFrame.ClipsDescendants = true
        Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0,12)

        -- Переливающаяся рамка основного GUI (UIStroke)
        local mainStroke = Instance.new("UIStroke", mainFrame)
        mainStroke.Thickness = 2.5
        mainStroke.Color = Color3.fromRGB(140, 100, 255)
        mainStroke.Transparency = 0.1
        themeElements.mainStroke = mainStroke

        local mainGradient = Instance.new("UIGradient", mainFrame)
        mainGradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, themes[currentTheme].mainGradStart),
            ColorSequenceKeypoint.new(1, themes[currentTheme].mainGradEnd)
        }
        mainGradient.Rotation = 45
        themeElements.mainGradient = mainGradient
        mainFrame.Parent = sg

        -- Индикатор загрузки
        loadingFrame = Instance.new("Frame")
        loadingFrame.Size = UDim2.new(0, 60, 0, 60)
        loadingFrame.Position = UDim2.new(0.5, -30, 0.5, -30)
        loadingFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        loadingFrame.BackgroundTransparency = 0.5
        loadingFrame.BorderSizePixel = 0
        loadingFrame.Visible = false
        local loadCorner = Instance.new("UICorner", loadingFrame)
        loadCorner.CornerRadius = UDim.new(1, 0)
        local loadLabel = Instance.new("TextLabel", loadingFrame)
        loadLabel.Size = UDim2.new(1,0,1,0)
        loadLabel.BackgroundTransparency = 1
        loadLabel.Text = "🌀"
        loadLabel.TextColor3 = Color3.new(1,1,1)
        loadLabel.TextSize = 24
        loadLabel.Font = Enum.Font.GothamBold
        loadingFrame.Parent = sg

        -- Верхняя панель (только заголовок, сворачивание и закрытие)
        local topBar = Instance.new("Frame")
        topBar.Size = UDim2.new(1,0,0, isMobile and 28 or 40)
        topBar.BackgroundColor3 = themes[currentTheme].topBg
        topBar.BorderSizePixel = 0
        local topCorner = Instance.new("UICorner")
        topCorner.CornerRadius = UDim.new(0,10)
        topCorner.Parent = topBar
        topBar.Parent = mainFrame
        themeElements.topBar = topBar

        -- Переливающаяся рамка верхней панели
        local topStroke = Instance.new("UIStroke", topBar)
        topStroke.Thickness = 1.5
        topStroke.Color = Color3.fromRGB(140, 100, 255)
        topStroke.Transparency = 0.35
        themeElements.topStroke = topStroke

        local topGradient = Instance.new("UIGradient", topBar)
        topGradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, themes[currentTheme].topGradStart),
            ColorSequenceKeypoint.new(1, themes[currentTheme].topGradEnd)
        }
        themeElements.topGradient = topGradient

        local titleLabel = Instance.new("TextLabel")
        titleLabel.Size = UDim2.new(0, isMobile and 100 or 180, 0, 16)
        titleLabel.Position = UDim2.new(0, 0, 0, 2)
        titleLabel.BackgroundTransparency = 1
        titleLabel.Text = "Escanor HUB 🔥 v1.2"
        titleLabel.TextColor3 = themes[currentTheme].textColor
        titleLabel.TextSize = isMobile and 11 or 16
        titleLabel.Font = Enum.Font.GothamBold
        titleLabel.TextXAlignment = Enum.TextXAlignment.Left
        titleLabel.Parent = topBar
        themeElements.titleLabel = titleLabel

        local subTitle = Instance.new("TextLabel")
        subTitle.Size = UDim2.new(0, isMobile and 100 or 180, 0, 12)
        subTitle.Position = UDim2.new(0, 0, 0, isMobile and 16 or 18)
        subTitle.BackgroundTransparency = 1
        subTitle.Text = "🌀 teleport"
        subTitle.TextColor3 = themes[currentTheme].textColor
        subTitle.TextSize = isMobile and 8 or 10
        subTitle.Font = Enum.Font.Gotham
        subTitle.TextXAlignment = Enum.TextXAlignment.Left
        subTitle.Parent = topBar

        local btnSize = isMobile and 22 or 28
        local gap = 6
        local shift = 22
        local function makeTopBtn(xOffset, text, color)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, btnSize, 0, btnSize)
            btn.Position = UDim2.new(1, xOffset - shift, 0, (topBar.Size.Y.Offset - btnSize)/2)
            btn.Text = text
            btn.TextColor3 = Color3.new(1,1,1)
            btn.TextSize = isMobile and 10 or 14
            btn.BackgroundColor3 = color
            btn.BackgroundTransparency = 0.15
            btn.BorderSizePixel = 0
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0,5)
            corner.Parent = btn
            btn.Parent = topBar
            return btn
        end

        local closeBtn = makeTopBtn(-gap, "X", Color3.new(0.6,0.15,0.15))
        local minimizeBtn = makeTopBtn(-(btnSize + 2*gap), "–", Color3.new(0.3,0.3,0.5))

        closeBtn.MouseButton1Click:Connect(function()
            -- Крестик = полное удаление GUI (как P)
            destroyGUI()
        end)
        minimizeBtn.MouseButton1Click:Connect(function()
            -- Анимация нажатия кнопки сворачивания
            TweenService:Create(minimizeBtn, TweenInfo.new(0.08), {Size = UDim2.new(0, btnSize-4, 0, btnSize-4)}):Play()
            task.delay(0.1, function()
                if minimizeBtn and minimizeBtn.Parent then
                    TweenService:Create(minimizeBtn, TweenInfo.new(0.1, Enum.EasingStyle.Back), {Size = UDim2.new(0, btnSize, 0, btnSize)}):Play()
                end
            end)
            if not isMinimized then
                local targetHeight = topBar.Size.Y.Offset + 4
                TweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, guiWidth, 0, targetHeight)
                }):Play()
                minimizeBtn.Text = "+"
                isMinimized = true
            else
                TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0, guiWidth, 0, originalHeight)
                }):Play()
                minimizeBtn.Text = "–"
                isMinimized = false
            end
        end)

        -- Перетаскивание главного окна за заголовок
        local isDragging = false
        local dragStart, startPos
        topBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
                dragStart = input.Position
                startPos = mainFrame.Position
            end
        end)
        topBar.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = false
            end
        end)
        UserInput.InputChanged:Connect(function(input)
            if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)

        -- Панель действий (L, M, S, A, R)
        local actionBarHeight = isMobile and 28 or 40
        local actionBar = Instance.new("Frame")
        actionBar.Size = UDim2.new(1, 0, 0, actionBarHeight)
        actionBar.Position = UDim2.new(0, 0, 0, topBar.Size.Y.Offset)
        actionBar.BackgroundColor3 = themes[currentTheme].topBg
        actionBar.BackgroundTransparency = 0.3
        actionBar.BorderSizePixel = 0
        actionBar.Parent = mainFrame

        local function makeActionBtn(xOffset, text, color)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, btnSize, 0, btnSize)
            btn.Position = UDim2.new(1, xOffset - shift, 0, (actionBarHeight - btnSize)/2)
            btn.Text = text
            btn.TextColor3 = Color3.new(1,1,1)
            btn.TextSize = isMobile and 10 or 14
            btn.BackgroundColor3 = color
            btn.BackgroundTransparency = 0.15
            btn.BorderSizePixel = 0
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0,5)
            corner.Parent = btn
            btn.Parent = actionBar
            return btn
        end

        local loadPosBtn = makeActionBtn(-gap, "📂", Color3.new(0.25,0.25,0.25))
        local savePosBtn = makeActionBtn(-(btnSize + 2*gap), "💾", Color3.new(0.25,0.25,0.25))
        local settingsBtn = makeActionBtn(-(2*btnSize + 3*gap), "⚙", Color3.new(0.2,0.2,0.4))
        instantBtn = makeActionBtn(-(3*btnSize + 4*gap), "🎯", Color3.new(0.3,0.3,0.3))
        local refreshBtn = makeActionBtn(-(4*btnSize + 5*gap), "🔄", Color3.new(0.15,0.5,0.15))

        savePosBtn.MouseButton1Click:Connect(function()
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                savedPosition = hrp.CFrame
                LP:Chat(getText("pos_saved"))
                addCurrentLocation()
            else
                LP:Chat(getText("cant_save"))
            end
        end)

        loadPosBtn.MouseButton1Click:Connect(function()
            if savedPosition then SmartTP(savedPosition * CFrame.new(0,0,2)) else LP:Chat(getText("no_saved")) end
        end)

        refreshBtn.MouseButton1Click:Connect(function()
            refreshButtons()
            if currentTab == "locations" then refreshLocationsList() end
            if currentTab == "favorites" then refreshFavorites() end
            if currentTab == "history" then refreshHistory() end
        end)

        instantBtn.MouseButton1Click:Connect(function()
            if autoTeleportActive then stopAutoTeleport()
            else
                if autoTargetPlayer then startAutoTeleport(autoTargetPlayer)
                else LP:Chat(getText("select_player_first")) end
            end
        end)

        settingsBtn.MouseButton1Click:Connect(function()
            createSettingsWindow()
        end)

        -- Панель вкладок и контент
        local totalTopHeight = topBar.Size.Y.Offset + actionBarHeight
        local tabBarY = totalTopHeight + (isMobile and 6 or 10)
        local tabBarHeight = isMobile and 20 or 28

        local tabBarScroll = Instance.new("ScrollingFrame")
        tabBarScroll.Size = UDim2.new(1, -10, 0, tabBarHeight)
        tabBarScroll.Position = UDim2.new(0, 5, 0, tabBarY)
        tabBarScroll.BackgroundTransparency = 1
        tabBarScroll.BorderSizePixel = 0
        tabBarScroll.ScrollingDirection = Enum.ScrollingDirection.X
        tabBarScroll.ScrollBarThickness = 3
        tabBarScroll.ClipsDescendants = true
        tabBarScroll.Parent = mainFrame

        local tabBarInner = Instance.new("Frame")
        tabBarInner.Size = UDim2.new(0, 0, 1, 0)
        tabBarInner.BackgroundTransparency = 1
        tabBarInner.Parent = tabBarScroll

        local function makeTab(x, width, text)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, width, 1, 0)
            btn.Position = UDim2.new(0, x, 0, 0)
            btn.Text = text
            btn.TextColor3 = Color3.new(1,1,1)
            btn.TextSize = isMobile and 8 or 11
            btn.Font = Enum.Font.GothamBold
            btn.BackgroundColor3 = themes[currentTheme].tabInactive
            btn.BackgroundTransparency = 0.25
            btn.BorderSizePixel = 0
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 5)
            corner.Parent = btn
            btn.Parent = tabBarInner
            return btn
        end

        local tabPlayers = makeTab(0, isMobile and 40 or 55, getText("tab_players"))
        local tabLocations = makeTab(isMobile and 44 or 60, isMobile and 45 or 55, getText("tab_locations"))
        local tabFavorites = makeTab(isMobile and 93 or 120, isMobile and 50 or 65, getText("tab_favorites"))
        local tabHistory = makeTab(isMobile and 148 or 190, isMobile and 50 or 65, getText("tab_history"))
        local tabOther = makeTab(isMobile and 203 or 260, isMobile and 45 or 55, getText("tab_other"))
        local tabPlaces = makeTab(isMobile and 252 or 320, isMobile and 45 or 55, getText("tab_places"))
        local tabHelp = makeTab(isMobile and 301 or 380, isMobile and 45 or 55, getText("tab_help"))

        local totalTabsWidth = (isMobile and 301+45 or 380+55) + 10
        tabBarInner.Size = UDim2.new(0, totalTabsWidth, 1, 0)
        tabBarScroll.CanvasSize = UDim2.new(0, totalTabsWidth, 0, 0)

        themeElements.tabPlayers = tabPlayers
        themeElements.tabLocations = tabLocations
        themeElements.tabFavorites = tabFavorites
        themeElements.tabHistory = tabHistory
        themeElements.tabOther = tabOther
        themeElements.tabPlaces = tabPlaces
        themeElements.tabHelp = tabHelp

        if not themeElements.textElements then themeElements.textElements = {} end
        local textElements = themeElements.textElements
        table.insert(textElements, titleLabel)
        table.insert(textElements, subTitle)
        table.insert(textElements, tabPlayers)
        table.insert(textElements, tabLocations)
        table.insert(textElements, tabFavorites)
        table.insert(textElements, tabHistory)
        table.insert(textElements, tabOther)
        table.insert(textElements, tabPlaces)
        table.insert(textElements, tabHelp)

        local contentY = tabBarY + tabBarHeight + 4
        local playersContent = Instance.new("Frame")
        playersContent.Size = UDim2.new(1, -10, 1, -contentY - 4)
        playersContent.Position = UDim2.new(0, 5, 0, contentY)
        playersContent.BackgroundTransparency = 1
        playersContent.Parent = mainFrame

        local locationsContent = playersContent:Clone(); locationsContent.Visible = false; locationsContent.Parent = mainFrame
        local favoritesContent = playersContent:Clone(); favoritesContent.Visible = false; favoritesContent.Parent = mainFrame
        local historyContent = playersContent:Clone(); historyContent.Visible = false; historyContent.Parent = mainFrame
        local otherContent = playersContent:Clone(); otherContent.Visible = false; otherContent.Parent = mainFrame
        local placesContent = playersContent:Clone(); placesContent.Visible = false; placesContent.Parent = mainFrame
        local helpContent = playersContent:Clone(); helpContent.Visible = false; helpContent.Parent = mainFrame

        -- Players tab
        local searchFrameHeight = isMobile and 34 or 28
        local searchFrame = Instance.new("Frame")
        searchFrame.Size = UDim2.new(1, 0, 0, searchFrameHeight)
        searchFrame.Position = UDim2.new(0, 0, 0, 2)
        searchFrame.BackgroundTransparency = 1
        searchFrame.Parent = playersContent

        local searchBox = Instance.new("TextBox")
        if isMobile then
            searchBox.Size = UDim2.new(1, 0, 0, 18)
            searchBox.Position = UDim2.new(0, 0, 0, 0)
        else
            searchBox.Size = UDim2.new(0.7, 0, 1, 0)
            searchBox.Position = UDim2.new(0, 0, 0, 0)
        end
        searchBox.BackgroundColor3 = themes[currentTheme].inputBg
        searchBox.Text = ""
        searchBox.TextColor3 = themes[currentTheme].textColor
        searchBox.TextSize = isMobile and 9 or 12
        searchBox.Font = Enum.Font.Gotham
        searchBox.PlaceholderText = getText("search_placeholder")
        searchBox.Parent = searchFrame
        themeElements.searchBox = searchBox
        table.insert(textElements, searchBox)

        local sortBtn = Instance.new("TextButton")
        if isMobile then
            sortBtn.Size = UDim2.new(1, 0, 0, 18)
            sortBtn.Position = UDim2.new(0, 0, 0, 20)
        else
            sortBtn.Size = UDim2.new(0.25, 0, 1, 0)
            sortBtn.Position = UDim2.new(0.73, 0, 0, 0)
        end
        sortBtn.Text = getText("sort_name")
        sortBtn.TextColor3 = Color3.new(1,1,1)
        sortBtn.TextSize = isMobile and 9 or 12
        sortBtn.BackgroundColor3 = Color3.new(0.2,0.2,0.2)
        sortBtn.BorderSizePixel = 0
        sortBtn.Parent = searchFrame
        themeElements.sortBtn = sortBtn
        table.insert(textElements, sortBtn)

        if starsEnabled then
            local starsContainer = Instance.new("Frame")
            starsContainer.Size = UDim2.new(1, 0, 1, 0)
            starsContainer.Position = UDim2.new(0, 0, 0, 0)
            starsContainer.BackgroundTransparency = 1
            starsContainer.Parent = playersContent
            for i=1,10 do
                local s = Instance.new("ImageLabel")
                s.Size = UDim2.new(0,math.random(2,3),0,math.random(2,3))
                s.Image = "rbxasset://textures/ui/common/white-circle.png"
                s.ImageColor3 = Color3.new(1,1,1)
                s.ImageTransparency = 0.6
                s.BackgroundTransparency = 1
                s.Position = UDim2.new(math.random(),0,math.random(),0)
                s.Parent = starsContainer
                local function anim()
                    local d = math.random(4,12)
                    local np = UDim2.new(math.random(),0,math.random(),0)
                    local tw = TweenService:Create(s, TweenInfo.new(d, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false, 0), {Position = np})
                    tw:Play()
                    tw.Completed:Connect(anim)
                end
                anim()
            end
        end

        local playerScroll = Instance.new("ScrollingFrame")
        playerScroll.Size = UDim2.new(1, 0, 1, -(searchFrameHeight + 10))
        playerScroll.Position = UDim2.new(0, 0, 0, searchFrameHeight + 6)
        playerScroll.BackgroundTransparency = 1
        playerScroll.BorderSizePixel = 0
        playerScroll.CanvasSize = UDim2.new(0,0,0,0)
        playerScroll.ScrollBarThickness = 2
        playerScroll.ClipsDescendants = true
        playerScroll.Parent = playersContent

        bc = Instance.new("Frame")
        bc.Size = UDim2.new(1,0,1,0)
        bc.BackgroundTransparency = 1
        bc.Parent = playerScroll

        lay = Instance.new("UIListLayout")
        lay.Padding = UDim.new(0, isMobile and 3 or 6)
        lay.SortOrder = Enum.SortOrder.Name
        lay.Parent = bc

        lf = playerScroll

        -- Locations tab
        coordsLabel = Instance.new("TextLabel")
        coordsLabel.Size = UDim2.new(1, 0, 0, isMobile and 0 or 18)
        coordsLabel.Position = UDim2.new(0, 4, 0, 2)
        coordsLabel.BackgroundTransparency = 1
        coordsLabel.Text = getText("coords_label")
        coordsLabel.TextColor3 = themes[currentTheme].textColor
        coordsLabel.TextSize = isMobile and 8 or 11
        coordsLabel.Font = Enum.Font.GothamBold
        coordsLabel.TextXAlignment = Enum.TextXAlignment.Left
        coordsLabel.Visible = not isMobile
        coordsLabel.Parent = locationsContent
        table.insert(textElements, coordsLabel)

        local locSearchBox = Instance.new("TextBox")
        locSearchBox.Size = UDim2.new(1, 0, 0, 18)
        locSearchBox.Position = UDim2.new(0, 4, 0, isMobile and 2 or 22)
        locSearchBox.BackgroundColor3 = themes[currentTheme].inputBg
        locSearchBox.Text = ""
        locSearchBox.PlaceholderText = getText("search_loc_placeholder")
        locSearchBox.TextColor3 = themes[currentTheme].textColor
        locSearchBox.TextSize = 9
        locSearchBox.Font = Enum.Font.Gotham
        locSearchBox.Parent = locationsContent
        themeElements.locSearchBox = locSearchBox
        table.insert(textElements, locSearchBox)
        locSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
            locationSearchFilter = locSearchBox.Text
            refreshLocationsList()
        end)

        local inputPanel = Instance.new("Frame")
        inputPanel.Size = UDim2.new(1, -8, 0, isMobile and 32 or 40)
        inputPanel.Position = UDim2.new(0, 4, 0, isMobile and 24 or 44)
        inputPanel.BackgroundColor3 = Color3.new(0.15,0.15,0.2)
        inputPanel.BackgroundTransparency = 0.4
        inputPanel.BorderSizePixel = 1
        inputPanel.BorderColor3 = Color3.new(0.5,0.5,0.6)
        inputPanel.Parent = locationsContent

        local coordLabel = Instance.new("TextLabel")
        coordLabel.Size = UDim2.new(0, 40, 0, 14)
        coordLabel.Position = UDim2.new(0, 4, 0, 2)
        coordLabel.BackgroundTransparency = 1
