local TeleportService = game:GetService("TeleportService")
local Stats = game:GetService("Stats")
local Lighting = game:GetService("Lighting")

-- ===== ГЛОБАЛЬНЫЕ НАСТРОЙКИ =====
if _G.TeleportHubSettings == nil then _G.TeleportHubSettings = {} end
if _G.FavoriteLocations == nil then _G.FavoriteLocations = {} end
if _G.TeleportHistory == nil then _G.TeleportHistory = {} end
if _G.AntiAFKEnabled == nil then _G.AntiAFKEnabled = false end
if _G.ShowFPS == nil then _G.ShowFPS = false end
if _G.FPSPosition == nil then _G.FPSPosition = UDim2.new(0, 5, 0, 5) end
if _G.FullbrightEnabled == nil then _G.FullbrightEnabled = false end
if _G.CoordsDisplayEnabled == nil then _G.CoordsDisplayEnabled = false end
if _G.TimerEnabled == nil then _G.TimerEnabled = false end

-- ===== АВТО-ПЕРЕЗАПУСК ПОСЛЕ ТЕЛЕПОРТАЦИИ =====
if _G.EscanorHubClosed == nil then _G.EscanorHubClosed = false end

local SUPPORTED_PLACE_IDS = {
    [6403373529] = "Slap Battles",
    [7234087065] = "Barzil",
    [115782629143468] = "Untitled Tag",
    [127174121130060] = "Glove Game",
    [18550498098] = "Guide",
    [125845699717230] = "DoorKeeper",
    [106620300132058] = "Plate",
    [103505724406848] = "Poltergeist",
    [77283826005207] = "G-X",
}

local function setupAutoRestart()
    local SCRIPT_URL = "https://pastebin.com/raw/wyYpVD58"
    local scriptSource = 'repeat task.wait() until game:IsLoaded() task.wait(2) loadstring(game:HttpGet("' .. SCRIPT_URL .. '"))()'

    local function tryQueueScript()
        local ok1 = pcall(function()
            if queue_on_teleport then queue_on_teleport(scriptSource) return end
        end)
        if ok1 then return true end
        local ok2 = pcall(function()
            if syn and syn.queue_on_teleport then syn.queue_on_teleport(scriptSource) return end
        end)
        if ok2 then return true end
        local ok3 = pcall(function()
            if fluxus and fluxus.queue_on_teleport then fluxus.queue_on_teleport(scriptSource) return end
        end)
        if ok3 then return true end
        local ok4 = pcall(function()
            if getgenv then
                local env = getgenv()
                if env and env.queue_on_teleport then env.queue_on_teleport(scriptSource) return end
            end
        end)
        if ok4 then return true end
        return false
    end

    LP.OnTeleport:Connect(function(State)
        if State == Enum.TeleportState.Started then
            if _G.EscanorHubClosed then return end
            _G.TeleportHubSettings = _G.TeleportHubSettings or {}
            _G.TeleportHubSettings._autoRestarted = true
            local queued = tryQueueScript()
            if not queued then
                warn("[Escanor HUB] queue_on_teleport не найден. Попробуйте loadstring вручную после ТП.")
            end
        end
    end)

    pcall(function()
        TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage)
            if player == LP then
                warn("[Escanor HUB] Teleport failed: " .. tostring(errorMessage) .. " — retry in 5s")
                task.delay(5, function()
                    local targetId = _G.TeleportHubSettings and _G.TeleportHubSettings._targetPlaceId
                    if targetId then
                        pcall(function() TeleportService:Teleport(targetId) end)
                    end
                end)
            end
        end)
    end)
end

-- ===== ЛАУНЧЕР (компактный 300x200) =====
local function showLauncher()
    local launcherGui = Instance.new("ScreenGui")
    launcherGui.Name = "Launcher"
    launcherGui.ResetOnSpawn = false
    pcall(function() launcherGui.Parent = game:GetService("CoreGui") end)
    if not launcherGui.Parent then launcherGui.Parent = LP:WaitForChild("PlayerGui") end

    local main = Instance.new("Frame")
    main.Size = UDim2.new(0, 300, 0, 200)
    main.Position = UDim2.new(0.5, -150, 0.5, -100)
    main.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
    main.BorderSizePixel = 0
    main.ClipsDescendants = true
    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 30, 50)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 15, 30))
    }
    gradient.Rotation = -45
    gradient.Parent = main

    local launcherStroke = Instance.new("UIStroke")
    launcherStroke.Thickness = 2
    launcherStroke.Color = Color3.fromRGB(140, 100, 255)
    launcherStroke.Transparency = 0.15
    launcherStroke.Parent = main

    local launcherHue = 0
    local launcherShimmerConn = RunService.Heartbeat:Connect(function(dt)
        if not main or not main.Parent then return end
        launcherHue = (launcherHue + dt * 1.2) % (math.pi * 2)
        local h = (0.75 + math.sin(launcherHue) * 0.12) % 1
        launcherStroke.Color = Color3.fromHSV(h, 0.7, 0.9)
        local bgH = (0.75 + math.sin(launcherHue * 0.7) * 0.05) % 1
        gradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromHSV(bgH, 0.3, 0.15)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV((bgH + 0.03) % 1, 0.25, 0.08))
        }
    end)

    -- Заголовок
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 24)
    titleBar.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    titleBar.BorderSizePixel = 0
    Instance.new("UICorner", titleBar).CornerRadius = UDim.new(0, 6)
    titleBar.Parent = main

    local titleText = Instance.new("TextLabel")
    titleText.Size = UDim2.new(1, -60, 1, 0)
    titleText.Position = UDim2.new(0, 8, 0, 0)
    titleText.BackgroundTransparency = 1
    titleText.Text = "🚀 Escanor HUB 🔥 v1.2"
    titleText.TextColor3 = Color3.new(1, 1, 1)
    titleText.Font = Enum.Font.GothamBold
    titleText.TextSize = 12
    titleText.TextXAlignment = Enum.TextXAlignment.Left
    titleText.Parent = titleBar

    local minBtn = Instance.new("TextButton")
    minBtn.Size = UDim2.new(0, 22, 0, 22)
    minBtn.Position = UDim2.new(1, -46, 0, 1)
    minBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 85)
    minBtn.Text = "–"
    minBtn.TextColor3 = Color3.new(1, 1, 1)
    minBtn.Font = Enum.Font.GothamBold
    minBtn.TextSize = 14
    Instance.new("UICorner", minBtn).CornerRadius = UDim.new(0, 5)
    minBtn.Parent = titleBar

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 22, 0, 22)
    closeBtn.Position = UDim2.new(1, -22, 0, 1)
    closeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 14
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 5)
    closeBtn.Parent = titleBar

    local launcherMinimized = false
    local contentFrame = Instance.new("Frame")
    contentFrame.Size = UDim2.new(1, 0, 1, -24)
    contentFrame.Position = UDim2.new(0, 0, 0, 24)
    contentFrame.BackgroundTransparency = 1
    contentFrame.Parent = main

    minBtn.MouseButton1Click:Connect(function()
        if not launcherMinimized then
            main:TweenSize(UDim2.new(0, 300, 0, 24), Enum.EasingDirection.InOut, Enum.EasingStyle.Quad, 0.3, true)
            minBtn.Text = "+"
            contentFrame.Visible = false
            launcherMinimized = true
        else
            main:TweenSize(UDim2.new(0, 300, 0, 200), Enum.EasingDirection.InOut, Enum.EasingStyle.Quad, 0.3, true)
            minBtn.Text = "–"
            contentFrame.Visible = true
            launcherMinimized = false
        end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        if launcherShimmerConn then launcherShimmerConn:Disconnect() end
        launcherGui:Destroy()
    end)

    -- Перетаскивание
    local dragging = false
    local dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    titleBar.InputEnded:Connect(function() dragging = false end)
    UserInput.InputChanged:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Язык
    local langLabel = Instance.new("TextLabel")
    langLabel.Size = UDim2.new(1, -16, 0, 16)
    langLabel.Position = UDim2.new(0, 8, 0, 8)
    langLabel.BackgroundTransparency = 1
    langLabel.Text = "🌐 Язык / Language:"
    langLabel.TextColor3 = Color3.new(0.9, 0.9, 0.9)
    langLabel.TextSize = 11
    langLabel.Font = Enum.Font.Gotham
    langLabel.TextXAlignment = Enum.TextXAlignment.Left
    langLabel.Parent = contentFrame

    local selectedLang = "en"
    local langButtons = {}
    local function updateLangButtons()
        for code, btn in pairs(langButtons) do
            btn.BackgroundColor3 = code == selectedLang and Color3.fromRGB(100, 100, 255) or Color3.fromRGB(60, 60, 120)
        end
    end
    local langs = {"English", "Русский", "Українська"}
    local langCodes = {"en", "ru", "ua"}
    for i, name in ipairs(langs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.3, -4, 0, 22)
        btn.Position = UDim2.new(0, 8 + (i-1)*92, 0, 28)
        btn.Text = name
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamSemibold
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 120)
        btn.BorderSizePixel = 0
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        btn.MouseButton1Click:Connect(function()
            selectedLang = langCodes[i]
            updateLangButtons()
        end)
        langButtons[langCodes[i]] = btn
        btn.Parent = contentFrame
    end

    -- Устройство
    local devLabel = Instance.new("TextLabel")
    devLabel.Size = UDim2.new(1, -16, 0, 16)
    devLabel.Position = UDim2.new(0, 8, 0, 58)
    devLabel.BackgroundTransparency = 1
    devLabel.Text = "📱 Устройство / Device:"
    devLabel.TextColor3 = Color3.new(0.9, 0.9, 0.9)
    devLabel.TextSize = 11
    devLabel.Font = Enum.Font.Gotham
    devLabel.TextXAlignment = Enum.TextXAlignment.Left
    devLabel.Parent = contentFrame

    local selectedDevice = "PC"
    local deviceButtons = {}
    local function updateDevButtons()
        for dev, btn in pairs(deviceButtons) do
            btn.BackgroundColor3 = dev == selectedDevice and Color3.fromRGB(100, 100, 255) or Color3.fromRGB(60, 60, 120)
        end
    end
    local devs = {"PC", "Mobile"}
    for i, dev in ipairs(devs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.4, -4, 0, 22)
        btn.Position = UDim2.new(0, 8 + (i-1)*120, 0, 78)
        btn.Text = dev == "PC" and "💻 ПК" or "📱 Телефон"
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamSemibold
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 120)
        btn.BorderSizePixel = 0
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        btn.MouseButton1Click:Connect(function()
            selectedDevice = dev
            updateDevButtons()
        end)
        deviceButtons[dev] = btn
        btn.Parent = contentFrame
    end

    -- Тема
    local themeLabel = Instance.new("TextLabel")
    themeLabel.Size = UDim2.new(1, -16, 0, 16)
    themeLabel.Position = UDim2.new(0, 8, 0, 108)
    themeLabel.BackgroundTransparency = 1
    themeLabel.Text = "🎨 Тема / Theme:"
    themeLabel.TextColor3 = Color3.new(0.9, 0.9, 0.9)
    themeLabel.TextSize = 11
    themeLabel.Font = Enum.Font.Gotham
    themeLabel.TextXAlignment = Enum.TextXAlignment.Left
    themeLabel.Parent = contentFrame

    local selectedTheme = "dark"
    local themeButtons = {}
    local function updateThemeButtons()
        for theme, btn in pairs(themeButtons) do
            btn.BackgroundColor3 = theme == selectedTheme and Color3.fromRGB(100, 100, 255) or Color3.fromRGB(60, 60, 120)
        end
    end
    local themes = {"dark", "light"}
    local themeNames = { dark = "🌙 Тёмная", light = "☀️ Светлая" }
    for i, theme in ipairs(themes) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.4, -4, 0, 22)
        btn.Position = UDim2.new(0, 8 + (i-1)*120, 0, 128)
        btn.Text = themeNames[theme]
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamSemibold
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 120)
        btn.BorderSizePixel = 0
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        btn.MouseButton1Click:Connect(function()
            selectedTheme = theme
            updateThemeButtons()
            if theme == "dark" then
                main.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
                titleText.TextColor3 = Color3.new(1,1,1)
                langLabel.TextColor3 = Color3.new(0.9,0.9,0.9)
                devLabel.TextColor3 = Color3.new(0.9,0.9,0.9)
                themeLabel.TextColor3 = Color3.new(0.9,0.9,0.9)
            else
                main.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
                titleText.TextColor3 = Color3.new(0.1,0.1,0.15)
                langLabel.TextColor3 = Color3.new(0.2,0.2,0.3)
                devLabel.TextColor3 = Color3.new(0.2,0.2,0.3)
                themeLabel.TextColor3 = Color3.new(0.2,0.2,0.3)
            end
        end)
        themeButtons[theme] = btn
        btn.Parent = contentFrame
    end

    local execBtn = Instance.new("TextButton")
    execBtn.Size = UDim2.new(0.8, 0, 0, 30)
    execBtn.Position = UDim2.new(0.1, 0, 1, -36)
    execBtn.Text = "🚀 Execute / Запустить"
    execBtn.TextColor3 = Color3.new(1, 1, 1)
    execBtn.TextSize = 13
    execBtn.Font = Enum.Font.GothamBold
    execBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
    execBtn.BorderSizePixel = 0
    Instance.new("UICorner", execBtn).CornerRadius = UDim.new(0, 8)
    execBtn.Parent = contentFrame

    execBtn.MouseButton1Click:Connect(function()
        _G.TeleportHubSettings = {
            language = selectedLang,
            device = selectedDevice,
            theme = selectedTheme
        }
        if launcherShimmerConn then launcherShimmerConn:Disconnect() end
        launcherGui:Destroy()
        StartEscanorHub_Common()
    end)

    UserInput.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.P then
            _G.TeleportHubSettings = nil
            _G.FavoriteLocations = nil
            _G.TeleportHistory = nil
            _G.AntiAFKEnabled = false
            _G.ShowFPS = false
            _G.FPSPosition = UDim2.new(0,5,0,5)
            _G.FullbrightEnabled = false
            _G.CoordsDisplayEnabled = false
            _G.TimerEnabled = false
            launcherGui:Destroy()
            -- Заменяем LP:Chat на showNotification (будет доступна после запуска)
            -- Здесь пока нет showNotification, просто выводим в чат
            -- (уведомление появится после перезапуска)
            print("📌 Настройки сброшены. При следующем запуске появится лаунчер.")
        end
    end)

    updateLangButtons()
    updateDevButtons()
    updateThemeButtons()
end

-- ===== ОСНОВНАЯ ФУНКЦИЯ =====
function StartEscanorHub_Common()
    setupAutoRestart()

    local settings = _G.TeleportHubSettings or {language = "en", device = "PC", theme = "dark"}
    local isMobile = (settings.device == "Mobile")
    local currentLang = settings.language or "en"

    local guiTransparency = settings.transparency or 0.1
    local teleportSpeed = settings.teleportSpeed or 50000
    local starsEnabled = (settings.starsEnabled ~= false)
    local playerTPOffset = settings.playerTPOffset or 2
    local currentTheme = settings.theme or "dark"

    local currentTab = "players"
    local sortByDistance = false
    local searchFilter = ""
    local savedPosition = nil
    local autoTeleportActive = false
    local autoTargetPlayer = nil
    local autoLoopConnection = nil
    local instantBtn = nil
    local settingsWindow = nil

    local favorites = _G.FavoriteLocations or {}
    local history = _G.TeleportHistory or {}

    local antiAFKEnabled = _G.AntiAFKEnabled or false
    local showFPS = _G.ShowFPS or false
    local antiAFKConnection = nil
    local fpsConnection = nil
    local fpsData = { gui = nil, label = nil, fpsCount = 0, fpsTime = 0 }

    local fullbrightEnabled = _G.FullbrightEnabled or false
    local coordsDisplayEnabled = _G.CoordsDisplayEnabled or false
    local timerEnabled = _G.TimerEnabled or false
    local fullbrightBackup = {}

    local guiDestroyed = false
    local sg = nil
    local mainFrame = nil
    local btns = {}
    local bc = nil
    local lf = nil
    local lay = nil
    local hue = 0
    local connection = nil
    local sortTimer = nil
    local themeElements = {}

    local floatingGui = nil
    local floatingButton = nil

    local loadingFrame = nil
    local minimizeBtn = nil
    local isMinimized = false
    local originalHeight = nil

    -- Модуль локаций (будет загружен динамически)
    local locationsModule = nil

    -- Темы (полностью)
    local themes = {
        dark = {
            mainBg = Color3.fromRGB(25,28,40), mainGradStart = Color3.fromRGB(25,28,40), mainGradEnd = Color3.fromRGB(15,18,30),
            topBg = Color3.fromRGB(40,45,60), topGradStart = Color3.fromRGB(60,65,80), topGradEnd = Color3.fromRGB(40,45,60),
            tabActive = Color3.fromRGB(120,120,220), tabInactive = Color3.fromRGB(70,70,130),
            borderColor = Color3.new(1,1,1), textColor = Color3.new(1,1,1),
            btnColor = Color3.fromRGB(70,70,130), inputBg = Color3.fromRGB(15,15,20),
            shimmerHue = 0.75, shimmerRange = 0.12, shimmerSat = 0.7, shimmerVal = 0.85
        },
        light = {
            mainBg = Color3.fromRGB(240,240,245), mainGradStart = Color3.fromRGB(240,240,245), mainGradEnd = Color3.fromRGB(220,220,225),
            topBg = Color3.fromRGB(200,200,220), topGradStart = Color3.fromRGB(210,210,230), topGradEnd = Color3.fromRGB(190,190,210),
            tabActive = Color3.fromRGB(80,120,220), tabInactive = Color3.fromRGB(180,180,200),
            borderColor = Color3.new(0.3,0.3,0.4), textColor = Color3.new(0.1,0.1,0.15),
            btnColor = Color3.fromRGB(180,180,200), inputBg = Color3.fromRGB(255,255,255),
            shimmerHue = 0.72, shimmerRange = 0.10, shimmerSat = 0.45, shimmerVal = 0.70
        },
        pink = {
            mainBg = Color3.fromRGB(40,20,30), mainGradStart = Color3.fromRGB(40,20,30), mainGradEnd = Color3.fromRGB(30,15,25),
            topBg = Color3.fromRGB(60,30,45), topGradStart = Color3.fromRGB(80,40,60), topGradEnd = Color3.fromRGB(60,30,45),
            tabActive = Color3.fromRGB(220,120,180), tabInactive = Color3.fromRGB(150,70,120),
            borderColor = Color3.new(1,0.8,0.9), textColor = Color3.new(1,0.9,0.95),
            btnColor = Color3.fromRGB(150,70,120), inputBg = Color3.fromRGB(30,15,25),
            shimmerHue = 0.91, shimmerRange = 0.08, shimmerSat = 0.65, shimmerVal = 0.90
        },
        green = {
            mainBg = Color3.fromRGB(20,35,25), mainGradStart = Color3.fromRGB(20,35,25), mainGradEnd = Color3.fromRGB(15,28,20),
            topBg = Color3.fromRGB(30,50,35), topGradStart = Color3.fromRGB(40,65,45), topGradEnd = Color3.fromRGB(30,50,35),
            tabActive = Color3.fromRGB(100,200,120), tabInactive = Color3.fromRGB(60,130,80),
            borderColor = Color3.new(0.5,1,0.6), textColor = Color3.new(0.9,1,0.9),
            btnColor = Color3.fromRGB(60,130,80), inputBg = Color3.fromRGB(20,35,25),
            shimmerHue = 0.38, shimmerRange = 0.10, shimmerSat = 0.70, shimmerVal = 0.80
        },
        blue = {
            mainBg = Color3.fromRGB(15,20,40), mainGradStart = Color3.fromRGB(15,20,40), mainGradEnd = Color3.fromRGB(10,15,30),
            topBg = Color3.fromRGB(20,30,60), topGradStart = Color3.fromRGB(30,45,80), topGradEnd = Color3.fromRGB(20,30,60),
            tabActive = Color3.fromRGB(80,120,255), tabInactive = Color3.fromRGB(50,80,180),
            borderColor = Color3.new(0.6,0.7,1), textColor = Color3.new(0.85,0.9,1),
            btnColor = Color3.fromRGB(50,80,180), inputBg = Color3.fromRGB(15,20,40),
            shimmerHue = 0.60, shimmerRange = 0.10, shimmerSat = 0.75, shimmerVal = 0.90
        }
    }
    themes["default"] = themes.dark

    -- Функции переливания
    local function getShimmerColor(t, phase)
        local baseH = t.shimmerHue or 0.75
        local range = t.shimmerRange or 0.12
        local sat = t.shimmerSat or 0.7
        local val = t.shimmerVal or 0.85
        local h = (baseH + math.sin(phase) * range) % 1
        return Color3.fromHSV(h, sat, val)
    end

    local function getShimmerColorOffset(t, phase, offset)
        local baseH = t.shimmerHue or 0.75
        local range = t.shimmerRange or 0.12
        local sat = t.shimmerSat or 0.7
        local val = t.shimmerVal or 0.85
        local h = (baseH + math.sin(phase + offset) * range) % 1
        return Color3.fromHSV(h, sat, val)
    end

    local function getShimmerColorDim(t, phase, dimFactor)
        local baseH = t.shimmerHue or 0.75
        local range = t.shimmerRange or 0.12
        local sat = t.shimmerSat or 0.7
        local val = (t.shimmerVal or 0.85) * dimFactor
        local h = (baseH + math.sin(phase) * range) % 1
        return Color3.fromHSV(h, sat, val)
    end

    -- Переводы локаций (остаётся для избранного)
