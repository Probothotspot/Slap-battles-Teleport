        -- Favorites tab
        local favScroll = Instance.new("ScrollingFrame")
        favScroll.Size = UDim2.new(1, -4, 1, -4)
        favScroll.Position = UDim2.new(0, 2, 0, 2)
        favScroll.BackgroundTransparency = 1
        favScroll.BorderSizePixel = 0
        favScroll.CanvasSize = UDim2.new(0,0,0,0)
        favScroll.Parent = favoritesContent
        local favLayout = Instance.new("UIListLayout")
        favLayout.Padding = UDim.new(0, 3)
        favLayout.Parent = favScroll

        local function refreshFavorites()
            for _, child in ipairs(favScroll:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            if #favorites == 0 then
                local emptyLabel = Instance.new("TextLabel")
                emptyLabel.Size = UDim2.new(1, 0, 0, 20)
                emptyLabel.Position = UDim2.new(0, 2, 0, 2)
                emptyLabel.BackgroundTransparency = 1
                emptyLabel.Text = getText("favorites_empty")
                emptyLabel.TextColor3 = Color3.new(0.7, 0.7, 0.7)
                emptyLabel.TextSize = 10
                emptyLabel.Font = Enum.Font.Gotham
                emptyLabel.Parent = favScroll
                favScroll.CanvasSize = UDim2.new(0,0,0,30)
                return
            end
            for _, favName in ipairs(favorites) do
                local loc = nil
                for _, l in ipairs(locations) do
                    if l.name == favName then loc = l; break end
                end
                if loc then
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, -4, 0, 22)
                    btn.Position = UDim2.new(0, 2, 0, 0)
                    btn.Text = getLocalizedLocationName(loc.name)
                    btn.TextColor3 = Color3.new(1,1,1)
                    btn.TextSize = 10
                    btn.Font = Enum.Font.GothamSemibold
                    btn.BackgroundColor3 = Color3.new(0.2,0.5,0.8)
                    btn.BackgroundTransparency = 0.2
                    btn.BorderSizePixel = 0
                    local corner = Instance.new("UICorner")
                    corner.CornerRadius = UDim.new(0,5)
                    corner.Parent = btn
                    btn.Parent = favScroll
                    btn.MouseButton1Click:Connect(function()
                        if loc.cframe then
                            SmartTP(loc.cframe * CFrame.new(0,0,2))
                            addHistoryEntry(loc.name, loc.cframe)
                        end
                    end)
                end
            end
            favScroll.CanvasSize = UDim2.new(0,0,0, favLayout.AbsoluteContentSize.Y + 40)
        end

        -- History tab
        local histScroll = Instance.new("ScrollingFrame")
        histScroll.Size = UDim2.new(1, -4, 1, -30)
        histScroll.Position = UDim2.new(0, 2, 0, 2)
        histScroll.BackgroundTransparency = 1
        histScroll.BorderSizePixel = 0
        histScroll.CanvasSize = UDim2.new(0,0,0,0)
        histScroll.Parent = historyContent
        local histLayout = Instance.new("UIListLayout")
        histLayout.Padding = UDim.new(0, 3)
        histLayout.Parent = histScroll

        local function refreshHistory()
            for _, child in ipairs(histScroll:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            if #history == 0 then
                local emptyLabel = Instance.new("TextLabel")
                emptyLabel.Size = UDim2.new(1, 0, 0, 20)
                emptyLabel.Position = UDim2.new(0, 2, 0, 2)
                emptyLabel.BackgroundTransparency = 1
                emptyLabel.Text = getText("history_empty")
                emptyLabel.TextColor3 = Color3.new(0.7, 0.7, 0.7)
                emptyLabel.TextSize = 10
                emptyLabel.Font = Enum.Font.Gotham
                emptyLabel.Parent = histScroll
                histScroll.CanvasSize = UDim2.new(0,0,0,30)
                return
            end
            for _, entry in ipairs(history) do
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -4, 0, 22)
                btn.Position = UDim2.new(0, 2, 0, 0)
                local timeStr = os.date("%H:%M", entry.time)
                btn.Text = entry.name .. " (" .. timeStr .. ")"
                btn.TextColor3 = Color3.new(1,1,1)
                btn.TextSize = 10
                btn.Font = Enum.Font.GothamSemibold
                btn.BackgroundColor3 = Color3.new(0.2,0.5,0.8)
                btn.BackgroundTransparency = 0.2
                btn.BorderSizePixel = 0
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0,5)
                corner.Parent = btn
                btn.Parent = histScroll
                btn.MouseButton1Click:Connect(function()
                    if entry.cframe then
                        SmartTP(entry.cframe * CFrame.new(0,0,2))
                        addHistoryEntry(entry.name, entry.cframe)
                    end
                end)
            end
            histScroll.CanvasSize = UDim2.new(0,0,0, histLayout.AbsoluteContentSize.Y + 40)
        end

        local clearHistBtn = Instance.new("TextButton")
        clearHistBtn.Size = UDim2.new(0.8, 0, 0, 20)
        clearHistBtn.Position = UDim2.new(0.1, 0, 1, -24)
        clearHistBtn.Text = getText("clear_history")
        clearHistBtn.TextColor3 = Color3.new(1,1,1)
        clearHistBtn.BackgroundColor3 = Color3.new(0.5,0.1,0.1)
        clearHistBtn.BorderSizePixel = 0
        Instance.new("UICorner", clearHistBtn).CornerRadius = UDim.new(0,5)
        clearHistBtn.Parent = historyContent
        table.insert(textElements, clearHistBtn)
        clearHistBtn.MouseButton1Click:Connect(function()
            history = {}
            _G.TeleportHistory = {}
            refreshHistory()
        end)

        -- Other tab
        local function createOtherUtility(yPos, label, state, onToggle)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, -4, 0, 24)
            frame.Position = UDim2.new(0, 2, 0, yPos)
            frame.BackgroundTransparency = 1
            frame.Parent = otherContent

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.6, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = label
            lbl.TextColor3 = themes[currentTheme].textColor
            lbl.TextSize = 10
            lbl.Font = Enum.Font.GothamSemibold
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = frame
            table.insert(textElements, lbl)

            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, 45, 0, 20)
            btn.Position = UDim2.new(0.7, 0, 0.5, -10)
            btn.Text = state and "ON" or "OFF"
            btn.TextColor3 = Color3.new(1,1,1)
            btn.BackgroundColor3 = state and Color3.fromRGB(0,200,0) or Color3.fromRGB(80,80,80)
            btn.BorderSizePixel = 0
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0,4)
            btn.Parent = frame

            btn.MouseButton1Click:Connect(function()
                state = not state
                btn.Text = state and "ON" or "OFF"
                btn.BackgroundColor3 = state and Color3.fromRGB(0,200,0) or Color3.fromRGB(80,80,80)
                onToggle(state)
            end)
        end

        createOtherUtility(2, getText("anti_afk"), antiAFKEnabled, function(enabled)
            antiAFKEnabled = enabled
            if enabled then startAntiAFK() else stopAntiAFK() end
        end)
        createOtherUtility(28, getText("fps_ping"), showFPS, function(enabled)
            showFPS = enabled
            if enabled then startFPS() else stopFPS() end
        end)
        createOtherUtility(54, getText("fullbright"), fullbrightEnabled, function(enabled)
            if enabled then startFullbright() else stopFullbright() end
        end)
        createOtherUtility(80, getText("coords_display"), coordsDisplayEnabled, function(enabled)
            if enabled then startCoordsDisplay() else stopCoordsDisplay() end
        end)
        createOtherUtility(106, getText("timer"), timerEnabled, function(enabled)
            if enabled then startTimer() else stopTimer() end
        end)

        -- Places tab
        local placesScroll = Instance.new("ScrollingFrame")
        placesScroll.Size = UDim2.new(1, -4, 1, -4)
        placesScroll.Position = UDim2.new(0, 2, 0, 2)
        placesScroll.BackgroundTransparency = 1
        placesScroll.BorderSizePixel = 0
        placesScroll.CanvasSize = UDim2.new(0,0,0,0)
        placesScroll.Parent = placesContent
        local placesLayout = Instance.new("UIListLayout")
        placesLayout.Padding = UDim.new(0, 4)
        placesLayout.Parent = placesScroll

        local placeEntries = {
            {name = "Slap Battles", id = 6403373529},
            {name = "Barzil", id = 7234087065},
            {name = "Untitled Tag", id = 115782629143468},
            {name = "Glove Game", id = 127174121130060},
            {name = "Guide", id = 18550498098},
            {name = "DoorKeeper", id = 125845699717230},
            {name = "Plate", id = 106620300132058},
            {name = "Poltergeist", id = 103505724406848},
            {name = "G-X", id = 77283826005207},
        }
        for _, place in ipairs(placeEntries) do
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, -4, 0, 28)
            frame.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
            frame.BackgroundTransparency = 0.2
            frame.BorderSizePixel = 0
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0,6)
            frame.Parent = placesScroll

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -55, 1, 0)
            label.Position = UDim2.new(0, 4, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = place.name .. " (ID: " .. tostring(place.id) .. ")"
            label.TextColor3 = Color3.new(1,1,1)
            label.TextSize = 9
            label.Font = Enum.Font.GothamBold
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = frame
            table.insert(textElements, label)

            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, 50, 1, 0)
            btn.Position = UDim2.new(1, -52, 0, 0)
            btn.Text = getText("teleport_btn")
            btn.TextColor3 = Color3.new(1,1,1)
            btn.BackgroundColor3 = Color3.fromRGB(60, 180, 80)
            btn.BorderSizePixel = 0
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0,4)
            btn.Parent = frame
            table.insert(textElements, btn)
            btn.MouseButton1Click:Connect(function()
                -- Сохранить настройки для авто-перезапуска в новом плейсе
                _G.TeleportHubSettings = {
                    language = currentLang,
                    device = settings.device,
                    theme = currentTheme,
                    transparency = guiTransparency,
                    teleportSpeed = teleportSpeed,
                    playerTPOffset = playerTPOffset,
                    starsEnabled = starsEnabled,
                    _autoRestarted = true,
                    _targetPlaceId = place.id
                }
                _G.EscanorHubClosed = false
                -- Анимация кнопки ТП
                TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.new(1,1,1)}):Play()
                showNotification("🚀 Телепорт в " .. place.name .. "...", 3)
                task.delay(0.3, function()
                    local ok, err = pcall(function()
                        TeleportService:Teleport(place.id)
                    end)
                    if not ok then
                        showNotification("❌ Ошибка: " .. tostring(err), 3)
                    end
                end)
            end)
        end
        placesScroll.CanvasSize = UDim2.new(0, 0, 0, #placeEntries * 32 + 20)

        -- Help tab
        local helpScroll = Instance.new("ScrollingFrame")
        helpScroll.Size = UDim2.new(1, -4, 1, -4)
        helpScroll.Position = UDim2.new(0, 2, 0, 2)
        helpScroll.BackgroundTransparency = 1
        helpScroll.BorderSizePixel = 0
        helpScroll.CanvasSize = UDim2.new(0,0,0,0)
        helpScroll.Parent = helpContent
        local helpLayout = Instance.new("UIListLayout")
        helpLayout.Padding = UDim.new(0, 6)
        helpLayout.Parent = helpScroll
        local helpTitle = Instance.new("TextLabel")
        helpTitle.Size = UDim2.new(1, 0, 0, 18)
        helpTitle.BackgroundTransparency = 1
        helpTitle.Text = getText("help_title")
        helpTitle.TextColor3 = themes[currentTheme].textColor
        helpTitle.TextSize = 12
        helpTitle.Font = Enum.Font.GothamBold
        helpTitle.Parent = helpScroll
        themeElements.helpTitle = helpTitle
        table.insert(textElements, helpTitle)

        local helpText = Instance.new("TextLabel")
        helpText.Size = UDim2.new(1, 0, 0, 200)
        helpText.BackgroundTransparency = 1
        helpText.Text = getText("help_text")
        helpText.TextColor3 = themes[currentTheme].textColor
        helpText.TextSize = 9
        helpText.Font = Enum.Font.Gotham
        helpText.TextWrapped = true
        helpText.Parent = helpScroll
        themeElements.helpText = helpText
        table.insert(textElements, helpText)

        -- Подпись (увеличенная, внизу GUI)
        local creditLabel = Instance.new("TextLabel")
        creditLabel.Size = UDim2.new(1, -10, 0, 18)
        creditLabel.Position = UDim2.new(0, 5, 1, -20)
        creditLabel.BackgroundTransparency = 1
        creditLabel.Text = "🔥 By: Brobothotspot"
        creditLabel.TextColor3 = Color3.new(0.55, 0.5, 0.65)
        creditLabel.TextSize = isMobile and 8 or 10
        creditLabel.Font = Enum.Font.GothamSemibold
        creditLabel.TextXAlignment = Enum.TextXAlignment.Center
        creditLabel.Parent = mainFrame
        themeElements.creditLabel = creditLabel
        table.insert(textElements, creditLabel)

        locations = getLocationsForPlace(game.PlaceId)
        if not locations or #locations == 0 then locations = {} end

        local function switchTab(tab)
            currentTab = tab
            playersContent.Visible = (tab == "players")
            locationsContent.Visible = (tab == "locations")
            favoritesContent.Visible = (tab == "favorites")
            historyContent.Visible = (tab == "history")
            otherContent.Visible = (tab == "other")
            placesContent.Visible = (tab == "places")
            helpContent.Visible = (tab == "help")
            local t = themes[currentTheme]
            if t then
                tabPlayers.BackgroundColor3 = (tab=="players") and t.tabActive or t.tabInactive
                tabLocations.BackgroundColor3 = (tab=="locations") and t.tabActive or t.tabInactive
                tabFavorites.BackgroundColor3 = (tab=="favorites") and t.tabActive or t.tabInactive
                tabHistory.BackgroundColor3 = (tab=="history") and t.tabActive or t.tabInactive
                tabOther.BackgroundColor3 = (tab=="other") and t.tabActive or t.tabInactive
                tabPlaces.BackgroundColor3 = (tab=="places") and t.tabActive or t.tabInactive
                tabHelp.BackgroundColor3 = (tab=="help") and t.tabActive or t.tabInactive
            end
            if tab == "players" then refreshButtons()
            elseif tab == "locations" then refreshLocationsList()
            elseif tab == "favorites" then refreshFavorites()
            elseif tab == "history" then refreshHistory()
            end
        end

        tabPlayers.MouseButton1Click:Connect(function() switchTab("players") end)
        tabLocations.MouseButton1Click:Connect(function() switchTab("locations") end)
        tabFavorites.MouseButton1Click:Connect(function() switchTab("favorites") end)
        tabHistory.MouseButton1Click:Connect(function() switchTab("history") end)
        tabOther.MouseButton1Click:Connect(function() switchTab("other") end)
        tabPlaces.MouseButton1Click:Connect(function() switchTab("places") end)
        tabHelp.MouseButton1Click:Connect(function() switchTab("help") end)
        switchTab("players")

        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            searchFilter = searchBox.Text
            refreshButtons()
        end)

        -- Кнопка обновления списка (сортировка всегда по дистанции)
        sortBtn.Text = getText("sort_dist")
        sortBtn.MouseButton1Click:Connect(function()
            refreshButtons()
        end)

        createFloatingIcon()

        UserInput.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.K then
                if mainFrame then mainFrame.Visible = not mainFrame.Visible end
            end
            if input.KeyCode == Enum.KeyCode.M then
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    savedPosition = hrp.CFrame
                    LP:Chat(getText("pos_saved").." (M)")
                    addCurrentLocation()
                else
                    LP:Chat(getText("cant_save"))
                end
            end
            if input.KeyCode == Enum.KeyCode.L then
                if autoTeleportActive then stopAutoTeleport()
                else
                    if autoTargetPlayer then startAutoTeleport(autoTargetPlayer)
                    else LP:Chat(getText("select_player_first")) end
                end
            end
            if input.KeyCode == Enum.KeyCode.P then
                if not guiDestroyed then destroyGUI() end
            end
        end)

        Players.PlayerAdded:Connect(refreshButtons)
        Players.PlayerRemoving:Connect(refreshButtons)
        refreshButtons()
        refreshLocationsList()

        connection = RunService.RenderStepped:Connect(function(dt)
            if not sg or not sg.Parent then if connection then connection:Disconnect() end return end
            hue = (hue + dt * 1.2) % (math.pi * 2)

            -- Получить параметры переливания для текущей темы
            local t = themes[currentTheme] or themes["dark"]

            -- === ПЕРЕЛИВАЮЩАЯСЯ РАМКА ОСНОВНОГО GUI ===
            if themeElements.mainStroke then
                themeElements.mainStroke.Color = getShimmerColor(t, hue)
            end

            -- === ПЕРЕЛИВАЮЩАЯСЯ РАМКА ВЕРХНЕЙ ПАНЕЛИ ===
            if themeElements.topStroke then
                themeElements.topStroke.Color = getShimmerColorOffset(t, hue, 1.0)
            end

            -- === ПЕРЕЛИВАЮЩИЙСЯ ГРАДИЕНТ ФОНА ===
            if themeElements.mainGradient then
                local bgCol1 = getShimmerColorDim(t, hue * 0.7, 0.18)
                local bgCol2 = getShimmerColorDim(t, hue * 0.7 + 0.5, 0.10)
                themeElements.mainGradient.Color = ColorSequence.new{
                    ColorSequenceKeypoint.new(0, bgCol1),
                    ColorSequenceKeypoint.new(1, bgCol2)
                }
                themeElements.mainGradient.Rotation = 45 + math.sin(hue * 0.4) * 20
            end

            -- === ПЕРЕЛИВАЮЩИЙСЯ ГРАДИЕНТ ВЕРХНЕЙ ПАНЕЛИ ===
            if themeElements.topGradient then
                local topCol1 = getShimmerColorDim(t, hue * 0.9, 0.30)
                local topCol2 = getShimmerColorDim(t, hue * 0.9 + 0.8, 0.20)
                themeElements.topGradient.Color = ColorSequence.new{
                    ColorSequenceKeypoint.new(0, topCol1),
                    ColorSequenceKeypoint.new(1, topCol2)
                }
            end

            -- === ПЕРЕЛИВАНИЕ КНОПОК ИГРОКОВ ===
            local playerCol = getShimmerColor(t, hue * 1.3)
            for _, b in ipairs(btns) do
                if b and b.Parent then
                    if autoTeleportActive and autoTargetPlayer and b.Text:find(autoTargetPlayer.Name) then
                        b.BackgroundColor3 = Color3.new(0,0.9,0)
                        b.BackgroundTransparency = 0.1
                    else
                        b.BackgroundColor3 = playerCol
                        b.BackgroundTransparency = 0.2
                    end
                end
            end
            updateCoordsLabel()
            -- Обновление дистанции на кнопках игроков каждый кадр
            updatePlayerDistances()
        end)

        applyTheme(currentTheme)

        -- ===== АНИМАЦИЯ ПОЯВЛЕНИЯ GUI =====
        -- Начинаем маленьким и прозрачным, разворачиваемся с эффектом Back
        mainFrame.Size = UDim2.new(0, guiWidth * 0.3, 0, guiHeight * 0.3)
        mainFrame.Position = UDim2.new(0.5, -guiWidth * 0.15, 0.5, -guiHeight * 0.15)
        mainFrame.BackgroundTransparency = 1
        if themeElements.mainStroke then themeElements.mainStroke.Transparency = 1 end
        task.delay(0.05, function()
            if not mainFrame or not mainFrame.Parent then return end
            TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, guiWidth, 0, guiHeight),
                Position = UDim2.new(0.5, -guiWidth/2, 0.5, -guiHeight/2),
                BackgroundTransparency = guiTransparency
            }):Play()
            if themeElements.mainStroke then
                TweenService:Create(themeElements.mainStroke, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
                    Transparency = 0.1
                }):Play()
            end
        end)

        -- Уведомление при авто-перезапуске
        if _G.TeleportHubSettings and _G.TeleportHubSettings._autoRestarted then
            task.delay(1, function()
                showNotification("🔄 Escanor HUB перезапущен!", 2)
            end)
            _G.TeleportHubSettings._autoRestarted = nil
        end
    end

    local function onCharacterAdded()
        task.wait(0.5)
        if guiDestroyed then return end
        if sg and sg.Parent then
            showMainGUI()
            refreshButtons()
            refreshLocationsList()
        else
            createGUI()
        end
    end

    createGUI()
    _G.EscanorHubClosed = false -- GUI открыт — разрешить авто-перезапуск
    LP.CharacterAdded:Connect(onCharacterAdded)
    LP:Chat("🔥 Escanor HUB v1.2 загружен! By: Brobothotspot")

    if antiAFKEnabled then startAntiAFK() end
    if showFPS then startFPS() end
    if fullbrightEnabled then startFullbright() end
    if coordsDisplayEnabled then startCoordsDisplay() end
    if timerEnabled then startTimer() end
end

-- ===== АВТО-ДЕТЕКТ PLACE ID И ПЕРЕЗАПУСК =====
-- Если текущий плейс в списке поддерживаемых — скрипт работает
-- Если нет — всё равно запускаем (пользователь мог вручную запустить)
local currentPlaceId = game.PlaceId
local isSupported = SUPPORTED_PLACE_IDS[currentPlaceId] ~= nil

-- При телепортации через Places tab, скрипт перезапускается через loadstring
-- Здесь мы детектим что уже в новом плейсе и запускаем GUI
if _G.EscanorHubAlreadyRunning then
    warn("Escanor HUB уже запущен в этом плейсе.")
    return
end
_G.EscanorHubAlreadyRunning = true

-- ===== ТОЧКА ВХОДА =====
if not _G.TeleportHubSettings or not _G.TeleportHubSettings.language then
    -- Первый запуск или после сброса — показать лаунчер
    showLauncher()
else
    -- Настройки уже есть (авто-перезапуск или повторный запуск)
    StartEscanorHub_Common()
end
