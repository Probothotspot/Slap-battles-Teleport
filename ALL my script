-- ==================== Перетаскивание окна настроек ====================
local settIsDragging = false
local settDragStart = Vector2.new()
local settStartPos = UDim2.new()

local function findSettInteractiveUnderPoint(point)
    for _, child in pairs(settingsWindow:GetDescendants()) do
        if child:IsA("TextButton") or child:IsA("ImageButton") then
            if child.Active then
                local absPos = child.AbsolutePosition
                local absSize = child.AbsoluteSize
                if point.X >= absPos.X and point.X <= absPos.X + absSize.X and
                   point.Y >= absPos.Y and point.Y <= absPos.Y + absSize.Y then
                    return true
                end
            end
        end
    end
    return false
end

settingsWindow.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local pos = input.Position
        if findSettInteractiveUnderPoint(pos) then
            return
        end
        settIsDragging = true
        settDragStart = pos
        settStartPos = settingsWindow.Position
    end
end)

settingsWindow.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        settIsDragging = false
    end
end)

settingsWindow.InputChanged:Connect(function(input)
    if settIsDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - settDragStart
        settingsWindow.Position = UDim2.new(
            settStartPos.X.Scale, settStartPos.X.Offset + delta.X,
            settStartPos.Y.Scale, settStartPos.Y.Offset + delta.Y
        )
    end
end)

