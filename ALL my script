local currentLang = "en"
local langBindings = {}

local function t(key)
    return translations[currentLang] and translations[currentLang][key] or key
end

local function bindText(obj, key)
    langBindings[obj] = key
    obj.Text = t(key)
end

local function updateAllTexts()
    for obj, key in pairs(langBindings) do
        if obj and obj.Parent then
            obj.Text = t(key)
        end
    end
end

