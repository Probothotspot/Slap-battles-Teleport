-- ==================== Радужная кнопка ====================
local function createRainbowButton(parentFrame, textKey, callback)
    local btn = Instance.new("TextButton", parentFrame)
    btn.Size = UDim2.new(0.9, 0, 0, 28)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    if textKey then
        bindText(btn, textKey)
    else
        btn.Text = ""
    end

    local uiGradient = Instance.new("UIGradient", btn)
    uiGradient.Rotation = 0
    uiGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 165, 0)),
        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
    })

    local startTime = tick()
    local connection
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        if not btn or not btn.Parent then
            connection:Disconnect()
            return
        end
        local elapsed = tick() - startTime
        uiGradient.Offset = Vector2.new((elapsed * 0.1) % 1, 0)
    end)

    if callback then
        btn.MouseButton1Click:Connect(callback)
    end
    return btn
end

-- ==================== Вкладки ====================
local tabButtons = {}
local currentTab = 1

local function applyTheme(themeName)
    local theme = themes[themeName]
    if not theme then return end
    currentTheme = themeName

    main.BackgroundColor3 = theme.mainBg
    mainGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, theme.mainGradientStart),
        ColorSequenceKeypoint.new(1, theme.mainGradientEnd)
    })
    titleBar.BackgroundColor3 = theme.titleBg
    minimizeBtn.BackgroundColor3 = theme.buttonBg
    closeBtn.BackgroundColor3 = theme.buttonBg
    settingsBtn.BackgroundColor3 = theme.buttonBg
    stroke.Color = theme.strokeBase
    tabBar.ScrollBarImageColor3 = theme.tabActive

    for i, btn in ipairs(tabButtons) do
        if i == currentTab then
            btn.BackgroundColor3 = theme.tabActive
        else
            btn.BackgroundColor3 = theme.tabInactive
        end
        btn.TextColor3 = Color3.new(1, 1, 1)
    end
end

local function setActiveTab(index)
    currentTab = index
    local theme = themes[currentTheme]
    for i, btn in ipairs(tabButtons) do
        btn.BackgroundColor3 = (i == index) and theme.tabActive or theme.tabInactive
        btn.TextColor3 = Color3.new(1, 1, 1)
    end
    for _, frame in ipairs(tabContent:GetChildren()) do
        if frame:IsA("Frame") then
            local num = tonumber(frame.Name:match("TabFrame(%d+)"))
            frame.Visible = (num == index)
        end
    end
end

local function createTabUI()
    for _, child in pairs(tabBar:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, child in pairs(tabContent:GetChildren()) do
        child:Destroy()
    end
    tabButtons = {}

    local tabWidth = 100
    local spacing = 4

    for i = 1, #scripts do
        local tabBtn = Instance.new("TextButton", tabBar)
        tabBtn.Size = UDim2.new(0, tabWidth, 0, 22)
        tabBtn.Position = UDim2.new(0, (i-1)*(tabWidth+spacing), 0.5, -11)
        tabBtn.TextColor3 = Color3.new(1, 1, 1)
        tabBtn.Font = Enum.Font.GothamSemibold
        tabBtn.TextSize = 11
        tabBtn.BorderSizePixel = 0
        Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 4)
        bindText(tabBtn, "tab_name_" .. i)
        tabButtons[i] = tabBtn

        local idx = i
        tabBtn.MouseButton1Click:Connect(function()
            setActiveTab(idx)
        end)

        local frame = Instance.new("Frame", tabContent)
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 1
        frame.Visible = (i == 1)
        frame.Name = "TabFrame" .. i

        local layout = Instance.new("UIListLayout", frame)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 4)
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.VerticalAlignment = Enum.VerticalAlignment.Top

        local title = Instance.new("TextLabel", frame)
        title.Size = UDim2.new(1, -12, 0, 20)
        title.LayoutOrder = 1
        title.Font = Enum.Font.GothamBold
        title.TextSize = 13
        title.BackgroundTransparency = 1
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextColor3 = Color3.new(1, 1, 1)
        bindText(title, "tab_name_" .. i)

        local desc = Instance.new("TextLabel", frame)
        desc.Size = UDim2.new(1, -12, 0, 0)
        desc.LayoutOrder = 2
        desc.Font = Enum.Font.Gotham
        desc.TextSize = 10
        desc.TextWrapped = true
        desc.BackgroundTransparency = 1
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.AutomaticSize = Enum.AutomaticSize.Y
        desc.TextColor3 = Color3.new(1, 1, 1)
        bindText(desc, "tab_desc_" .. i)

        local execBtn = createRainbowButton(frame, "execute", function()
            local ok, err = pcall(function()
                loadstring(scripts[i])()
            end)
            if not ok then
                warn("Script error: " .. tostring(err))
            end
        end)
        execBtn.LayoutOrder = 3
    end

    local totalWidth = #scripts * (tabWidth + spacing) + spacing
    tabBar.CanvasSize = UDim2.new(0, totalWidth, 0, 0)

    setActiveTab(1)
end

