local isMinimized = false
local originalSize = UDim2.new(0, 250, 0, 175)
local minimizedSize = UDim2.new(0, 250, 0, 32)
local tweenService = game:GetService("TweenService")
local minimizeTween

local function toggleMinimize()
    isMinimized = not isMinimized
    if minimizeTween then minimizeTween:Cancel() end
    if isMinimized then
        contentFrame.Visible = false
        minimizeBtn.Text = "+"
        minimizeTween = tweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = minimizedSize
        })
    else
        minimizeTween = tweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = originalSize
        })
        contentFrame.Visible = true
        minimizeBtn.Text = "–"
    end
    minimizeTween:Play()
end
minimizeBtn.MouseButton1Click:Connect(toggleMinimize)

