-- ======================== ПЕРЕТАСКИВАНИЕ ========================
local isDragging = false
local dragStartPos = nil
local panelStartPos = nil
local connections = {}

-- Движение мыши/пальца (по-прежнему через UIS, чтобы ловить перемещения за пределами dragZone)
local function onInputChanged(input, gameProcessedEvent)
	if not isDragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement or
		input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragStartPos
		mainPanel.Position = UDim2.new(
			panelStartPos.X.Scale, panelStartPos.X.Offset + delta.X,
			panelStartPos.Y.Scale, panelStartPos.Y.Offset + delta.Y
		)
	end
end

-- Окончание перетаскивания
local function onInputEnded(input, gameProcessedEvent)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or
		input.UserInputType == Enum.UserInputType.Touch then
		isDragging = false
		dragStartPos = nil
		panelStartPos = nil
	end
end

-- Начало перетаскивания — теперь сохраняем соединение в таблицу
table.insert(connections, dragZone.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or
		input.UserInputType == Enum.UserInputType.Touch then
		isDragging = true
		dragStartPos = input.Position
		panelStartPos = mainPanel.Position
	end
end))

-- Подключаем оставшиеся события ввода
table.insert(connections, UIS.InputChanged:Connect(onInputChanged))
table.insert(connections, UIS.InputEnded:Connect(onInputEnded))

-- ======================== ЛОГИКА СВОРАЧИВАНИЯ / РАЗВОРАЧИВАНИЯ ========================
local isMinimized = false
local originalSize = mainPanel.Size
local minimizedSize = UDim2.new(0, 220, 0, 32)

local function minimizePanel()
	if isMinimized then return end
	isMinimized = true
	local goal = {Size = minimizedSize}
	local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TS:Create(mainPanel, tweenInfo, goal)
	tween:Play()
	contentFrame.Visible = false
	minimizeBtn.Text = "➕"
end

local function maximizePanel()
	if not isMinimized then return end
	isMinimized = false
	local goal = {Size = originalSize}
	local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TS:Create(mainPanel, tweenInfo, goal)
	tween:Play()
	-- Контент появляется только после завершения анимации разворачивания,
	-- если панель всё ещё не свёрнута (предотвращает гонку при быстром сворачивании)
	task.delay(0.25, function()
		if not isMinimized then
			contentFrame.Visible = true
		end
	end)
	minimizeBtn.Text = "➖"
end

-- Подключения кнопок сворачивания/разворачивания, закрытия и восстановления
table.insert(connections, minimizeBtn.Activated:Connect(function()
	if isMinimized then
		maximizePanel()
	else
		minimizePanel()
	end
end))

table.insert(connections, closeBtn.Activated:Connect(function()
	mainPanel.Visible = false
	floatingBtn.Visible = true
end))

table.insert(connections, floatingBtn.Activated:Connect(function()
	floatingBtn.Visible = false
	mainPanel.Visible = true
	if isMinimized then
		maximizePanel()
	end
end))

-- ======================== БЕЗОПАСНЫЙ ВЫЗОВ REMOTE FUNCTION (с флагом успеха) ========================
local function safeInvoke(currentGen)
	local done = false
	-- Запускаем InvokeServer в отдельной нити
	task.spawn(function()
		pcall(function()
			GlovelFunc:InvokeServer()
		end)
		done = true
	end)
	-- Ожидание с ограничением по времени и возможностью прервать при остановке
	local startTime = os.clock()
	while not done
		and (os.clock() - startTime) < INVOKE_TIMEOUT
		and autoDigEnabled
		and generation == currentGen
	do
		task.wait(0.1)
	end
	-- Возвращаем true только если сервер успел ответить (done == true)
	return done
end

-- ======================== ЛОГИКА AUTODIG ========================
local function autoDigLoop(currentGen)
	while autoDigEnabled and generation == currentGen do
		local success = safeInvoke(currentGen)
		if not autoDigEnabled or generation ~= currentGen then break end
		if success then
			-- Увеличиваем счётчик только при реальном ответе сервера
			invokeCount = invokeCount + 1
			task.wait() -- короткая пауза после успешного вызова
		else
			-- При таймауте ждём, но не блокируем остановку — разбиваем на шаги
			local retryStart = os.clock()
			while (os.clock() - retryStart) < INVOKE_TIMEOUT
				and autoDigEnabled
				and generation == currentGen
			do
				task.wait(0.1)
			end
		end
	end
end

-- Обновление кнопки СТАРТ/СТОП
local function updateActionButton()
	local targetColor = autoDigEnabled and BTN_STOP_BG or BTN_START_BG
	local targetText = autoDigEnabled and "⏹ СТОП" or "▶ СТАРТ"
	actionBtn.Text = targetText
	local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TS:Create(actionBtn, tweenInfo, {BackgroundColor3 = targetColor})
	tween:Play()
end

local function toggleAutoDig()
	if autoDigEnabled then
		autoDigEnabled = false
	else
		autoDigEnabled = true
		generation = generation + 1
		local currentGen = generation
		task.spawn(autoDigLoop, currentGen)
	end
	updateActionButton()
end

-- Подключение кнопки старт/стоп
table.insert(connections, actionBtn.Activated:Connect(toggleAutoDig))

-- ======================== АНИМАЦИЯ ПЕРЕЛИВАНИЯ ОБВОДКИ ========================
local function updateBorderAnimation()
	local t = (math.sin(os.clock() * 2) + 1) / 2
	local r = BORDER_COLOR1.R + (BORDER_COLOR2.R - BORDER_COLOR1.R) * t
	local g = BORDER_COLOR1.G + (BORDER_COLOR2.G - BORDER_COLOR1.G) * t
	local b = BORDER_COLOR1.B + (BORDER_COLOR2.B - BORDER_COLOR1.B) * t
	local color = Color3.new(r, g, b)
	stroke.Color = color
	if floatingBtn.Visible then
		floatingStroke.Color = color
	end
end

-- ======================== ОБНОВЛЕНИЕ ИНФОРМАЦИИ В GUI ========================
local function updateStatusDisplay()
	local statusText = autoDigEnabled and "Активен 🟢" or "Стоп 🔴"
	statusValue.Text = statusText
	statusValue.TextColor3 = autoDigEnabled and STATUS_ACTIVE or STATUS_STOP
	invokesValue.Text = tostring(invokeCount)
end

-- ======================== ГЛАВНЫЙ ЦИКЛ ОБНОВЛЕНИЯ ========================
table.insert(connections, RunService.Heartbeat:Connect(function()
	updateBorderAnimation()
	if mainPanel.Visible then
		updateStatusDisplay()
	end
end))

-- ======================== ОЧИСТКА ПРИ УДАЛЕНИИ ========================
screenGui.Destroying:Connect(function()
	autoDigEnabled = false
	generation = generation + 1
	for _, conn in ipairs(connections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	connections = {}
end)

-- ======================== ПЕРВОНАЧАЛЬНОЕ ОБНОВЛЕНИЕ ========================
updateActionButton()
updateStatusDisplay()
