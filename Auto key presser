-- ═══════════════════════════════════════
-- smartWait: мгновенная остановка
-- Использует os.clock() для точного замера
-- Проверяет running каждый фрейм
-- Возвращает false если running стал false
-- ═══════════════════════════════════════
local function smartWait(seconds)
    if seconds <= 0 then
        task.wait()
        return running and not destroyed
    end
    local startTime = os.clock()
    while (os.clock() - startTime) < seconds do
        if not running or destroyed then
            return false
        end
        task.wait() -- ждём 1 фрейм (~0.016с), но проверяем running
    end
    return running and not destroyed
end

