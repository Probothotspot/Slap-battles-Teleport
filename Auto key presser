local function startLoop()
    task.spawn(function()

        -- ═══ РЕЖИМ: СПАМ ═══
        if CONFIG.Mode == "spam" then
            while running and not destroyed do
                -- Нажать и отпустить
                VIM:SendKeyEvent(true, CONFIG.Key, false, game)
                task.wait(0.001)
                VIM:SendKeyEvent(false, CONFIG.Key, false, game)

                -- Счётчик
                pressCount = pressCount + 1
                pcall(function()
                    CounterLabel.Text = "Нажатий: " .. pressCount
                end)

                -- Вспышка
                pcall(function()
                    TweenService:Create(KeyValue, TweenInfo.new(0.05), {BackgroundTransparency = 0.5}):Play()
                end)
                task.wait(0.03)
                pcall(function()
                    TweenService:Create(KeyValue, TweenInfo.new(0.05), {BackgroundTransparency = 0.85}):Play()
                end)

                -- Лимит
                if CONFIG.MaxPresses > 0 and pressCount >= CONFIG.MaxPresses then
                    running = false
                    updateStatus()
                    pcall(function() StatusLabel.Text = "Готово ✅" end)
                    break
                end

                -- Пауза (мгновенно прерывается)
                if not smartWait(CONFIG.Interval) then break end
            end
            forceRelease()

        -- ═══ РЕЖИМ: ЗАЖАТИЕ ═══
        -- Зажимает клавишу, отправляя true каждый фрейм
        -- Потом отпускает, ждёт кулдаун, повторяет
        elseif CONFIG.Mode == "hold" then
            while running and not destroyed do
                -- === ФАЗА ЗАЖАТИЯ ===
                pcall(function()
                    KeyValue.BackgroundTransparency = 0.5
                    StatusLabel.Text = "Зажато 🔒"
                    StatusLabel.TextColor3 = Color3.fromRGB(250, 204, 21)
                end)

                -- Держим клавишу: отправляем true каждый фрейм в течение HoldTime
                local holdStart = os.clock()
                while (os.clock() - holdStart) < CONFIG.HoldTime do
                    if not running or destroyed then
                        -- Мгновенно отпускаем при стопе
                        VIM:SendKeyEvent(false, CONFIG.Key, false, game)
                        forceRelease()
                        break
                    end
                    VIM:SendKeyEvent(true, CONFIG.Key, false, game)
                    task.wait()
                end

                -- Проверяем не остановлено ли
                if not running or destroyed then
                    VIM:SendKeyEvent(false, CONFIG.Key, false, game)
                    forceRelease()
                    break
                end

                -- === ФАЗА ОТПУСКАНИЯ ===
                VIM:SendKeyEvent(false, CONFIG.Key, false, game)
                pressCount = pressCount + 1
                pcall(function()
                    CounterLabel.Text = "Циклов: " .. pressCount
                    KeyValue.BackgroundTransparency = 0.85
                    StatusLabel.Text = "Кулдаун ⏳"
                    StatusLabel.TextColor3 = Color3.fromRGB(139, 92, 246)
                end)

                -- === ФАЗА КУЛДАУНА ===
                if not smartWait(CONFIG.Interval) then break end
            end
            -- Гарантия: отпустить при любом выходе
            VIM:SendKeyEvent(false, CONFIG.Key, false, game)
            forceRelease()

        -- ═══ РЕЖИМ: КОМБО ═══
        elseif CONFIG.Mode == "combo" then
            if #CONFIG.ComboKeys == 0 then
                running = false
                updateStatus()
                pcall(function() StatusLabel.Text = "Добавь клавиши!" end)
                return
            end

            local comboIndex = 1
            while running and not destroyed do
                local currentKey = CONFIG.ComboKeys[comboIndex]
                local keyName = tostring(currentKey):gsub("Enum.KeyCode.", "")

                -- Нажать и отпустить текущую клавишу
                VIM:SendKeyEvent(true, currentKey, false, game)
                task.wait(0.001)
                VIM:SendKeyEvent(false, currentKey, false, game)

                -- Обновить счётчик и дисплей
                pressCount = pressCount + 1
                pcall(function()
                    CounterLabel.Text = "Нажатий: " .. pressCount
                    KeyValue.Text = keyName
                    StatusLabel.Text = keyName .. " [" .. comboIndex .. "/" .. #CONFIG.ComboKeys .. "]"
                    StatusLabel.TextColor3 = Color3.fromRGB(34, 197, 94)
                end)

                -- Вспышка
                pcall(function()
                    TweenService:Create(KeyValue, TweenInfo.new(0.05), {BackgroundTransparency = 0.5}):Play()
                end)
                task.wait(0.03)
                pcall(function()
                    TweenService:Create(KeyValue, TweenInfo.new(0.05), {BackgroundTransparency = 0.85}):Play()
                end)

                -- Следующая клавиша по циклу
                comboIndex = comboIndex + 1
                if comboIndex > #CONFIG.ComboKeys then
                    comboIndex = 1
                end

                -- КД между клавишами (мгновенно прерывается)
                if not smartWait(CONFIG.ComboCooldown) then break end
            end
            forceRelease()
        end
    end)
end

