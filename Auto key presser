local keyPickerTarget = "main" -- "main" или "combo"
local keyButtons = {} -- хранилище {btn, keyName, displayName}

for i, keyName in ipairs(allKeys) do
    local displayName = shortNames[keyName] or keyName

    local btn = Instance.new("TextButton")
    btn.Name = "KB_" .. keyName
    btn.Size = UDim2.new(0, 42, 0, 24)
    btn.BackgroundColor3 = Color3.fromRGB(124, 58, 237)
    btn.BackgroundTransparency = 0.85
    btn.Text = displayName
    btn.TextColor3 = Color3.fromRGB(233, 213, 255)
    btn.TextSize = 9
    btn.Font = Enum.Font.Code
    btn.BorderSizePixel = 0
    btn.LayoutOrder = i
    btn.ZIndex = 52
    btn.Parent = KPScroll
    makeCorner(btn, 4)

    table.insert(keyButtons, {btn = btn, keyName = keyName, displayName = displayName})

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundTransparency = 0.5
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundTransparency = 0.85
        }):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        local keyCode = Enum.KeyCode[keyName]
        if not keyCode then return end

        if keyPickerTarget == "combo" then
            table.insert(CONFIG.ComboKeys, keyCode)
            updateComboDisp()
        else
            CONFIG.Key = keyCode
            KeyValue.Text = displayName
        end

        -- Закрыть пикер
        KeyPickerFrame.Visible = false
        keyPickerOpen = false
        KPSearch.Text = ""
    end)
end

-- Фильтрация по поиску
local function filterKeys(query)
    query = string.lower(query)
    for _, entry in ipairs(keyButtons) do
        local match = query == ""
            or string.find(string.lower(entry.keyName), query, 1, true)
            or string.find(string.lower(entry.displayName), query, 1, true)
        entry.btn.Visible = match
    end
    -- Обновить CanvasSize после фильтрации
    task.defer(function()
        local contentSize = KPGrid.AbsoluteContentSize
        KPScroll.CanvasSize = UDim2.new(0, 0, 0, contentSize.Y + 12)
    end)
end

KPSearch:GetPropertyChangedSignal("Text"):Connect(function()
    filterKeys(KPSearch.Text)
end)

-- Рассчитываем CanvasSize вручную
task.defer(function()
    local contentSize = KPGrid.AbsoluteContentSize
    KPScroll.CanvasSize = UDim2.new(0, 0, 0, contentSize.Y + 12)
end)

local function openKeyPicker(target)
    if running then return end
    keyPickerTarget = target or "main"
    keyPickerOpen = true
    KPSearch.Text = ""
    filterKeys("")
    KeyPickerFrame.Visible = true
    KPTitle.Text = (target == "combo") and "📋 Добавь в комбо" or "📋 Выбери клавишу"
end

local function closeKeyPicker()
    KeyPickerFrame.Visible = false
    keyPickerOpen = false
end

KPClose.MouseButton1Click:Connect(closeKeyPicker)

