-- ═══════════════════════════════════════
-- ГОРЯЧИЕ КЛАВИШИ + НАЗНАЧЕНИЕ
-- ═══════════════════════════════════════
connections.input = UIS.InputBegan:Connect(function(input, gameProcessed)
    if destroyed then return end

    -- === Назначение клавиши в Комбо (нажатием) ===
    if listeningCombo then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= CONFIG.DestroyKey and input.KeyCode ~= CONFIG.ToggleKey then
                table.insert(CONFIG.ComboKeys, input.KeyCode)
            end
            listeningCombo = false
            ComboAddBtn.Text = "⌨"
            ComboAddBtn.BackgroundTransparency = 0.65
            updateComboDisp()
            TweenService:Create(ComboDisp, TweenInfo.new(0.2), {
                BackgroundTransparency = 0.85
            }):Play()
        end
        return
    end

    -- === Назначение основной клавиши (нажатием) ===
    if listeningForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == CONFIG.DestroyKey or input.KeyCode == CONFIG.ToggleKey then
                KeyValue.Text = tostring(CONFIG.Key):gsub("Enum.KeyCode.", "")
                KCB.Text = "⌨"
                listeningForKey = false
                TweenService:Create(KeyValue, TweenInfo.new(0.2), {BackgroundTransparency = 0.85}):Play()
                return
            end
            CONFIG.Key = input.KeyCode
            KeyValue.Text = tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
            KCB.Text = "⌨"
            listeningForKey = false
            TweenService:Create(KeyValue, TweenInfo.new(0.2), {BackgroundTransparency = 0.85}):Play()
        end
        return
    end

    if gameProcessed then return end

    -- === Toggle (вкл/выкл) ===
    if input.KeyCode == CONFIG.ToggleKey then
        if running then
            running = false
            forceRelease()
            updateStatus()
        else
            running = true
            pressCount = 0
            updateStatus()
            startLoop()
        end
    end

    -- === Destroy GUI ===
    if input.KeyCode == CONFIG.DestroyKey then
        destroyAll()
    end
end)

