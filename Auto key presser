local function makeDualTime(parent, yPos, labelText, defaultMs, onChanged)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.28, 0, 0, 24)
    lbl.Position = UDim2.new(0, 12, 0, yPos)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(139, 92, 246)
    lbl.TextSize = 9
    lbl.Font = Enum.Font.Code
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = parent

    -- Секунды (целые)
    local secBox = Instance.new("TextBox")
    secBox.Size = UDim2.new(0, 36, 0, 24)
    secBox.Position = UDim2.new(0.28, 2, 0, yPos)
    secBox.BackgroundColor3 = Color3.fromRGB(124, 58, 237)
    secBox.BackgroundTransparency = 0.85
    secBox.Text = tostring(math.floor(defaultMs / 1000))
    secBox.TextColor3 = Color3.fromRGB(233, 213, 255)
    secBox.TextSize = 10
    secBox.Font = Enum.Font.Code
    secBox.BorderSizePixel = 0
    secBox.ClearTextOnFocus = false
    secBox.Parent = parent
    makeCorner(secBox, 4)
    makeStroke(secBox, Color3.fromRGB(124, 58, 237), 0.65)

    local secLabel = Instance.new("TextLabel")
    secLabel.Size = UDim2.new(0, 14, 0, 24)
    secLabel.Position = UDim2.new(0.28, 40, 0, yPos)
    secLabel.BackgroundTransparency = 1
    secLabel.Text = "с"
    secLabel.TextColor3 = Color3.fromRGB(100, 80, 160)
    secLabel.TextSize = 8
    secLabel.Font = Enum.Font.Code
    secLabel.Parent = parent

    -- Миллисекунды (0-999)
    local msBox = Instance.new("TextBox")
    msBox.Size = UDim2.new(0, 42, 0, 24)
    msBox.Position = UDim2.new(0.28, 56, 0, yPos)
    msBox.BackgroundColor3 = Color3.fromRGB(124, 58, 237)
    msBox.BackgroundTransparency = 0.85
    msBox.Text = tostring(defaultMs % 1000)
    msBox.TextColor3 = Color3.fromRGB(233, 213, 255)
    msBox.TextSize = 10
    msBox.Font = Enum.Font.Code
    msBox.BorderSizePixel = 0
    msBox.ClearTextOnFocus = false
    msBox.Parent = parent
    makeCorner(msBox, 4)
    makeStroke(msBox, Color3.fromRGB(124, 58, 237), 0.65)

    local msLabel = Instance.new("TextLabel")
    msLabel.Size = UDim2.new(0, 18, 0, 24)
    msLabel.Position = UDim2.new(0.28, 100, 0, yPos)
    msLabel.BackgroundTransparency = 1
    msLabel.Text = "мс"
    msLabel.TextColor3 = Color3.fromRGB(100, 80, 160)
    msLabel.TextSize = 8
    msLabel.Font = Enum.Font.Code
    msLabel.Parent = parent

    -- Синхронизация
    local function syncBoth(totalMs)
        totalMs = math.clamp(math.floor(totalMs), 0, 60000)
        local secs = math.floor(totalMs / 1000)
        local ms = totalMs % 1000
        secBox.Text = tostring(secs)
        msBox.Text = tostring(ms)
        if onChanged then
            onChanged(totalMs)
        end
    end

    msBox.FocusLost:Connect(function()
        local s = tonumber(secBox.Text) or 0
        local m = tonumber(msBox.Text) or 0
        s = math.max(0, math.floor(s))
        m = math.clamp(math.floor(m), 0, 999)
        syncBoth(s * 1000 + m)
    end)

    secBox.FocusLost:Connect(function()
        local s = tonumber(secBox.Text) or 0
        local m = tonumber(msBox.Text) or 0
        s = math.clamp(math.floor(s), 0, 60)
        m = math.clamp(math.floor(m), 0, 999)
        syncBoth(s * 1000 + m)
    end)

    return { syncBoth = syncBoth }
