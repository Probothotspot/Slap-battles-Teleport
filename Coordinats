--[[
    Real-Time Coordinates Display v1.0
    - Расширенное окно 180x60, координаты во всю ширину
    - Кнопки 📋 и ❌ сдвинуты вправо, подпись полностью видна
    - Клик по миру – маркер, копирование в буфер, удаление по P или ❌
    Совместимость: Xeno, Delta, Synapse X, KRNL и др.
]]
 
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
 
while not LocalPlayer do task.wait() end
 
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CoordsDisplay"
ScreenGui.ResetOnSpawn = false
ScreenGui.DisplayOrder = 99999
ScreenGui.IgnoreGuiInset = true
 
local parentSet = false
pcall(function()
    ScreenGui.Parent = game:GetService("CoreGui")
    parentSet = true
end)
if not parentSet then
    pcall(function()
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
        parentSet = true
    end)
end
if not parentSet then error("Не удалось создать GUI") return end
 
-- === ГЛАВНОЕ ОКНО (180x60, тёмно-фиолетовое) ===
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 180, 0, 60)
MainFrame.Position = UDim2.new(0.5, -90, 0, 10)
MainFrame.BackgroundColor3 = Color3.fromRGB(60, 0, 120)
MainFrame.BorderSizePixel = 0
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 6)
corner.Parent = MainFrame
MainFrame.Parent = ScreenGui
 
-- Поле координат
local CoordsLabel = Instance.new("TextLabel")
CoordsLabel.Size = UDim2.new(1, -6, 0, 30)
CoordsLabel.Position = UDim2.new(0, 3, 0, 0)
CoordsLabel.BackgroundTransparency = 1
CoordsLabel.Text = "X:--- Y:--- Z:---"
CoordsLabel.TextColor3 = Color3.new(1, 1, 1)
CoordsLabel.TextSize = 14
CoordsLabel.Font = Enum.Font.GothamBold
CoordsLabel.TextXAlignment = Enum.TextXAlignment.Center
CoordsLabel.Parent = MainFrame
 
-- Подпись
local CreditLabel = Instance.new("TextLabel")
CreditLabel.Size = UDim2.new(0, 100, 0, 20)
CreditLabel.Position = UDim2.new(0, 5, 0, 34)
CreditLabel.BackgroundTransparency = 1
CreditLabel.Text = "By Probothotspot"
CreditLabel.TextColor3 = Color3.new(1, 1, 1)
CreditLabel.TextSize = 11
CreditLabel.Font = Enum.Font.Gotham
CreditLabel.TextXAlignment = Enum.TextXAlignment.Left
CreditLabel.Parent = MainFrame
 
-- Кнопка копирования (📋)
local CopyButton = Instance.new("TextButton")
CopyButton.Size = UDim2.new(0, 22, 0, 22)
CopyButton.Position = UDim2.new(0, 122, 0, 33)
CopyButton.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
CopyButton.Text = "📋"
CopyButton.TextColor3 = Color3.new(1, 1, 1)
CopyButton.TextSize = 12
CopyButton.Font = Enum.Font.GothamBold
CopyButton.BorderSizePixel = 0
local btnCorner1 = Instance.new("UICorner")
btnCorner1.CornerRadius = UDim.new(0, 4)
btnCorner1.Parent = CopyButton
CopyButton.Parent = MainFrame
 
-- Кнопка закрытия (❌)
local CloseButton = Instance.new("TextButton")
CloseButton.Size = UDim2.new(0, 22, 0, 22)
CloseButton.Position = UDim2.new(0, 148, 0, 33)
CloseButton.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
CloseButton.Text = "❌"
CloseButton.TextColor3 = Color3.new(1, 1, 1)
CloseButton.TextSize = 12
CloseButton.Font = Enum.Font.GothamBold
CloseButton.BorderSizePixel = 0
local btnCorner2 = Instance.new("UICorner")
btnCorner2.CornerRadius = UDim.new(0, 4)
btnCorner2.Parent = CloseButton
CloseButton.Parent = MainFrame
 
-- === ПЕРЕТАСКИВАНИЕ ===
local dragging = false
local dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
MainFrame.InputEnded:Connect(function() dragging = false end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
 
-- === УДАЛЕНИЕ ===
local marker = nil
local function destroyAll()
    if marker then marker:Destroy(); marker = nil end
    if ScreenGui then ScreenGui:Destroy() end
end
 
CloseButton.MouseButton1Click:Connect(function()
    destroyAll()
    print("Окно координат закрыто через ❌")
end)
 
-- === КОПИРОВАНИЕ ===
CopyButton.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local coords = string.format("%.0f %.0f %.0f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
        local success = false
        pcall(function()
            if setclipboard then setclipboard(coords); success = true
            elseif toclipboard then toclipboard(coords); success = true
            end
        end)
        if success then
            CopyButton.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
            task.wait(0.2)
            CopyButton.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        else
            LocalPlayer:Chat("❌ Не удалось скопировать координаты")
        end
    end
end)
 
-- === МАРКЕР ПО КЛИКУ ===
local function createMarker(position)
    if marker then marker:Destroy() end
    marker = Instance.new("Part")
    marker.Size = Vector3.new(1.5, 0.2, 1.5)
    marker.Shape = Enum.PartType.Cylinder
    marker.Material = Enum.Material.Neon
    marker.Color = Color3.fromRGB(0, 255, 255)
    marker.Transparency = 0.3
    marker.Anchored = true
    marker.CanCollide = false
    marker.Position = position + Vector3.new(0, 0.1, 0)
    marker.Parent = workspace
    task.delay(8, function()
        if marker and marker.Parent then
            marker:Destroy()
            marker = nil
        end
    end)
end
 
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local cam = workspace.CurrentCamera
        if not cam then return end
        local mousePos = UserInputService:GetMouseLocation()
        local ray = cam:ScreenPointToRay(mousePos.X, mousePos.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = {LocalPlayer.Character}
        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
        if result then
            local hitPos = result.Position
            local coordsStr = string.format("📍 %.0f %.0f %.0f", hitPos.X, hitPos.Y, hitPos.Z)
            LocalPlayer:Chat(coordsStr)
            createMarker(hitPos)
        end
    end
end)
 
-- === ОБНОВЛЕНИЕ КООРДИНАТ ===
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local pos = hrp.Position
        CoordsLabel.Text = string.format("X:%.0f Y:%.0f Z:%.0f", pos.X, pos.Y, pos.Z)
    else
        CoordsLabel.Text = "X:--- Y:--- Z:---"
    end
end)
 
-- УДАЛЕНИЕ ПО P
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.P then
        destroyAll()
        print("Окно координат удалено клавишей P")
    end
end)
 
LocalPlayer:Chat("✅ Координаты v1.0 загружены. 📋 – копировать, ❌ – закрыть, клик – маркер, P – удалить.")
