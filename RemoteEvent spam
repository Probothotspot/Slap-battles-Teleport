-- ═══ INSTANT SPAM ═══
local function instantSpam()
    if isFiring then return end
    local currentRemote = remoteObjects[selectedRemoteIndex]
    local rd = REMOTES[selectedRemoteIndex]
    if not currentRemote then
        status.Text = "❌ " .. rd.displayName .. " не найден!"
        status.TextColor3 = Color3.fromRGB(239, 68, 68)
        return
    end
    isFiring = true
    local cnt = FIRE_COUNT

    if settings.hideOnFire then
        TweenService:Create(mainFrame, TweenInfo.new(0.2), {BackgroundTransparency = 0.8}):Play()
    end

    useBtn.Text = "🔥 FIRING..."
    useBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
    useBtnStroke.Color = Color3.fromRGB(251, 146, 60)
    status.Text = "🔥 " .. rd.displayName .. " x" .. cnt
    status.TextColor3 = Color3.fromRGB(239, 68, 68)

    if settings.consoleLogs then
        print("═══════════════════════════════════════")
        print("  ⚡ " .. rd.displayName .. " (" .. rd.name .. ")")
        print("  🎮 " .. player.Name .. " | x" .. cnt)
        print("═══════════════════════════════════════")
    end

    local fired = 0
    for i = 1, cnt do
        coroutine.wrap(function()
            pcall(function() currentRemote:FireServer() end)
            fired = fired + 1
        end)()
    end

    task.defer(function()
        task.wait(0.1)
        counter.Text = fired .. " / " .. cnt
        TweenService:Create(progFill, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 1, 0)}):Play()
        status.Text = "✅ " .. rd.displayName .. ": " .. fired
        status.TextColor3 = Color3.fromRGB(52, 211, 153)
        useBtn.Text = "✅ DONE"
        useBtn.BackgroundColor3 = Color3.fromRGB(16, 185, 129)
        useBtnStroke.Color = Color3.fromRGB(52, 211, 153)
        if settings.consoleLogs then print("  ✅ Отправлено: " .. fired) end

        if settings.hideOnFire then
            TweenService:Create(mainFrame, TweenInfo.new(0.3), {BackgroundTransparency = 0.05}):Play()
        end

        task.wait(settings.cooldown)
        useBtn.Text = "⚡ USE"
        useBtn.BackgroundColor3 = Color3.fromRGB(124, 58, 237)
        useBtnStroke.Color = Color3.fromRGB(192, 132, 252)
        status.Text = "⏳ Готов"
        status.TextColor3 = Color3.fromRGB(167, 139, 250)
        counter.Text = "0 / " .. FIRE_COUNT
        TweenService:Create(progFill, TweenInfo.new(0.3), {Size = UDim2.new(0, 0, 1, 0)}):Play()
        isFiring = false
        if settings.autoRepeat then task.wait(0.5); instantSpam() end
    end)
end

