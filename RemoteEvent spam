local function createToggle(label, yPos, defaultOn, settingKey)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -20, 0, 30)
    f.Position = UDim2.new(0, 10, 0, yPos)
    f.BackgroundTransparency = 1
    f.Parent = pageSettings
    
    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(0.7, 0, 1, 0)
    l.BackgroundTransparency = 1
    l.Text = label
    l.TextColor3 = Color3.fromRGB(190, 170, 230)
    l.TextSize = 10
    l.Font = Enum.Font.GothamMedium
    l.TextXAlignment = Enum.TextXAlignment.Left
    
    local bg = Instance.new("TextButton", f)
    bg.Size = UDim2.new(0, 36, 0, 18)
    bg.Position = UDim2.new(1, -36, 0.5, -9)
    bg.BackgroundColor3 = defaultOn and Color3.fromRGB(124, 58, 237) or Color3.fromRGB(40, 30, 60)
    bg.Text = ""
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)
    
    local dot = Instance.new("Frame", bg)
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = defaultOn and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
    
    bg.MouseButton1Click:Connect(function()
        settings[settingKey] = not settings[settingKey]
        local on = settings[settingKey]
        TweenService:Create(bg, TweenInfo.new(0.2), {BackgroundColor3 = on and Color3.fromRGB(124, 58, 237) or Color3.fromRGB(40, 30, 60)}):Play()
        TweenService:Create(dot, TweenInfo.new(0.2), {Position = on and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}):Play()
    end)
end

