        n = math.clamp(math.floor(n), MIN_COUNT, MAX_COUNT)
        FIRE_COUNT = n
        local r = (n - MIN_COUNT) / (MAX_COUNT - MIN_COUNT)
        sFill.Size = UDim2.new(r, 0, 1, 0)
        sThumb.Position = UDim2.new(r, -9, 0.5, -9)
        counter.Text = "0 / " .. FIRE_COUNT
    end
    amtInput.Text = tostring(FIRE_COUNT)
end)

