local function updateSlider(ratio)
    ratio = math.clamp(ratio, 0, 1)
    FIRE_COUNT = math.clamp(math.floor(MIN_COUNT + ratio * (MAX_COUNT - MIN_COUNT)), MIN_COUNT, MAX_COUNT)
    sFill.Size = UDim2.new(ratio, 0, 1, 0)
    sThumb.Position = UDim2.new(ratio, -9, 0.5, -9)
    amtInput.Text = tostring(FIRE_COUNT)
    counter.Text = "0 / " .. FIRE_COUNT
end

